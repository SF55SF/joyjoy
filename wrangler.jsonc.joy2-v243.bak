{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "joyjoy",
  "main": "./worker/index.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/admin",
      "/admin/*",
      "/api/*"
    ]
  }
}
