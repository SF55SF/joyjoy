{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "joyjoy",
  "main": "./worker/index.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/admin",
      "/admin/*",
      "/api/*",
      "/projects",
      "/projects/*",
      "/uz/projects",
      "/uz/projects/*",
      "/en/projects",
      "/en/projects/*"
    ]
  },
  "ratelimits": [
    {
      "name": "ADMIN_LOGIN_LIMITER",
      "namespace_id": "243001",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ]
}
