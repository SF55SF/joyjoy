---
// JOYJOY_MARKETPLACE_PROPERTY_ROUTE_V1
// JOY2_V244_STAGE2
import { propertySeo } from '../../../lib/joy2-seo.js';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import JoyDetail from '../../../components/JoyDetail.astro';
import { listings } from '../../../data/listings';
import { localizeListing } from '../../../data/listing-translations';
export function getStaticPaths() {
  return listings.map((listing)=>({params:{slug:listing.slug},props:{listing}}));
}
const listing = localizeListing(Astro.props.listing, 'en');
const seo=propertySeo(listing,'en');
---
<BaseLayout lang="en" title={listing.title+' — JoyJoy'} description={listing.description} image={seo.image} seoJsonLd={seo.structuredData}><JoyDetail listing={listing} lang="en" /></BaseLayout>
