---
// JOYJOY_REBRAND_V2
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout lang="en">
  <div class="joy-wrap">
    <header class="joy-nav"><a href="/en/" class="joy-logo">JoyJoy</a><nav class="joy-languages" aria-label="Languages"><a href="/" >RU</a><a href="/uz/" >UZ</a><a href="/en/" aria-current="page">EN</a></nav></header>
    <main><section class="joy-hero"><div class="joy-kicker">A new project</div><h1>JoyJoy</h1><p>A space for new ideas.</p></section><section class="joy-info joy-rule" id="about"><h2>About</h2><p>JoyJoy is a new project. Details about its offerings, team and contacts will be added once confirmed.</p></section></main>
    <footer class="joy-footer"><span>JoyJoy</span><span>© {new Date().getFullYear()}</span></footer>
  </div>
</BaseLayout>
