---
// JOY2_INVESTMENT_DIRECTORY_V19: read-only view of property/unit investments.
// It never calculates alternative financial figures or saves anything.
import {listings as allListings} from '../data/listings';
import {localizeListing} from '../data/listing-translations';
import {calculateInvestment} from '../../public/js/joyjoy-investment-model.js';
const lang = (Astro.props.lang ?? 'ru') as 'ru'|'uz'|'en';
const locale=lang==='ru'?'ru-RU':lang==='uz'?'uz-UZ':'en-US';
const copy={
 ru:{heading:'Инвестиционные объекты',intro:'Объекты и помещения с опубликованными инвестиционными расчётами',search:'Название, адрес или помещение',kind:'Тип объекта',all:'Все типы',office:'Офисы',retail:'Ритейл',warehouse:'Склады',land:'Земля',status:'Арендный статус',any:'Все статусы',leased:'С арендаторами',preliminary:'Предварительные условия аренды',areaFrom:'Площадь от, м²',areaTo:'Площадь до, м²',clear:'Сбросить',empty:'Инвестиционные расчёты пока не опубликованы',notFound:'По выбранным фильтрам ничего не найдено',area:'Площадь',purchase:'Цена покупки',sale:'Цена продажи',profit:'Чистая прибыль',details:'Показать расчёт',year:'Год',exit:'Продажа',cash:'Денежные потоки',terms:'Параметры расчёта',rent:'Аренда за м²/мес.',mezz:'Мезонин',mezzRent:'Аренда мезонина',growth:'Индексация',capex:'CAPEX',occupancy:'Заполняемость',expenses:'Годовые расходы',hold:'Срок владения',years:'лет',disclaimer:'Расчёт выполнен на основе допущений. Фактические результаты могут отличаться. Не является финансовой или инвестиционной рекомендацией.',tax:'Налог на прибыль — 15%; налог на имущество — 1,5%.'},
 en:{heading:'Investment properties',intro:'Properties and units with published investment calculations',search:'Property, address or unit',kind:'Property type',all:'All types',office:'Office',retail:'Retail',warehouse:'Warehouse',land:'Land',status:'Tenancy status',any:'All statuses',leased:'Tenanted',preliminary:'Preliminary lease terms',areaFrom:'Area from, m²',areaTo:'Area to, m²',clear:'Reset',empty:'No published investment calculations yet',notFound:'No investments match these filters',area:'Area',purchase:'Purchase price',sale:'Sale price',profit:'Net profit',details:'View calculation',year:'Year',exit:'Sale',cash:'Cash flows',terms:'Model assumptions',rent:'Rent per m²/month',mezz:'Mezzanine',mezzRent:'Mezzanine rent',growth:'Rent growth',capex:'CAPEX',occupancy:'Occupancy',expenses:'Annual expenses',hold:'Holding period',years:'years',disclaimer:'This calculation is based on assumptions. Actual results may differ. Not financial or investment advice.',tax:'Profit tax — 15%; property tax — 1.5%.'},
 uz:{heading:'Investitsiya obyektlari',intro:'E’lon qilingan investitsiya hisobi mavjud obyektlar va xonalar',search:'Obyekt, manzil yoki xona',kind:'Mulk turi',all:'Barcha turlar',office:'Ofislar',retail:'Savdo',warehouse:'Omborlar',land:'Yer',status:'Ijara holati',any:'Barcha holatlar',leased:'Ijarachilar bilan',preliminary:'Dastlabki ijara shartlari',areaFrom:'Maydon, m² dan',areaTo:'Maydon, m² gacha',clear:'Tozalash',empty:'Hozircha e’lon qilingan investitsiya hisoblari yo‘q',notFound:'Filtrlar bo‘yicha natija topilmadi',area:'Maydon',purchase:'Xarid narxi',sale:'Sotish narxi',profit:'Sof foyda',details:'Hisobni ko‘rish',year:'Yil',exit:'Sotish',cash:'Pul oqimi',terms:'Hisob shartlari',rent:'m²/oy ijara',mezz:'Mezanin',mezzRent:'Mezanin ijarasi',growth:'Ijara o‘sishi',capex:'CAPEX',occupancy:'Bandlik',expenses:'Yillik xarajatlar',hold:'Egalik muddati',years:'yil',disclaimer:'Hisob taxminlarga asoslangan. Haqiqiy natijalar farq qilishi mumkin. Moliyaviy yoki investitsiyaviy maslahat emas.',tax:'Foyda solig‘i — 15%; mulk solig‘i — 1,5%.'}
}[lang];
const rows=[];
for(const original of allListings){
 const p=localizeListing(original,lang);
 const units=Array.isArray(original.units)?original.units:[];
 for(const [i,u] of units.entries()){
  const model=u?.investment;
  if(!model||model.published!==true||u.published===false)continue;
  const result=calculateInvestment({...model,propertyTaxArea:Number(u.area)>0?Number(u.area):model.lettableArea,taxCity:original.city});
  if(!result.ok)continue;
  const name=[u.block?`${lang==='en'?'Block':lang==='uz'?'Blok':'Блок'} ${u.block}`:'',u.number||u.id||''].filter(Boolean).join(' · ')||`${lang==='en'?'Unit':lang==='uz'?'Xona':'Помещение'} ${i+1}`;
  rows.push({id:`${original.slug}-unit-${i}`,property:p,raw:original,unit:u,name,model,result,area:Number(u.area)||Number(model.lettableArea)||0,status:u.tenancyStatus||original.tenancyStatus||'',price:Number(model.purchasePrice)||Number(u.area)*Number(u.pricePerSqm)||0});
 }
 if(original.investment?.published===true&&original.showProjects===true){
  const model=original.investment;
  const result=calculateInvestment({...model,propertyTaxArea:Number(original.area)||model.lettableArea,taxCity:original.city});
  if(result.ok)rows.push({id:`${original.slug}-property`,property:p,raw:original,unit:null,name:'',model,result,area:Number(model.lettableArea)||Number(original.area)||0,status:original.tenancyStatus||'',price:Number(model.purchasePrice)||0});
 }
}
const num=n=>Number(n).toLocaleString(locale,{maximumFractionDigits:2});
const money=n=>Number.isFinite(Number(n))?Math.round(Number(n)).toLocaleString(locale,{style:'currency',currency:'USD',maximumFractionDigits:0}):'—';
const pct=n=>Number.isFinite(n)?num(n)+'%':'—';
const thousands=n=>!Number.isFinite(n)?'—':`${n<0?'(' : ''}${Math.round(Math.abs(n)/1000).toLocaleString(locale)}${n<0?')':''}`;
function assumptions(model){
 const a=[];const add=(key,n,label)=>{if(Number.isFinite(Number(n))&&Number(n)>0)a.push({label:key,value:label});};
 add(copy.area,model.lettableArea,num(model.lettableArea)+' м²');
 add(copy.mezz,model.mezzanineArea,num(model.mezzanineArea)+' м²');
 add(copy.rent,model.monthlyRent,Math.round(Number(model.monthlyRent)).toLocaleString('ru-RU')+' '+(model.rentCurrency||'USD'));
 add(copy.mezzRent,model.mezzanineRent,Math.round(Number(model.mezzanineRent)).toLocaleString('ru-RU')+' USD');
 add(copy.growth,model.annualRentGrowth,pct(model.annualRentGrowth));
 add(copy.capex,model.capex,money(model.capex));
 add(copy.occupancy,model.occupancy,pct(model.occupancy));
 add(copy.expenses,model.annualExpenses,money(model.annualExpenses));
 add(copy.hold,model.holdYears,num(model.holdYears)+' '+copy.years);
 return a;
}
---
<section class="jj-invest-directory jj-shell" id="investments" data-jj-invest-directory>
 <div class="jj-invest-directory-intro"><h2>{copy.heading}</h2><p>{copy.intro}</p></div>
 <form class="jj-inv-filters" data-jj-inv-filters role="search" aria-label={copy.heading}>
  <label><span>{copy.search}</span><input type="search" name="query" placeholder={copy.search} autocomplete="off"/></label>
  <label><span>{copy.kind}</span><select name="kind"><option value="">{copy.all}</option>{['office','retail','warehouse','land'].map(kind=><option value={kind}>{copy[kind]}</option>)}</select></label>
  <label><span>{copy.status}</span><select name="status"><option value="">{copy.any}</option><option value="leased">{copy.leased}</option><option value="preliminary">{copy.preliminary}</option></select></label>
  <label><span>{copy.areaFrom}</span><input name="from" type="number" min="0" placeholder="0"/></label>
  <label><span>{copy.areaTo}</span><input name="to" type="number" min="0" placeholder="—"/></label>
  <button type="reset">{copy.clear}</button>
 </form>
 <div class="jj-inv-rows" role="list">
 {rows.map((entry,i)=>{const {property,unit,model,result}=entry;const title=property.title+(unit?' · '+entry.name:'');const profit=Number.isFinite(result.netProfit)?result.netProfit:result.cashFlows?.reduce((a,v)=>a+v,0);return <div class="jj-inv-entry" role="listitem" data-jj-inv-row data-text={(title+' '+property.city+' '+property.address+' '+property.district).toLocaleLowerCase()} data-kind={property.type} data-status={entry.status} data-area={entry.area}>
  <button type="button" class="jj-inv-row-button" data-jj-inv-toggle aria-expanded="false" aria-controls={'jj-inv-panel-'+i}>
   <span class="jj-inv-thumb">{property.images?.[0]?<img src={property.images[0]} alt="" loading="lazy"/>:<span>joy²</span>}</span>
   <span class="jj-inv-name"><strong>{property.title}</strong>{unit&&<small>{entry.name}</small>}<small>{property.address}</small></span>
   <span class="jj-inv-area"><small>{copy.area}</small><strong>{num(entry.area)} м²</strong></span>
   <span class="jj-inv-price"><small>{copy.purchase}</small><strong>{money(entry.price)}</strong></span>
   <span class="jj-inv-irr"><small>IRR</small><strong>{pct(result.irrPercent)}</strong></span>
   <span class="jj-inv-chevron" aria-hidden="true">⌄</span>
  </button>
  <div class="jj-inv-panel" id={'jj-inv-panel-'+i} hidden data-jj-inv-panel>
   <div class="jj-inv-kpis">
    <div><small>IRR</small><strong>{pct(result.irrPercent)}</strong></div>
    <div><small>{copy.purchase}</small><strong>{money(model.purchasePrice)}</strong></div>
    <div><small>{copy.sale}</small><strong>{money(result.salePrice)}</strong></div>
    <div><small>{copy.profit}</small><strong class:list={{'is-negative':profit<0,'is-positive':profit>=0}}>{money(profit)}</strong></div>
   </div>
   <h3>{copy.terms}</h3><dl class="jj-inv-assumptions">{assumptions(model).map(x=><div><dt>{x.label}</dt><dd>{x.value}</dd></div>)}</dl>
   <h3>{copy.cash}</h3><div class="jj-inv-cash-strip">{/* JOY2_INVEST_YEAR0_V27 */}{[{year:0,cashFlow:result.cashFlows?.[0]??-result.totalInvestment},...(result.schedule||[])].map(y=><div class:list={['jj-inv-year',{'is-negative':y.cashFlow<0,'is-positive':y.cashFlow>=0}]}><small>{copy.year} {y.year}</small><strong>{thousands(y.cashFlow)}</strong><span>{lang==='ru'?'тыс. $':lang==='uz'?'ming $':'k $'}</span></div>)}</div>
   {result.propertyTaxRate===1.5&&result.rentalProfitTaxRate===15&&<p class="jj-inv-tax">{copy.tax}</p>}<p class="jj-inv-disclaimer">{copy.disclaimer}</p>
  </div>
 </div>})}
 </div>
 {rows.length===0&&<p class="jj-inv-empty">{copy.empty}</p>}
 {rows.length>0&&<p class="jj-inv-empty" data-jj-inv-no-matches hidden>{copy.notFound}</p>}
</section>
<style>
.jj-invest-directory{padding-block:28px 72px}.jj-invest-directory-intro h2{font-size:clamp(24px,2.3vw,33px);margin:0 0 6px}.jj-invest-directory-intro p{margin:0 0 24px;color:#68716d;font-size:14px}.jj-inv-filters{display:grid;grid-template-columns:minmax(180px,2fr) repeat(2,minmax(135px,1fr)) repeat(2,minmax(96px,.65fr)) auto;gap:10px;align-items:end;padding:16px;border:1px solid #e6e9e7;background:#fff;border-radius:12px;margin-bottom:22px}.jj-inv-filters label{display:grid;gap:6px;min-width:0}.jj-inv-filters label span{color:#66716c;font-size:11px}.jj-inv-filters input,.jj-inv-filters select{width:100%;min-width:0;height:40px;border:1px solid #d3d8d5;padding:0 9px;border-radius:6px;background:white;color:#161c18}.jj-inv-filters button{height:40px;border:1px solid #d3d8d5;background:white;border-radius:6px;padding:0 12px;cursor:pointer}.jj-inv-rows{display:grid;gap:9px}.jj-inv-entry{border:1px solid #e5e8e6;border-radius:10px;background:white;overflow:hidden}.jj-inv-row-button{appearance:none;width:100%;border:0;background:transparent;display:grid;grid-template-columns:76px minmax(160px,2fr) minmax(85px,.9fr) minmax(116px,1.2fr) minmax(72px,.65fr) 22px;gap:14px;align-items:center;text-align:left;padding:10px 15px;cursor:pointer;color:#15221b}.jj-inv-row-button:hover,.jj-inv-row-button[aria-expanded=true]{background:#f8f9f8}.jj-inv-thumb{width:76px;height:60px;background:#edf0ef;border-radius:5px;overflow:hidden;display:grid;place-items:center}.jj-inv-thumb img{width:100%;height:100%;object-fit:cover}.jj-inv-thumb>span{font-weight:800;font-size:15px;color:#9da7a1}.jj-inv-name{display:grid;gap:2px;min-width:0}.jj-inv-name strong{font-size:15px;line-height:1.3}.jj-inv-name small{font-size:12px;color:#69746d;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.jj-inv-area,.jj-inv-price,.jj-inv-irr{display:grid;gap:6px;min-width:0}.jj-inv-area small,.jj-inv-price small,.jj-inv-irr small{font-size:11px;color:#707c75}.jj-inv-area strong,.jj-inv-price strong,.jj-inv-irr strong{font-size:14px;font-variant-numeric:tabular-nums;overflow-wrap:anywhere}.jj-inv-chevron{font-size:22px;color:#75847c;transition:transform .2s}.jj-inv-row-button[aria-expanded=true] .jj-inv-chevron{transform:rotate(180deg)}.jj-inv-panel{padding:16px 20px 22px;border-top:1px solid #ebefed;background:#fcfdfc}.jj-inv-kpis{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px}.jj-inv-kpis>div{display:grid;gap:5px;padding:12px;background:white;border:1px solid #e9eeeb;border-radius:8px}.jj-inv-kpis small{font-size:11px;color:#6e7972}.jj-inv-kpis strong{font-size:clamp(15px,1.6vw,21px);font-variant-numeric:tabular-nums}.jj-inv-panel h3{font-size:15px;margin:23px 0 11px}.jj-inv-assumptions{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:9px;margin:0}.jj-inv-assumptions>div{display:grid;gap:5px;border-bottom:1px solid #e7ebe8;padding:8px 0;min-width:0}.jj-inv-assumptions dt{color:#6f7973;font-size:11px}.jj-inv-assumptions dd{margin:0;font-size:13px}.jj-inv-cash-strip{display:grid;grid-template-columns:repeat(9,minmax(0,1fr));gap:6px}.jj-inv-year{min-width:0;display:grid;gap:5px;background:white;border:1px solid #e4eae6;border-radius:6px;padding:9px 6px;text-align:center;font-variant-numeric:tabular-nums}.jj-inv-year small{color:#76827b;font-size:10px}.jj-inv-year strong{font-size:clamp(12px,1vw,16px);white-space:nowrap}.jj-inv-year span{font-size:10px;color:#7e8981}.jj-inv-panel .is-negative{color:#c92236}.jj-inv-panel .is-positive{color:#128452}.jj-inv-tax{margin:18px 0 5px;font-size:12px}.jj-inv-disclaimer{font-size:11px;color:#7d867f;margin:0}.jj-inv-empty{text-align:center;color:#68736b;padding:35px 10px}@media(max-width:1120px){.jj-inv-filters{grid-template-columns:repeat(3,minmax(0,1fr))}.jj-inv-row-button{grid-template-columns:64px minmax(135px,2fr) minmax(85px,1fr) minmax(95px,1.1fr) 22px;gap:10px}.jj-inv-thumb{width:64px;height:53px}.jj-inv-irr{display:none}}@media(max-width:730px){.jj-inv-filters{grid-template-columns:repeat(2,minmax(0,1fr));padding:12px}.jj-inv-filters label:first-child{grid-column:1/-1}.jj-inv-row-button{grid-template-columns:58px minmax(0,1fr) auto;gap:9px;padding:9px}.jj-inv-thumb{width:58px;height:51px}.jj-inv-area,.jj-inv-price,.jj-inv-irr{display:none}.jj-inv-kpis{grid-template-columns:repeat(2,minmax(0,1fr))}.jj-inv-assumptions{grid-template-columns:repeat(2,minmax(0,1fr))}.jj-inv-cash-strip{grid-template-columns:repeat(4,minmax(0,1fr))}.jj-inv-panel{padding:12px}}@media(max-width:360px){.jj-inv-cash-strip{grid-template-columns:repeat(2,minmax(0,1fr))}}
</style>
<script is:inline>
(function(){
 for(const root of document.querySelectorAll('[data-jj-invest-directory]')){
  if(root.dataset.bound==='1')continue;root.dataset.bound='1';
  const form=root.querySelector('[data-jj-inv-filters]');const rows=Array.from(root.querySelectorAll('[data-jj-inv-row]'));
  const apply=()=>{const f=new FormData(form);const q=String(f.get('query')||'').trim().toLocaleLowerCase();const kind=String(f.get('kind')||'');const status=String(f.get('status')||'');const min=Number(f.get('from')||0);const max=String(f.get('to')||'')?Number(f.get('to')):Infinity;let visible=0;for(const row of rows){const area=Number(row.dataset.area||0);const ok=(!q||row.dataset.text.includes(q))&&(!kind||row.dataset.kind===kind)&&(!status||row.dataset.status===status)&&area>=min&&area<=max;row.hidden=!ok;if(ok)visible++;}const empty=root.querySelector('[data-jj-inv-no-matches]');if(empty)empty.hidden=visible>0;};
  form?.addEventListener('input',apply);form?.addEventListener('change',apply);form?.addEventListener('submit',e=>{e.preventDefault();apply()});form?.addEventListener('reset',()=>{for(const row of rows)row.hidden=false;const empty=root.querySelector('[data-jj-inv-no-matches]');if(empty)empty.hidden=true});
  for(const button of root.querySelectorAll('[data-jj-inv-toggle]'))button.addEventListener('click',()=>{const expanded=button.getAttribute('aria-expanded')==='true';for(const b of root.querySelectorAll('[data-jj-inv-toggle]')){b.setAttribute('aria-expanded','false');const panel=document.getElementById(b.getAttribute('aria-controls'));if(panel)panel.hidden=true;}if(!expanded){button.setAttribute('aria-expanded','true');const panel=document.getElementById(button.getAttribute('aria-controls'));if(panel)panel.hidden=false;}});
 }
})();
</script>

<!-- JOY2_INV_SORT_V40: change search control to sorting on investment pages only -->
<script is:inline>
(function(){
  const translations={
    ru:{sort:'Сортировка',asc:'Цена покупки: по возрастанию',desc:'Цена покупки: по убыванию',irr:'Наибольший IRR'},
    en:{sort:'Sort by',asc:'Purchase price: low to high',desc:'Purchase price: high to low',irr:'Highest IRR'},
    uz:{sort:'Saralash',asc:'Xarid narxi: o‘sish',desc:'Xarid narxi: kamayish',irr:'Eng yuqori IRR'}
  };
  const lang=(document.documentElement.lang||'ru').slice(0,2);
  const c=translations[lang]||translations.ru;
  for(const root of document.querySelectorAll('[data-jj-invest-directory]')){
    if(root.dataset.sortV40==='1')continue;
    const form=root.querySelector('[data-jj-inv-filters]');
    const list=root.querySelector('.jj-inv-rows');
    if(!form||!list)continue;
    root.dataset.sortV40='1';
    const existingSearch=form.querySelector('input[name="query"]');
    let label=existingSearch?.closest('label');
    if(!label){label=document.createElement('label');form.prepend(label);}
    label.replaceChildren();
    const title=document.createElement('span');title.textContent=c.sort;
    const select=document.createElement('select');select.name='sort';select.setAttribute('aria-label',c.sort);select.dataset.jjInvSort='1';
    for(const [value,text] of [['price_asc',c.asc],['price_desc',c.desc],['irr_desc',c.irr]]){
      const option=document.createElement('option');option.value=value;option.textContent=text;select.append(option);
    }
    label.append(title,select);
    function numberFrom(el,kind){
      const s=(el?.textContent||'').trim().replace(/\s/g,'');
      if(!s||s==='—')return null;
      if(kind==='irr'){
        const n=Number(s.replace(/[^\d,.-]/g,'').replace(',','.'));
        return Number.isFinite(n)?n:null;
      }
      const n=Number(s.replace(/[^\d-]/g,''));
      return Number.isFinite(n)?n:null;
    }
    const rows=Array.from(list.querySelectorAll('[data-jj-inv-row]'));
    const originalOrder=new Map(rows.map((row,index)=>[row,index]));
    const sort=()=>{
      const mode=select.value;
      const key=mode==='irr_desc'?'irr':'price';
      const val=row=>numberFrom(row.querySelector(key==='irr'?'.jj-inv-irr strong':'.jj-inv-price strong'),key);
      rows.sort((a,b)=>{
        const na=val(a),nb=val(b);
        if(na===null&&nb===null)return originalOrder.get(a)-originalOrder.get(b);
        if(na===null)return 1;if(nb===null)return -1;
        const diff=mode==='price_asc'?na-nb:nb-na;
        return diff||originalOrder.get(a)-originalOrder.get(b);
      });
      for(const row of rows)list.append(row);
    };
    select.addEventListener('change',sort);
    form.addEventListener('reset',()=>{select.value='price_asc';sort();});
    sort();
  }
})();
</script>
