---
// JOYJOY_LOOPNET_DETAIL_V5
import type { Listing } from '../data/listings';
import JoyInvestment from './JoyInvestment.astro';
import JoyUnits from './JoyUnits.astro';
import { localizeListing } from '../data/listing-translations';
// JOY2_SINGLE_VIRTUAL_UNIT_V27: virtual row for a property with no explicit units; never mutate the stored listing.
const {listing:rawListing,lang='ru'}=Astro.props as {listing:Listing;lang:'ru'|'uz'|'en'};
const originalListing = rawListing.units?.length ? rawListing : {...rawListing,units:[{
 id:'whole-property',number:'1',block:rawListing.slug==='the-business-park-block-3'?'3':'—',title:rawListing.title,area:rawListing.area,
 pricePerSqm:rawListing.priceUsd!=null&&rawListing.area>0?rawListing.priceUsd/rawListing.area:null,
 priceUsd:rawListing.priceUsd,investment:rawListing.investment??null,
 tenancyStatus:rawListing.tenancyStatus??null,published:rawListing.published!==false,
 floor:rawListing.slug==='the-business-park-block-3'?'2, 4, 5':'—',features:rawListing.features??[],category:rawListing.type
}]};
const listing=localizeListing(originalListing,lang);
const numberLocale=lang==='en'?'en-US':lang==='uz'?'uz-UZ':'ru-RU';
const base=lang==='ru'?'/':`/${lang}/`;
const c={ru:{back:'Все объекты',forSale:'Коммерческая недвижимость · продажа',description:'Описание объекта',features:'Характеристики',area:'Площадь',price:'Цена',unit:'Цена за м²',request:'Цена по запросу',source:'Информация об объекте',gallery:'Галерея',location:'Расположение',mapNote:'Точное местоположение уточняется',contact:'Запросить информацию',contactNote:'Условия приобретения уточняются по запросу.',open:'Подробнее об объекте',more:'Другие объекты',status:'Стадия строительства',existing:'Существующий',under_construction:'Строящийся'},uz:{back:'Barcha obyektlar',forSale:'Tijorat ko‘chmas mulki · sotuv',description:'Tavsif',features:'Xususiyatlar',area:'Maydon',price:'Narx',unit:'m² narxi',request:'So‘rov asosida',source:'Obyekt haqida ma’lumot',gallery:'Galereya',location:'Joylashuv',mapNote:'Aniq manzil tasdiqlanmagan',contact:'Ma’lumot so‘rash',contactNote:'Xarid shartlari so‘rov asosida aniqlanadi.',open:'Obyekt haqida batafsil',more:'Boshqa obyektlar',status:'Qurilish holati',existing:'Mavjud',under_construction:'Qurilmoqda'},en:{back:'All listings',forSale:'Commercial real estate · for sale',description:'Property description',features:'Features',area:'Area',price:'Price',unit:'Price per m²',request:'Price on request',source:'Property information',gallery:'Gallery',location:'Location',mapNote:'Exact location is not confirmed',contact:'Request information',contactNote:'Purchase terms are available on request.',open:'Property details',more:'Other properties',status:'Construction stage',existing:'Existing',under_construction:'Under construction'}}[lang];
const price=listing.priceUsd===null?c.request:'$'+listing.priceUsd.toLocaleString('en-US');
const coords=Number.isFinite(listing.lat)&&Number.isFinite(listing.lng);
const related=(await import('../data/listings')).listings.filter(x=>x.slug!==listing.slug&&x.showCatalog!==false).slice(0,3).map(x=>localizeListing(x,lang));
// No map key required.

const mapData=coords?[{slug:listing.slug,title:listing.title,lat:listing.lat,lng:listing.lng,area:listing.area,price:listing.priceUsd,image:listing.images?.[0]||'',url:base+'listing/'+listing.slug+'/'}]:[];
---
<header class="jj-sitebar"><div class="jj-shell jj-sitebar-in"><a href={base} class="jj-wordmark" aria-label="Joy squared"><img class="jj-brand-logo" src="/joy2-logo.svg" alt="Joy²" width="116" height="48" /></a><a href={base} class="jj-detail-back">← {c.back}</a><div class="jj-sitebar-right"><div class="jj-lang" aria-label="Language"><a href={'/listing/'+listing.slug+'/'} lang="ru" aria-current={lang==='ru'?'page':undefined}>RU</a><a href={'/uz/listing/'+listing.slug+'/'} lang="uz" aria-current={lang==='uz'?'page':undefined}>UZ</a><a href={'/en/listing/'+listing.slug+'/'} lang="en" aria-current={lang==='en'?'page':undefined}>EN</a></div></div></div></header>
<main class="jj-shell jj-detail">
 <a href={base+'#catalog'} class="jj-back-link">← {c.back}</a>
 <p class="jj-crumb">JoyJoy / {c.forSale}</p>
 <div class="jj-detail-heading"><div><h1>{listing.title}</h1><p>{[listing.city,listing.district,listing.address].filter(Boolean).join(' · ')}</p></div>{listing.status&&<span class="jj-detail-status">{c[listing.status]}</span>}</div>
 <div class:list={['jj-photo-layout',{'is-single':listing.images.length<2}]}>
  <div class="jj-photo-main">{listing.images?.[0]?<button type="button" class="jj-gallery-launch" data-gallery-index="0" aria-label={c.gallery}><img src={listing.images[0]} alt={listing.title}/></button>:<div class="jj-image-placeholder">joyjoy.</div>}</div>
  <div class="jj-photo-thumbs" hidden={listing.images.length<2}>{listing.images?.slice(1,3).map((img,i)=><button type="button" data-gallery-index={i+1} aria-label={c.gallery+' '+(i+2)}><img src={img} alt={listing.title} loading="lazy"/></button>)}</div>
 </div>
 
<div class="jj-detail-columns">
  <div class="jj-detail-main">
   <section><h2>{c.description}</h2><p>{listing.description}</p></section>
   {listing.features?.length>0&&<section><h2>{c.features}</h2><ul class="jj-feature-list">{listing.features.map(x=><li>{x}</li>)}</ul></section>}
   <JoyUnits listing={originalListing} lang={lang}/>
   <section><h2>{c.location}</h2>{coords?<><div class="jj-map-wrap jj-detail-map"><div id="jj-map" data-map-provider="openfreemap"></div><div id="jj-map-state" class="jj-map-empty"><p>{c.mapNote}</p></div></div><p><a href={'https://yandex.uz/maps/?ll='+listing.lng+','+listing.lat+'&z=16&pt='+listing.lng+','+listing.lat+',pm2rdm'} target="_blank" rel="noopener noreferrer">Yandex Maps ↗</a></p></>:<p>{c.mapNote}</p>}</section>
   {related.length>0&&<section><h2>{c.more}</h2><div class="jj-related-grid">{related.map(x=><a href={base+'listing/'+x.slug+'/'}>{x.images?.[0]&&<img src={x.images[0]} alt="" loading="lazy"/>}<b>{x.title}</b><small>{x.area.toLocaleString(numberLocale)} m²</small></a>)}</div></section>}
  </div>
  <aside class="jj-detail-sidebar"><div class="jj-detail-finance"><small>{c.price}</small><strong>{listing.units?.length?'от $'+Math.min(...listing.units.filter(u=>u.published!==false).map(u=>Number(u.area)*Number(u.pricePerSqm))).toLocaleString('en-US'):price}</strong></div>
   <div class="jj-detail-metrics"><div><span>{c.area}</span><b>{listing.units?.length?(()=>{const a=listing.units.filter(u=>u.published!==false).map(u=>u.area);return Math.min(...a).toLocaleString(numberLocale)+'–'+Math.max(...a).toLocaleString(numberLocale)})():listing.area.toLocaleString(numberLocale)} m²</b></div>{listing.status&&<div><span>{c.status}</span><b>{c[listing.status]}</b></div>}{listing.priceUsd!==null&&listing.area>0&&!listing.units?.length&&<div><span>{c.unit}</span><b>{'$'+Math.round(listing.priceUsd/listing.area).toLocaleString('en-US')}</b></div>}</div>
   <div class="jj-detail-contact"><h3>{c.contact}</h3><p>{c.contactNote}</p></div>
  </aside>
 </div>
</main>
<footer class="jj-bottom"><div class="jj-shell"><strong>joyjoy.</strong><span>© {new Date().getFullYear()}</span></div></footer>
{listing.images?.length>0&&<dialog id="jj-gallery" class="jj-lightbox"><button type="button" id="jj-gallery-close" aria-label={lang==='ru'?'Закрыть':lang==='uz'?'Yopish':'Close'}>✕</button><button type="button" id="jj-gallery-prev" hidden={listing.images.length<2} aria-label={lang==='ru'?'Предыдущее фото':lang==='uz'?'Oldingi surat':'Previous photo'}>‹</button><img id="jj-gallery-image" src={listing.images[0]} alt={listing.title}/><button type="button" id="jj-gallery-next" hidden={listing.images.length<2} aria-label={lang==='ru'?'Следующее фото':lang==='uz'?'Keyingi surat':'Next photo'}>›</button><small id="jj-gallery-count"></small></dialog>}
{coords&&<><script type="application/json" id="jj-map-data" set:html={JSON.stringify(mapData).replace(/</g,'\\u003c')}></script><script type="application/json" id="jj-i18n-data" set:html={JSON.stringify({noCoords:c.mapNote,price:c.request,detail:c.open,mapMissing:c.mapNote,mapFailed:c.mapNote})}></script><script src="/js/joyjoy-maplibre.js" defer></script></>}
<script type="application/json" id="jj-gallery-data" set:html={JSON.stringify(listing.images).replace(/</g,'\\u003c')}></script>
<script src="/js/joyjoy-detail.js" defer></script>
