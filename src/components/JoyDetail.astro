---
// JOYJOY_MARKETPLACE_DETAIL_V1
import type { Listing } from '../data/listings';
const {listing,lang='ru'} = Astro.props as {listing:Listing;lang:'ru'|'uz'|'en'};
const base=lang==='ru'?'/':'/'+lang+'/';
const back={ru:'← Все объявления',uz:'← Barcha obyektlar',en:'← All listings'}[lang];
const area={ru:'Площадь',uz:'Maydon',en:'Area'}[lang];
const price={ru:'Цена',uz:'Narx',en:'Price'}[lang];
const request={ru:'По запросу',uz:'So‘rov bo‘yicha',en:'On request'}[lang];
const details={ru:'Описание',uz:'Tavsif',en:'Description'}[lang];
---
<header class="jj-header"><div class="jj-container jj-top"><a class="jj-brand" href={base}>joy<span>joy</span><b>.</b></a><a href={base}>{back}</a></div></header><main class="jj-container jj-property"><a href={base} class="jj-back">{back}</a><p class="jj-eyebrow">JOYJOY / PROPERTY</p><h1>{listing.title}</h1><p class="jj-address">{listing.city} · {listing.district}{listing.address?' · '+listing.address:''}</p><div class="jj-property-hero">{listing.images[0]?<img src={listing.images[0]} alt={listing.title}/>:<div class="jj-property-placeholder">JOYJOY</div>}</div><div class="jj-property-body"><section><h2>{details}</h2><p>{listing.description}</p>{listing.features.length>0&&<ul>{listing.features.map(x=><li>{x}</li>)}</ul>}{listing.images.length>1&&<div class="jj-extra-images">{listing.images.slice(1).map(x=><img src={x} alt={listing.title} loading="lazy"/>)}</div>}</section><aside><div><span>{area}</span><strong>{listing.area.toLocaleString('en-US')} m²</strong></div><div><span>{price}</span><strong>{listing.priceUsd===null?request:'$'+listing.priceUsd.toLocaleString('en-US')}</strong></div>{listing.priceUsd!==null&&listing.area>0&&<div><span>USD / m²</span><strong>{Math.round(listing.priceUsd/listing.area).toLocaleString('en-US')}</strong></div>}</aside></div></main><footer class="jj-footer"><div class="jj-container">JoyJoy · © {new Date().getFullYear()}</div></footer>
