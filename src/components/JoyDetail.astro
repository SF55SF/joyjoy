---
// JOYJOY_LOOPNET_DETAIL_V5
import type { Listing } from '../data/listings';
const {listing,lang='ru'}=Astro.props as {listing:Listing;lang:'ru'|'uz'|'en'};
const base=lang==='ru'?'/':`/${lang}/`;
const c={ru:{back:'Все объекты',forSale:'Коммерческая недвижимость · продажа',description:'Описание объекта',features:'Характеристики',area:'Площадь',price:'Цена',unit:'Цена за м²',request:'Цена по запросу',source:'Оригинальное объявление на CMWP',gallery:'Галерея',location:'Расположение',mapNote:'Точное местоположение уточняется',contact:'Запросить информацию',contactNote:'Контактные данные и условия покупки доступны у источника объявления.',open:'Открыть объявление на CMWP',more:'Другие объекты',status:'Статус',available:'В продаже',reserved:'Забронировано',sold:'Продано'},uz:{back:'Barcha obyektlar',forSale:'Tijorat ko‘chmas mulki · sotuv',description:'Tavsif',features:'Xususiyatlar',area:'Maydon',price:'Narx',unit:'m² narxi',request:'So‘rov asosida',source:'CMWP dagi asl e’lon',gallery:'Galereya',location:'Joylashuv',mapNote:'Aniq manzil tasdiqlanmagan',contact:'Ma’lumot so‘rash',contactNote:'Aloqa ma’lumotlari va shartlar e’lon manbasida.',open:'CMWP e’lonini ochish',more:'Boshqa obyektlar',status:'Holat',available:'Sotuvda',reserved:'Band',sold:'Sotilgan'},en:{back:'All listings',forSale:'Commercial real estate · for sale',description:'Property description',features:'Features',area:'Area',price:'Price',unit:'Price per m²',request:'Price on request',source:'Original CMWP listing',gallery:'Gallery',location:'Location',mapNote:'Exact location is not confirmed',contact:'Request information',contactNote:'Seller contact and terms are available on the source listing.',open:'View on CMWP',more:'Other properties',status:'Status',available:'For sale',reserved:'Reserved',sold:'Sold'}}[lang];
const price=listing.priceUsd===null?c.request:'$'+listing.priceUsd.toLocaleString('en-US');
const coords=Number.isFinite(listing.lat)&&Number.isFinite(listing.lng);
const related=(await import('../data/listings')).listings.filter(x=>x.slug!==listing.slug).slice(0,3);
// No map key required.

const mapData=coords?[{slug:listing.slug,title:listing.title,lat:listing.lat,lng:listing.lng,area:listing.area,price:listing.priceUsd,image:listing.images?.[0]||'',url:base+'listing/'+listing.slug+'/'}]:[];
---
<header class="jj-sitebar"><div class="jj-shell jj-sitebar-in"><a href={base} class="jj-wordmark">joy<span>joy</span><b>.</b></a><a href={base} class="jj-detail-back">← {c.back}</a></div></header>
<main class="jj-shell jj-detail"><a href={base+'#catalog'} class="jj-back-link">← {c.back}</a><p class="jj-crumb">JoyJoy / {c.forSale}</p><div class="jj-detail-heading"><div><h1>{listing.title}</h1><p>{[listing.city,listing.district,listing.address].filter(Boolean).join(' · ')}</p></div><span class="jj-detail-status">{c[listing.status]}</span></div>
  <div class="jj-photo-layout"><div class="jj-photo-main">{listing.images?.[0]?<button type="button" class="jj-gallery-launch" data-gallery-index="0" aria-label={c.gallery}><img src={listing.images[0]} alt={listing.title}/></button>:<div class="jj-image-placeholder">joyjoy.</div>}</div><div class="jj-photo-thumbs">{listing.images?.slice(1,3).map((img,i)=><button type="button" data-gallery-index={i+1} aria-label={c.gallery+' '+(i+2)}><img src={img} alt={listing.title} loading="lazy"/></button>)}</div></div>
  <div class="jj-detail-columns"><div class="jj-detail-main"><section><h2>{c.description}</h2><p>{listing.description}</p></section>{listing.features?.length>0&&<section><h2>{c.features}</h2><ul class="jj-feature-list">{listing.features.map(x=><li>{x}</li>)}</ul></section>}<section><h2>{c.location}</h2>{coords?<><div class="jj-map-wrap jj-detail-map"><div id="jj-map" data-map-provider="openfreemap"></div><div id="jj-map-state" class="jj-map-empty"><p>{c.mapNote}</p></div></div><p><a href={'https://yandex.uz/maps/?ll='+listing.lng+','+listing.lat+'&z=16&pt='+listing.lng+','+listing.lat+',pm2rdm'} target="_blank" rel="noopener noreferrer">Yandex Maps ↗</a></p></>:<p>{c.mapNote}</p>}</section>{related.length>0&&<section><h2>{c.more}</h2><div class="jj-related-grid">{related.map(x=><a href={base+'listing/'+x.slug+'/'}>{x.images?.[0]&&<img src={x.images[0]} alt="" loading="lazy"/>}<b>{x.title}</b><small>{x.area.toLocaleString('ru-RU')} м²</small></a>)}</div></section>}</div><aside class="jj-detail-sidebar"><div class="jj-detail-finance"><small>{c.price}</small><strong>{price}</strong></div><div class="jj-detail-metrics"><div><span>{c.area}</span><b>{listing.area.toLocaleString('ru-RU')} м²</b></div><div><span>{c.status}</span><b>{c[listing.status]}</b></div>{listing.priceUsd!==null&&listing.area>0&&<div><span>{c.unit}</span><b>${Math.round(listing.priceUsd/listing.area).toLocaleString('en-US')}</b></div>}</div><div class="jj-detail-contact"><h3>{c.contact}</h3><p>{c.contactNote}</p>{listing.sourceUrl?<a href={listing.sourceUrl} class="jj-source-button" target="_blank" rel="noopener noreferrer">{c.open} ↗</a>:<span>{c.request}</span>}</div></aside></div>
</main>
<footer class="jj-bottom"><div class="jj-shell"><strong>joyjoy.</strong><span>© {new Date().getFullYear()}</span></div></footer>
{listing.images?.length>0&&<dialog id="jj-gallery" class="jj-lightbox"><button type="button" id="jj-gallery-close" aria-label="Close">✕</button><button type="button" id="jj-gallery-prev" aria-label="Previous">‹</button><img id="jj-gallery-image" src={listing.images[0]} alt={listing.title}/><button type="button" id="jj-gallery-next" aria-label="Next">›</button><small id="jj-gallery-count"></small></dialog>}
{coords&&<><script type="application/json" id="jj-map-data" set:html={JSON.stringify(mapData).replace(/</g,'\\u003c')}></script><script type="application/json" id="jj-i18n-data" set:html={JSON.stringify({noCoords:c.mapNote,price:c.request,detail:c.open,mapMissing:c.mapNote,mapFailed:c.mapNote})}></script><script src="/js/joyjoy-maplibre.js" defer></script></>}
<script type="application/json" id="jj-gallery-data" set:html={JSON.stringify(listing.images).replace(/</g,'\\u003c')}></script>
<script src="/js/joyjoy-detail.js" defer></script>
