---
import BaseLayout from '../layouts/BaseLayout.astro';
const fields=[['title','Название'],['city','Город'],['district','Район'],['address','Адрес'],['area','Общая площадь, м²'],['priceUsd','Цена продажи, $ — пусто: по запросу'],['lat','Широта'],['lng','Долгота']];
const financial=[['purchasePrice','Цена покупки, $'],['transactionCosts','Расходы на сделку, $'],['fitOutCosts','Ремонт и подготовка, $'],['otherCosts','Прочие вложения, $'],['lettableArea','Сдаваемая площадь, м²'],['monthlyRent','Аренда, за м² в месяц (USD или UZS)'],['occupancy','Заполняемость, %'],['annualExpenses','Все годовые расходы, $'],['capex','CAPEX — дополнительные капитальные затраты в начале, $'],['holdYears','Срок владения, лет'],['exitCapRate','Cap Rate продажи, %'],['annualRentGrowth','Индексация аренды, % в год']];
---
<BaseLayout lang="ru" title="JoyJoy — управление объектами" robots="noindex,nofollow">
<div class="jj-admin" data-joyjoy-admin>
 <header class="jj-admin-top"><a href="/" aria-label="Joy squared"><img src="/joy2-logo.svg" width="102" height="44" alt="Joy²" /></a><strong>Объекты и инвестиции</strong><a href="/">На сайт</a><button type="button" data-admin-logout>Выйти</button></header>
 <div class="jj-admin-layout"><aside><div class="jj-admin-list-head"><h1>Объекты</h1><button type="button" data-new-property>Добавить</button></div><nav data-property-list aria-label="Объекты"></nav><p data-list-status role="status">Загружаем данные из GitHub…</p></aside>
 <main><p class="jj-admin-save-status" data-save-status role="status">Для сохранения нужен работающий Cloudflare Pages API и доступ к репозиторию JoyJoy.</p>
 <form data-property-editor hidden><header class="jj-admin-editor-head"><div><p class="jj-investment-kicker">JoyJoy / Редактор</p><h2 data-editor-title>Объект</h2></div><button type="submit" class="jj-admin-primary" data-save-property>Сохранить в GitHub</button></header>
 <fieldset><legend>Публикация</legend><div class="jj-admin-checks"><label><input name="published" type="checkbox" /> Объект опубликован</label><label><input name="insestproject" type="checkbox" /> Инвестиционный проект — открыть финансовую модель</label></div><p>Галочка открывает поля модели. Объект публикуется в общем каталоге; в инвестиционной подборке появляется только после публикации корректного расчёта.</p></fieldset>
 <fieldset><legend>Объект</legend><div class="jj-admin-fields"><label><span>Адрес страницы (slug)</span><input name="slug" pattern="[a-z0-9]+(-[a-z0-9]+)*" maxlength="100" required /><small>Для существующего объекта не меняется.</small></label>{fields.map(([name,label])=><label><span>{label}</span><input name={name} type={['area','priceUsd','lat','lng'].includes(name)?'number':'text'} step="any" required={['title','city','address','area'].includes(name)} /></label>)}<label><span>Тип</span><select name="type"><option value="retail">Ритейл</option><option value="office">Офисы</option><option value="warehouse">Склады</option><option value="land">Земля</option></select></label><label><span>Стадия строительства</span><select name="status"><option value="">Не подтверждено — выберите</option><option value="existing">Существующий</option><option value="under_construction">Строящийся</option></select></label><label class="jj-admin-wide"><span>Описание RU</span><textarea name="description" rows="4" required></textarea></label><label class="jj-admin-wide"><span>Характеристики RU — по одной на строку</span><textarea name="features" rows="3"></textarea></label><label class="jj-admin-wide"><span>Фотографии — HTTPS-ссылки или /images/…, по одной на строку</span><textarea name="images" rows="3"></textarea></label><section class="jj-admin-wide jj-admin-media-tools" aria-label="Управление фотографиями"><h3>Фотографии объекта</h3><p>Загрузка JPG/PNG/WebP, автоматическая подготовка JPEG 1200×675. Сначала сохраните новый объект, затем добавляйте фотографии.</p><label class="jj-admin-media-upload">Добавить фотографии <input data-joy-images type="file" accept="image/jpeg,image/png,image/webp" multiple /></label><div data-joy-gallery class="jj-admin-gallery"></div><p data-media-status role="status"></p></section><label class="jj-admin-wide"><span>Ссылка на источник</span><input name="sourceUrl" type="text" /></label></div></fieldset>
 <section class="jj-admin-translation-tools"><strong>Переводы RU → UZ / EN</strong><button type="button" data-joy-translate="uz">Заполнить пустые UZ</button><button type="button" data-joy-translate="en">Заполнить пустые EN</button><p data-translate-status role="status">Ручные переводы не перезаписываются. Перед публикацией проверьте результат.</p></section>
 {['uz','en'].map(lang=><details class="jj-admin-translations"><summary>Переводы {lang.toUpperCase()}</summary><p>Пустое поле использует имеющийся перевод CMWP, а для нового объекта — русский текст. Заполните переводы перед публикацией нового объекта.</p><div class="jj-admin-fields">{[['title','Название'],['city','Город'],['district','Район'],['address','Адрес'],['description','Описание'],['features','Характеристики (по строкам)']].map(([key,label])=><label class:list={{'jj-admin-wide':['description','features'].includes(key)}}><span>{label} {lang.toUpperCase()}</span><textarea name={lang+'_'+key} rows={['description','features'].includes(key)?3:1}></textarea></label>)}</div></details>)}
 <!-- JOY2_CONTACTS_TELEGRAM_V2: contact fields -->
 <fieldset data-joy2-contact-fields><legend>Контакты объекта</legend><div class="jj-admin-fields"><label><span>Контактный телефон</span><input name="contactPhone" type="tel" placeholder="+998 90 123 45 67" autocomplete="tel" /></label><label><span>Telegram</span><input name="contactTelegram" type="text" placeholder="@username или https://t.me/username" autocomplete="off" /></label></div><p>Телефон показывается справа на странице объекта, Telegram — на карточке каталога.</p></fieldset>
 <fieldset data-units-editor><legend>Помещения внутри объекта</legend><label class="jj-admin-check"><input type="checkbox" data-units-enabled /> Несколько помещений в продаже</label><p>Данные сохраняются внутри текущего объекта. Каждое помещение имеет собственную площадь, цену и при необходимости финансовую модель. Для DAHO сохранены все восемь вариантов.</p><textarea name="unitsJson" hidden></textarea><div data-units-list></div><button type="button" data-add-unit>+ Добавить помещение</button></fieldset>
 <fieldset data-investment-editor hidden><legend>Инвестиционная модель · USD</legend><label class="jj-admin-check"><input name="modelPublished" type="checkbox" /> Публиковать исходные параметры модели</label><p>Пусто означает «неизвестно». Если затрат нет, введите 0. Ставка и расходы должны быть заданы на одной основе; включите применимые налоги и резервы в годовые расходы.</p><div class="jj-admin-fields">{financial.map(([name,label])=><label><span>{label}</span><input name={name} type="number" min="0" max={name==='occupancy'||name==='annualRentGrowth'?'100':name==='holdYears'?'40':name==='exitCapRate'?'100':'1000000000000'} step="any" /></label>)}<label><span>Валюта арендной ставки</span><select name="rentCurrency"><option value="USD">USD — доллар США</option><option value="UZS">UZS — узбекский сум</option></select></label><label><span>USD/UZS · курс ЦБ (автоматически)</span><input name="usdUzs" type="number" readonly step="any" /></label><label><span>Средняя девальвация UZS за 5 лет, % годовых (автоматически)</span><input name="uzsDevaluation" type="number" readonly step="any" /></label><p class="jj-admin-wide" data-fx-status role="status">Курс и девальвация загружаются автоматически. Если ЦБ недоступен, используется последнее сохранённое значение.</p><label><span>Основание ставки</span><select name="rentBasis"><option value="">Выберите основание</option><option value="assumption">Расчётное допущение</option><option value="asking">Ставка предложения</option><option value="contract">По договору</option></select></label><label><span>Дата исходных данных</span><input name="asOf" type="date" /></label><label class="jj-admin-wide"><span>Источник ставки и условия: налоги, состав расходов, ограничения</span><textarea name="sourceNote" rows="3"></textarea></label></div></fieldset>
 <section class="jj-admin-site-preview"><h3>Предпросмотр объекта на Joy²</h3><p>Показывает опубликованную версию после сборки и деплоя. Несохранённые изменения не видны.</p><div class="jj-admin-preview-links"><a data-joy-preview-ru href="/" target="_blank" rel="noopener">RU</a><a data-joy-preview-uz href="/uz/" target="_blank" rel="noopener">UZ</a><a data-joy-preview-en href="/en/" target="_blank" rel="noopener">EN</a></div><iframe data-joy-preview-frame title="Предпросмотр объекта Joy²" loading="lazy"></iframe></section>
 <section class="jj-admin-model-preview"><h3>Предпросмотр расчёта</h3><p data-admin-model-status role="status"></p><dl class="jj-investment-results">{[['irrPercent','IRR, % годовых'],['totalInvestment','Всего вложений'],['annualRent','Доход от аренды в 1-й год'],['annualNet','NOI 1-го года'],['salePrice','Продажа в конце срока, $']].map(([key,label])=><div><dt>{label}</dt><dd data-admin-result={key}>—</dd></div>)}</dl><p class="jj-model-note">Покупка в год 0; CAPEX учитывается в первоначальных вложениях. Продажа в конце срока по годовой аренде за последний год владения до налога на прибыль / Exit Cap Rate. IRR — годовая доходность в %. Без кредитного плеча и налогов, не включённых в годовые расходы.</p></section>
 </form></main></div>
</div><script src="/js/joyjoy-admin.js" type="module"></script><script src="/js/joyjoy-units-admin.js" type="module"></script>
<style is:global>
.jj-admin-media-tools,.jj-admin-translation-tools,.jj-admin-site-preview{padding:18px;margin:16px 0;border:1px solid #dedede;border-radius:12px;background:#fff}
.jj-admin-media-tools h3,.jj-admin-site-preview h3{margin:0 0 10px}.jj-admin-media-tools p,.jj-admin-site-preview p{font-size:13px;line-height:1.5;color:#59625e}
.jj-admin-media-upload{display:inline-flex;align-items:center;gap:12px;flex-wrap:wrap;padding:10px 16px;border-radius:8px;border:1px solid #d90016;color:#d90016;cursor:pointer}.jj-admin-media-upload input{max-width:210px}
.jj-admin-gallery{display:grid;grid-template-columns:repeat(auto-fill,minmax(145px,1fr));gap:12px;margin-top:14px}.jj-admin-gallery figure{margin:0;min-width:0}.jj-admin-gallery img{display:block;width:100%;aspect-ratio:16/9;object-fit:cover;border-radius:7px}.jj-admin-gallery button{margin-top:5px;font-size:12px;padding:5px 8px}.jj-admin-gallery figcaption{font-size:11px;overflow-wrap:anywhere}
.jj-admin-translation-tools button,.jj-admin-preview-links a{display:inline-flex;align-items:center;margin:8px 8px 0 0;padding:8px 12px;border:1px solid #bbb;border-radius:7px;background:#fff;color:#222;text-decoration:none}.jj-admin-site-preview iframe{display:block;margin-top:14px;width:100%;height:470px;max-height:65vh;border:1px solid #ddd;border-radius:8px;background:#fafafa}
@media(max-width:700px){.jj-admin-site-preview iframe{height:330px}.jj-admin-media-tools,.jj-admin-translation-tools,.jj-admin-site-preview{padding:12px}}
</style>
</BaseLayout>
