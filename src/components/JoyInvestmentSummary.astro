---
import {calculateInvestment} from '../../public/js/joyjoy-investment-model.js';
const {model,unit,lang='ru'}=Astro.props;
const result=calculateInvestment(model);
const loc=lang==='en'?'en-US':lang==='uz'?'uz-UZ':'ru-RU';
const money=(n)=>Number.isFinite(n)?new Intl.NumberFormat('en-US',{style:'currency',currency:'USD',maximumFractionDigits:0}).format(n):'—';
const num=(n)=>Number.isFinite(n)?new Intl.NumberFormat(loc,{maximumFractionDigits:2}).format(n):'—';
const txt={ru:{title:'Инвестиционный расчёт',notes:'Расчётный сценарий; не является гарантией доходности.',purchase:'Цена покупки',sale:'Цена продажи',profit:'Итоговая прибыль',irr:'IRR · годовых',area:'Площадь',mezz:'Мезонин',rent:'Аренда',index:'Индексация в год',capex:'CAPEX',hold:'Срок владения',occ:'Заполняемость',exit:'Exit Cap Rate',flows:'Денежные потоки по годам',year:'Год',income:'Арендный доход',expenses:'Расходы',noi:'NOI',saleCash:'Продажа',cash:'Cash Flow',years:'лет',profitNote:'Цена продажи + накопленный NOI − первоначальные вложения',currencyNote:'Арендная ставка за м² в месяц'},en:{title:'Investment analysis',notes:'Illustrative assumptions; returns are not guaranteed.',purchase:'Purchase price',sale:'Exit sale price',profit:'Total profit',irr:'IRR · annual',area:'Area',mezz:'Mezzanine',rent:'Monthly rent',index:'Annual escalation',capex:'CAPEX',hold:'Holding period',occ:'Occupancy',exit:'Exit cap rate',flows:'Annual cash flows',year:'Year',income:'Rent revenue',expenses:'Expenses',noi:'NOI',saleCash:'Exit proceeds',cash:'Cash flow',years:'years',profitNote:'Exit sale + cumulative NOI − initial investment',currencyNote:'Rent per m² per month'},uz:{title:'Investitsiya hisobi',notes:'Taxminiy hisob, daromad kafolatlanmaydi.',purchase:'Sotib olish narxi',sale:'Sotish narxi',profit:'Jami foyda',irr:'IRR · yillik',area:'Maydon',mezz:'Mezonin',rent:'Ijara stavkasi',index:'Yillik o‘sish',capex:'CAPEX',hold:'Egalik muddati',occ:'Bandlik',exit:'Exit cap rate',flows:'Yillik pul oqimlari',year:'Yil',income:'Ijara daromadi',expenses:'Xarajatlar',noi:'NOI',saleCash:'Sotish',cash:'Pul oqimi',years:'yil',profitNote:'Sotish narxi + jami NOI − boshlang‘ich investitsiya',currencyNote:'Oyiga, m² uchun'}}[lang];
const totalNOI=result.ok?result.schedule.reduce((s,r)=>s+r.noi,0):null;
const profit=result.ok?result.netProfit:null;
const assumptions=[
 [txt.area,num(model.lettableArea)+' m²'],
 [txt.mezz,num(model.mezzanineArea??0)+' m²'],
 [txt.rent,num(model.monthlyRent)+' '+(model.rentCurrency||'USD')+'/m²'],
 [txt.index,num(model.annualRentGrowth)+'%'],
 [txt.capex,money(model.capex??0)],
 [txt.hold,num(model.holdYears)+' '+txt.years],
 [txt.occ,num(model.occupancy)+'%'],
 [txt.exit,num(model.exitCapRate)+'%']];
const kpis=[[txt.irr,result.irrPercent==null?'—':num(result.irrPercent)+'%'],[txt.purchase,money(model.purchasePrice)],[txt.sale,money(result.salePrice)],[txt.profit,money(profit)]];
---
{result.ok?<section class="jj-readonly-investment" aria-label={txt.title}>
 <div class="jj-rinv-head"><div><h3>{txt.title} · {unit.block} {unit.number}</h3><p>{txt.notes}</p></div></div>
 <div class="jj-rinv-kpis">{kpis.map(([name,value])=><div><small>{name}</small><strong>{value}</strong></div>)}</div>
 <p class="jj-rinv-metric-note">{txt.profitNote}</p>
 <h4>{lang==='ru'?'Исходные параметры':lang==='en'?'Assumptions':'Boshlang‘ich parametrlar'}</h4>
 <dl class="jj-rinv-inputs">{assumptions.map(([name,value])=><div><dt>{name}</dt><dd>{value}</dd></div>)}</dl>
 <p class="jj-rinv-rent-note">{txt.currencyNote}. {model.sourceNote||''}</p>
 <h4>{txt.flows}</h4>
 <div class="jj-rinv-table-wrap"><table class="jj-rinv-table"><thead><tr><th>{txt.year}</th><th>{txt.income}</th><th>{txt.expenses}</th><th>{txt.noi}</th><th>{txt.saleCash}</th><th>{txt.cash}</th></tr></thead><tbody><tr><th>0</th><td>—</td><td>—</td><td>—</td><td>—</td><td>{money(-result.totalInvestment)}</td></tr>{result.schedule.map(r=><tr><th>{r.year}</th><td>{money(r.revenue)}</td><td>{money(r.expenses)}</td><td>{money(r.noi)}</td><td>{r.sale?money(r.sale):'—'}</td><td>{money(r.cashFlow)}</td></tr>)}</tbody></table></div>
 </section>:<p>{lang==='ru'?'Расчёт пока не опубликован: параметры модели неполные.':lang==='en'?'Analysis is unavailable because the model is incomplete.':'Model maʼlumotlari toʻliq emas.'}</p>}
<style>
.jj-readonly-investment{margin-top:16px;padding:24px;border:1px solid #e4e4e4;background:#fff;border-radius:14px}.jj-rinv-head h3{font-size:24px;margin:0 0 8px}.jj-rinv-head p,.jj-rinv-metric-note,.jj-rinv-rent-note{color:#66716a;font-size:13px;line-height:1.5}.jj-rinv-kpis{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px;margin:22px 0 12px}.jj-rinv-kpis>div{padding:15px;background:#f6f7f6;border:1px solid #e5e7e5;border-radius:10px;min-width:0}.jj-rinv-kpis small{display:block;color:#65716a;font-size:12px;margin-bottom:8px}.jj-rinv-kpis strong{display:block;font-size:clamp(17px,2vw,25px);font-weight:700;word-break:break-word;font-variant-numeric:tabular-nums}.jj-rinv-kpis>div:first-child strong{color:#d90016}.jj-readonly-investment h4{margin:26px 0 14px;font-size:16px}.jj-rinv-inputs{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px}.jj-rinv-inputs>div{padding:12px 0;border-bottom:1px solid #e8ece9;min-width:0}.jj-rinv-inputs dt{color:#65716a;font-size:12px}.jj-rinv-inputs dd{margin:7px 0 0;font-size:15px;font-weight:600;word-break:break-word}.jj-rinv-table-wrap{overflow-x:auto}.jj-rinv-table{width:100%;min-width:670px;border-collapse:collapse;font-variant-numeric:tabular-nums}.jj-rinv-table td,.jj-rinv-table th{text-align:right;padding:11px 9px;border-bottom:1px solid #e9ece9;white-space:nowrap;font-size:13px}.jj-rinv-table th:first-child{text-align:left}.jj-rinv-table thead th{font-size:12px;color:#65716a}.jj-rinv-table tr:last-child{font-weight:700}@media(max-width:820px){.jj-readonly-investment{padding:15px}.jj-rinv-kpis{grid-template-columns:repeat(2,minmax(0,1fr))}.jj-rinv-inputs{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:450px){.jj-rinv-kpis{grid-template-columns:1fr 1fr}.jj-rinv-kpis strong{font-size:17px}}
</style>
