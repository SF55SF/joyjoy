<script is:inline>
document.addEventListener('click',event=>{
 const link=event.target instanceof Element?event.target.closest('[data-jj-hero-type]'):null;
 if(!link)return;
 const type=link.getAttribute('data-jj-hero-type');
 const select=document.getElementById('jj-type');
 if(!(select instanceof HTMLSelectElement)||!type)return;
 select.value=type;
 select.dispatchEvent(new Event('change',{bubbles:true}));
 document.getElementById('catalog')?.scrollIntoView({behavior:matchMedia('(prefers-reduced-motion: reduce)').matches?'instant':'smooth',block:'start'});
});
</script>

<script is:inline>
/* JOY2_NAV_SCROLL_AND_HEADER_V2: возвращаем пользователя к исходному объекту, сохраняя сортировку и фильтры. */
(()=>{
  const key='joy2-catalog-return:'+location.pathname;
  const fields=['jj-q','jj-type','jj-sort','jj-area-min','jj-area-max','jj-price-min','jj-price-max'];
  document.addEventListener('click',e=>{
    const a=e.target instanceof Element?e.target.closest('a[href*="/listing/"]'):null;
    if(!a||!document.getElementById('jj-results'))return;
    const values={};for(const id of fields){const el=document.getElementById(id);if(el&&'value'in el)values[id]=el.value;}
    try{sessionStorage.setItem(key,JSON.stringify(values));}catch{}
  },true);
  function restore(){
    const hash=decodeURIComponent(location.hash.slice(1));
    if(!hash.startsWith('jj-object-'))return;
    try{const state=JSON.parse(sessionStorage.getItem(key)||'null');if(state){for(const [id,v] of Object.entries(state)){const el=document.getElementById(id);if(el&&'value'in el&&el.value!==v){el.value=v;el.dispatchEvent(new Event('input',{bubbles:true}));el.dispatchEvent(new Event('change',{bubbles:true}));}}}}catch{}
    const go=()=>{const el=document.getElementById(hash);if(el&&getComputedStyle(el).display!=='none')el.scrollIntoView({behavior:'instant',block:'start'});};
    go();setTimeout(go,150);setTimeout(go,650);
  }
  if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',restore,{once:true});else restore();
})();
</script>
