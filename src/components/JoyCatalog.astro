---
// JOYJOY_MARKETPLACE_CATALOG_V1
import { listings } from '../data/listings';
import type { Lang } from '../lib/i18n';
const lang = (Astro.props.lang ?? 'ru') as Lang;
const base = lang === 'ru' ? '/' : '/' + lang + '/';
const texts = {
  ru: { browse:'Каталог', sell:'Коммерческая недвижимость', hero:'Найдите помещение для бизнеса или инвестиций', intro:'Объекты на продажу. Поиск по типу, району, площади и стоимости.', search:'Город, район, адрес или название', all:'Все типы', office:'Офисы', retail:'Торговые помещения', warehouse:'Склады', land:'Земля', other:'Другое', minArea:'Площадь от, м²', maxPrice:'Цена до, $', filter:'Найти объекты', clear:'Сбросить', list:'Объявления о продаже', price:'Цена по запросу', area:'м²', noresults:'Объектов по выбранным параметрам пока нет.', empty:'Каталог готов к наполнению. Подтверждённые объекты появятся здесь.', detail:'Подробнее', sort:'Сортировка', newest:'По умолчанию', pricelow:'Сначала дешевле', pricehigh:'Сначала дороже', areahigh:'Сначала большие', available:'В продаже', reserved:'Забронировано', sold:'Продано', footer:'JoyJoy — коммерческая недвижимость', count:'Найдено объектов', contact:'Связь с продавцом появится после добавления объявления', subtitle:'Продажа коммерческих помещений' },
  uz: { browse:'Katalog', sell:'Tijorat ko‘chmas mulki', hero:'Biznes yoki investitsiya uchun joy toping', intro:'Sotuvdagi obyektlar. Tur, hudud, maydon va narx bo‘yicha qidiruv.', search:'Shahar, tuman, manzil yoki nom', all:'Barcha turlar', office:'Ofislar', retail:'Savdo maydonlari', warehouse:'Omborlar', land:'Yer', other:'Boshqa', minArea:'Maydon, m² dan', maxPrice:'Narx, $ gacha', filter:'Qidirish', clear:'Tozalash', list:'Sotuvdagi obyektlar', price:'Narx so‘rov asosida', area:'m²', noresults:'Tanlangan shartlarga mos obyektlar yo‘q.', empty:'Katalog tayyor. Tasdiqlangan obyektlar shu yerda paydo bo‘ladi.', detail:'Batafsil', sort:'Saralash', newest:'Standart', pricelow:'Arzonidan', pricehigh:'Qimmatidan', areahigh:'Kattasidan', available:'Sotuvda', reserved:'Band qilingan', sold:'Sotilgan', footer:'JoyJoy — tijorat ko‘chmas mulki', count:'Obyektlar soni', contact:'Sotuvchi bilan aloqa obyekt qo‘shilgach paydo bo‘ladi', subtitle:'Tijorat binolarini sotish' },
  en: { browse:'Listings', sell:'Commercial real estate', hero:'Find your next business or investment property', intro:'Properties for sale. Search by property type, location, size and price.', search:'City, district, address or name', all:'All property types', office:'Offices', retail:'Retail', warehouse:'Warehouses', land:'Land', other:'Other', minArea:'Minimum area, m²', maxPrice:'Maximum price, $', filter:'Search properties', clear:'Reset', list:'Properties for sale', price:'Price on request', area:'m²', noresults:'No properties match your filters.', empty:'The catalog is ready. Verified listings will appear here.', detail:'View details', sort:'Sort by', newest:'Default', pricelow:'Price: low to high', pricehigh:'Price: high to low', areahigh:'Area: largest first', available:'For sale', reserved:'Reserved', sold:'Sold', footer:'JoyJoy — commercial real estate', count:'Properties found', contact:'Seller contact will appear when a property is listed', subtitle:'Commercial properties for sale' }
} as const;
const t = texts[lang];
const types = ['office','retail','warehouse','land','other'] as const;
const mapListings = listings.filter((item) => typeof item.lat === 'number' && typeof item.lng === 'number' && Number.isFinite(item.lat) && Number.isFinite(item.lng)).map((item) => ({slug:item.slug,title:item.title,lat:item.lat!,lng:item.lng!,area:item.area,price:item.priceUsd}));
---
<header class="jj-header"><div class="jj-container jj-top"><a class="jj-brand" href={base} aria-label="JoyJoy home">joy<span>joy</span><b>.</b></a><nav><a href="#catalog">{t.browse}</a><div class="jj-langs"><a href="/" aria-current={lang==='ru'?'page':undefined}>RU</a><a href="/uz/" aria-current={lang==='uz'?'page':undefined}>UZ</a><a href="/en/" aria-current={lang==='en'?'page':undefined}>EN</a></div></nav></div></header>
<main>
  <section class="jj-hero"><div class="jj-container"><p class="jj-eyebrow">JOYJOY / {t.subtitle}</p><h1>{t.hero}</h1><p class="jj-hero-sub">{t.intro}</p><form id="jj-filters" class="jj-search" role="search"><label class="jj-query"><span>{t.search}</span><input id="jj-q" type="search" placeholder={t.search} autocomplete="off" /></label><label><span>{t.all}</span><select id="jj-type"><option value="">{t.all}</option>{types.map((type)=><option value={type}>{t[type]}</option>)}</select></label><label><span>{t.minArea}</span><input id="jj-area" type="number" min="0" step="1" placeholder="0" /></label><label><span>{t.maxPrice}</span><input id="jj-price" type="number" min="0" step="1" placeholder="$" /></label><button type="submit">{t.filter} <span aria-hidden="true">↗</span></button></form></div></section>
  <section id="catalog" class="jj-catalog jj-container"><div class="jj-section-heading"><div><p class="jj-eyebrow">JOYJOY / MARKETPLACE</p><h2>{t.list}</h2><p id="jj-count" aria-live="polite">{t.count}: {listings.length}</p></div><div class="jj-tools"><label class="jj-sort">{t.sort}<select id="jj-sort"><option value="default">{t.newest}</option><option value="priceAsc">{t.pricelow}</option><option value="priceDesc">{t.pricehigh}</option><option value="areaDesc">{t.areahigh}</option></select></label><button id="jj-clear" class="jj-reset" type="button">{t.clear}</button></div></div>
  <div class="jj-results-layout"><div class="jj-grid" id="jj-results">
    {listings.map((item,index)=><article class="jj-card" data-slug={item.slug} data-index={index} data-search={(item.title+' '+item.city+' '+item.district+' '+item.address).toLowerCase()} data-type={item.type} data-area={item.area} data-price={item.priceUsd ?? ''}>
      <a class="jj-card-photo" href={base+'listing/'+encodeURIComponent(item.slug)+'/'}>{item.images[0]?<img src={item.images[0]} alt={item.title} loading="lazy" />:<span class="jj-no-image">JOYJOY</span>}<span class="jj-status">{t[item.status]}</span></a>
      <div class="jj-card-content"><p class="jj-kind">{t[item.type]} · {item.city}</p><h3><a href={base+'listing/'+encodeURIComponent(item.slug)+'/'}>{item.title}</a></h3><p class="jj-address">{item.district}{item.address?' · '+item.address:''}</p><div class="jj-card-info"><strong>{item.priceUsd === null ? t.price : '$'+item.priceUsd.toLocaleString('en-US')}</strong><span>{item.area.toLocaleString('en-US')} {t.area}</span></div><a class="jj-detail-link" href={base+'listing/'+encodeURIComponent(item.slug)+'/'}>{t.detail} ↗</a></div>
    </article>)}
  </div>
  <aside class="jj-map-panel" aria-label="Property map">
    <div class="jj-map-top"><strong>{lang === "ru" ? "Объекты на карте" : lang === "uz" ? "Xaritadagi obyektlar" : "Properties on the map"}</strong><span id="jj-map-count" aria-live="polite"></span></div>
    <div class="jj-map-frame"><iframe id="jj-map-fallback" title="Tashkent map" loading="lazy" referrerpolicy="no-referrer" src="https://www.openstreetmap.org/export/embed.html?bbox=69.155%2C41.220%2C69.400%2C41.400&amp;layer=mapnik"></iframe><div id="jj-property-map" role="application" aria-label="Interactive property map"></div></div>
    <p class="jj-map-note">{lang === "ru" ? "Метки отображаются только для объектов с подтверждёнными координатами." : lang === "uz" ? "Belgilar faqat tasdiqlangan koordinatali obyektlar uchun ko‘rsatiladi." : "Pins appear only for listings with verified coordinates."}</p>
  </aside></div><p class="jj-empty" id="jj-empty" hidden>{listings.length===0?t.empty:t.noresults}</p></section>
</main><footer class="jj-footer"><div class="jj-container"><span>{t.footer}</span><span>© {new Date().getFullYear()}</span></div></footer>
<script is:inline>
// JOYJOY_MARKETPLACE_FILTERS_V1
(()=>{const form=document.getElementById('jj-filters');if(!form)return;const q=document.getElementById('jj-q'),type=document.getElementById('jj-type'),area=document.getElementById('jj-area'),price=document.getElementById('jj-price'),sort=document.getElementById('jj-sort'),clear=document.getElementById('jj-clear'),grid=document.getElementById('jj-results'),empty=document.getElementById('jj-empty'),count=document.getElementById('jj-count');const cards=[...grid.querySelectorAll('.jj-card')];const countLabel=count.textContent.split(':')[0];function update(){const query=q.value.trim().toLocaleLowerCase(),min=area.value===''?0:Number(area.value),max=price.value===''?Infinity:Number(price.value);let visible=cards.filter(card=>card.dataset.search.includes(query)&&(!type.value||card.dataset.type===type.value)&&Number(card.dataset.area)>=min&&(card.dataset.price===''||Number(card.dataset.price)<=max));cards.forEach(card=>card.hidden=!visible.includes(card));visible.sort((a,b)=>sort.value==='priceAsc'?(a.dataset.price===''?Infinity:Number(a.dataset.price))-(b.dataset.price===''?Infinity:Number(b.dataset.price)):sort.value==='priceDesc'?(b.dataset.price===''?-1:Number(b.dataset.price))-(a.dataset.price===''?-1:Number(a.dataset.price)):sort.value==='areaDesc'?Number(b.dataset.area)-Number(a.dataset.area):Number(a.dataset.index)-Number(b.dataset.index));visible.forEach(card=>grid.appendChild(card));count.textContent=countLabel+': '+visible.length;empty.hidden=visible.length!==0;window.dispatchEvent(new CustomEvent('joyjoy:filter-change',{detail:{slugs:visible.map(card=>card.dataset.slug)}}));}form.addEventListener('submit',e=>{e.preventDefault();update();document.getElementById('catalog').scrollIntoView({behavior:'smooth'});});[q,type,area,price,sort].forEach(el=>el.addEventListener('input',update));clear.addEventListener('click',()=>{form.reset();sort.value='default';update();});update();})();
</script>

<!-- JOYJOY_CATALOG_MAP_V2 -->
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
<script id="jj-map-data" type="application/json" set:html={JSON.stringify(mapListings).replace(/</g, '\\u003c')}></script>
<script is:inline>
// JOYJOY_CATALOG_MAP_V2
(()=>{
 const container=document.getElementById('jj-property-map');if(!container)return;
 const dataNode=document.getElementById('jj-map-data');let items=[];try{items=JSON.parse(dataNode.textContent||'[]')}catch(e){return}
 const fallback=document.getElementById('jj-map-fallback'), counter=document.getElementById('jj-map-count');
 const catalog=document.getElementById('jj-results');const cards=()=>[...catalog.querySelectorAll('.jj-card:not([hidden])')];
 const slugs=()=>new Set(cards().map(c=>c.dataset.slug));
 let map,markers;
 const refresh=()=>{const visible=slugs();const selected=items.filter(item=>visible.has(item.slug));counter.textContent=selected.length+' / '+items.length;if(!map)return;markers.clearLayers();for(const item of selected){const popup=document.createElement('div');const name=document.createElement('strong');name.textContent=item.title;popup.append(name);popup.append(document.createElement('br'));const link=document.createElement('a');link.textContent='View details ↗';link.href=(window.location.pathname.startsWith('/en/')?'/en/':window.location.pathname.startsWith('/uz/')?'/uz/':'/')+'listing/'+encodeURIComponent(item.slug)+'/';popup.append(link);window.L.marker([item.lat,item.lng]).bindPopup(popup).addTo(markers);}if(selected.length){const bounds=window.L.latLngBounds(selected.map(item=>[item.lat,item.lng]));map.fitBounds(bounds.pad(.25),{maxZoom:15});}else map.setView([41.2995,69.2401],11);};
 window.addEventListener('joyjoy:filter-change',refresh);
 const script=document.createElement('script');script.src='https://unpkg.com/leaflet@1.9.4/dist/leaflet.js';script.onload=()=>{if(!window.L)return;map=window.L.map(container,{scrollWheelZoom:false}).setView([41.2995,69.2401],11);window.L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png',{maxZoom:19,attribution:'&copy; OpenStreetMap contributors'}).addTo(map);markers=window.L.layerGroup().addTo(map);fallback.hidden=true;container.style.display='block';refresh();setTimeout(()=>map.invalidateSize(),150);};script.onerror=()=>{counter.textContent='';};document.head.append(script);refresh();
})();
</script>
