---
// JOYJOY_LOOPNET_CATALOG_V5
import { listings } from '../data/listings';
import type { Lang } from '../lib/i18n';
const lang = (Astro.props.lang ?? 'ru') as Lang;
const base = lang === 'ru' ? '/' : `/${lang}/`;
const copy = {
  ru: {market:'Коммерческая недвижимость',sale:'Продажа',title:'Коммерческая недвижимость на продажу',intro:'Подберите помещение для бизнеса или инвестиций в Узбекистане',q:'Город, район, адрес или название',category:'Тип недвижимости',all:'Все типы',office:'Офис',retail:'Торговое',warehouse:'Склад',industrial:'Производство',building:'Здание',land:'Земля',other:'Другое',min:'Площадь от, м²',max:'Площадь до, м²',minPrice:'Цена от, $',maxPrice:'Цена до, $',unknown:'Включая цены по запросу',status:'Статус',available:'В продаже',reserved:'Забронировано',sold:'Продано',search:'Найти',reset:'Сбросить',found:'Найдено объектов',results:'Объекты',sort:'Сортировка',default:'По умолчанию',priceAsc:'Сначала дешевле',priceDesc:'Сначала дороже',areaDesc:'Площадь: по убыванию',areaAsc:'Площадь: по возрастанию',list:'Список',split:'Список + карта',map:'Карта',mapTitle:'Расположение объектов',searchArea:'Искать в этой области',resetArea:'Сбросить область',mapNote:'Для карты нужен OpenFreeMap. Объекты без подтверждённых координат остаются в каталоге.',noCoords:'Пока нет объектов с подтверждёнными координатами',detail:'Смотреть объект',price:'Цена по запросу',clear:'Очистить фильтры',nothing:'По выбранным параметрам ничего не найдено',favorites:'Избранное',favorite:'В избранное',source:'CMWP',mapMissing:'Карта временно недоступна',mapFailed:'Не удалось загрузить карту',notMapped:'Без координат',photos:'Фотографии объектов',disclaimer:'Предложения и параметры уточняйте у продавца. Источник объявлений: CMWP.'},
  uz: {market:'Tijorat ko‘chmas mulki',sale:'Sotuv',title:'Sotuvdagi tijorat ko‘chmas mulki',intro:'O‘zbekistonda biznes yoki investitsiya uchun obyekt toping',q:'Shahar, tuman, manzil yoki nom',category:'Mulk turi',all:'Barcha turlar',office:'Ofis',retail:'Savdo',warehouse:'Ombor',industrial:'Ishlab chiqarish',building:'Bino',land:'Yer',other:'Boshqa',min:'Maydon, m² dan',max:'Maydon, m² gacha',minPrice:'Narx, $ dan',maxPrice:'Narx, $ gacha',unknown:'So‘rov asosidagi narxlarni kiritish',status:'Holat',available:'Sotuvda',reserved:'Band',sold:'Sotilgan',search:'Qidirish',reset:'Tozalash',found:'Obyektlar soni',results:'Obyektlar',sort:'Saralash',default:'Standart',priceAsc:'Arzonidan',priceDesc:'Qimmatidan',areaDesc:'Maydon: kattasidan',areaAsc:'Maydon: kichigidan',list:'Ro‘yxat',split:'Ro‘yxat + xarita',map:'Xarita',mapTitle:'Obyektlar xaritada',searchArea:'Shu hududda qidirish',resetArea:'Hududni tozalash',mapNote:'Xarita uchun OpenFreeMap kerak. Koordinatasiz obyektlar ro‘yxatda qoladi.',noCoords:'Tasdiqlangan koordinatali obyektlar hozircha yo‘q',detail:'Obyektni ko‘rish',price:'Narx so‘rov asosida',clear:'Filtrlarni tozalash',nothing:'Mos obyektlar topilmadi',favorites:'Saqlanganlar',favorite:'Saqlash',source:'CMWP',mapMissing:'Карта временно недоступна',mapFailed:'Не удалось загрузить карту',notMapped:'Koordinatasiz',photos:'Obyekt suratlari',disclaimer:'Taklif va parametrlarni sotuvchi bilan aniqlang. Manba: CMWP.'},
  en: {market:'Commercial real estate',sale:'For sale',title:'Commercial properties for sale',intro:'Explore spaces for business and investment in Uzbekistan',q:'City, district, address or property',category:'Property type',all:'All types',office:'Office',retail:'Retail',warehouse:'Warehouse',industrial:'Industrial',building:'Building',land:'Land',other:'Other',min:'Min area, m²',max:'Max area, m²',minPrice:'Min price, $',maxPrice:'Max price, $',unknown:'Include price on request',status:'Status',available:'For sale',reserved:'Reserved',sold:'Sold',search:'Search',reset:'Reset',found:'Properties found',results:'Listings',sort:'Sort by',default:'Default',priceAsc:'Price: low to high',priceDesc:'Price: high to low',areaDesc:'Area: largest first',areaAsc:'Area: smallest first',list:'List',split:'List + map',map:'Map',mapTitle:'Property locations',searchArea:'Search this area',resetArea:'Clear map area',mapNote:'OpenFreeMap required. Listings without verified coordinates remain visible in the list.',noCoords:'No listings with verified coordinates yet',detail:'View property',price:'Price on request',clear:'Clear filters',nothing:'No listings match your search',favorites:'Saved',favorite:'Save property',source:'CMWP',mapMissing:'Карта временно недоступна',mapFailed:'Не удалось загрузить карту',notMapped:'No coordinates',photos:'Property photos',disclaimer:'Confirm pricing and availability with seller. Listing source: CMWP.'}
}[lang];
const types = ['office','retail','warehouse','industrial','building','land','other'] as const;
const names = Object.fromEntries(types.map(k=>[k,copy[k]]));
const mapData = listings.filter(x => Number.isFinite(x.lat) && Number.isFinite(x.lng) && Math.abs(x.lat!)<=90 && Math.abs(x.lng!)<=180).map(x=>({slug:x.slug,title:x.title,lat:x.lat,lng:x.lng,price:x.priceUsd,area:x.area,image:x.images?.[0]||'',url:base+'listing/'+encodeURIComponent(x.slug)+'/'}));
// OpenFreeMap needs no API key.

---
<header class="jj-sitebar"><div class="jj-shell jj-sitebar-in"><a href={base} class="jj-wordmark" aria-label="JoyJoy homepage">joy<span>joy</span><b>.</b></a><nav class="jj-primary-nav" aria-label="Main"><a class="is-current" href="#catalog">{copy.market}</a><a href="#catalog">{copy.sale}</a></nav><div class="jj-sitebar-right"><button class="jj-saved-link" id="jj-saved-only" type="button" aria-pressed="false">♡ <span>{copy.favorites}</span> <small id="jj-saved-count">0</small></button><div class="jj-lang" aria-label="Language"><a href="/" aria-current={lang==='ru'?'page':undefined}>RU</a><a href="/uz/" aria-current={lang==='uz'?'page':undefined}>UZ</a><a href="/en/" aria-current={lang==='en'?'page':undefined}>EN</a></div></div></div></header>
<main>
  <section class="jj-intro jj-shell"><p class="jj-crumb">JoyJoy <span>/</span> {copy.sale}</p><h1>{copy.title}</h1><p>{copy.intro}</p></section>
  <section class="jj-filter-shell"><div class="jj-shell"><form id="jj-filters" class="jj-filter-form" role="search"><label class="jj-field jj-field-search"><span>{copy.q}</span><input id="jj-q" type="search" placeholder={copy.q} autocomplete="off" /></label><label class="jj-field"><span>{copy.category}</span><select id="jj-type"><option value="">{copy.all}</option>{types.map(type=><option value={type}>{names[type]}</option>)}</select></label><label class="jj-field"><span>{copy.min}</span><input id="jj-area-min" type="number" min="0" step="1" placeholder="0" /></label><label class="jj-field jj-extra"><span>{copy.max}</span><input id="jj-area-max" type="number" min="0" step="1" placeholder="∞" /></label><label class="jj-field jj-extra"><span>{copy.minPrice}</span><input id="jj-price-min" type="number" min="0" step="1" placeholder="0" /></label><label class="jj-field"><span>{copy.maxPrice}</span><input id="jj-price-max" type="number" min="0" step="1" placeholder="∞" /></label><button class="jj-search-submit" type="submit">⌕ <span>{copy.search}</span></button><label class="jj-price-unknown"><input id="jj-unknown" type="checkbox" checked />{copy.unknown}</label><label class="jj-status-select"><span>{copy.status}</span><select id="jj-status"><option value="">{copy.all}</option><option value="available">{copy.available}</option><option value="reserved">{copy.reserved}</option><option value="sold">{copy.sold}</option></select></label></form></div></section>
  <section class="jj-shell jj-listing-section" id="catalog"><div class="jj-listing-heading"><div><h2>{copy.results}</h2><p id="jj-count" aria-live="polite">{copy.found}: {listings.length}</p></div><div class="jj-listing-actions"><label>{copy.sort} <select id="jj-sort"><option value="default">{copy.default}</option><option value="priceAsc">{copy.priceAsc}</option><option value="priceDesc">{copy.priceDesc}</option><option value="areaDesc">{copy.areaDesc}</option><option value="areaAsc">{copy.areaAsc}</option></select></label><button type="button" id="jj-reset">{copy.reset}</button><div class="jj-view-switch" role="group" aria-label="View"><button type="button" data-jj-view="split" aria-pressed="true">▦ <span>{copy.split}</span></button><button type="button" data-jj-view="list" aria-pressed="false">☰ <span>{copy.list}</span></button><button type="button" data-jj-view="map" aria-pressed="false">◫ <span>{copy.map}</span></button></div></div></div>
    <div class="jj-workspace" data-jj-mode="split"><div class="jj-card-grid" id="jj-results">{listings.map((item,index)=><article class="jj-property-card" data-slug={item.slug} data-index={index} data-search={(item.title+' '+item.city+' '+item.district+' '+item.address+' '+item.description).toLocaleLowerCase()} data-type={item.type} data-status={item.status} data-area={item.area} data-price={item.priceUsd??''}>
      <a class="jj-property-card-image" href={base+'listing/'+encodeURIComponent(item.slug)+'/'}>{item.images?.[0]?<img src={item.images[0]} alt={item.title} loading="lazy" />:<span class="jj-image-placeholder">joyjoy.</span>}<span class="jj-label-status">{copy[item.status]}</span></a>
      <div class="jj-property-card-main"><div class="jj-card-overline">{names[item.type]||copy.other} · {item.city}</div><div class="jj-card-name-row"><h3><a href={base+'listing/'+encodeURIComponent(item.slug)+'/'}>{item.title}</a></h3><button type="button" class="jj-save" data-jj-save={item.slug} aria-label={copy.favorite} aria-pressed="false">♡</button></div><p class="jj-property-address">{[item.district,item.address].filter(Boolean).join(' · ')||item.city}</p><div class="jj-property-summary"><span><b>{item.area.toLocaleString('ru-RU')}</b> м²</span><span>{item.priceUsd===null?copy.price:'$'+item.priceUsd.toLocaleString('en-US')}</span></div><div class="jj-card-bottom"><a href={base+'listing/'+encodeURIComponent(item.slug)+'/'}>{copy.detail} <span aria-hidden="true">→</span></a><small>{copy.source}</small></div></div>
    </article>)}</div>
    <aside class="jj-map-panel"><div class="jj-map-top"><strong>{copy.mapTitle}</strong><span id="jj-map-count">0 / {listings.length}</span></div><div class="jj-map-wrap"><div id="jj-map" role="region" aria-label={copy.mapTitle} data-map-provider="openfreemap"></div><div class="jj-map-empty" id="jj-map-state"><span>⌖</span><p>{copy.noCoords}</p></div><button type="button" id="jj-map-search-area" hidden>{copy.searchArea}</button></div><div class="jj-map-foot"><button id="jj-map-reset-area" type="button" hidden>{copy.resetArea}</button><small>{copy.mapNote}</small></div></aside>
    </div><div class="jj-no-results" id="jj-empty" hidden><p>{copy.nothing}</p><button type="button" id="jj-clear-empty">{copy.clear}</button></div></section>
</main><footer class="jj-bottom"><div class="jj-shell"><strong>joyjoy.</strong><p>{copy.disclaimer}</p><span>© {new Date().getFullYear()}</span></div></footer>
<script type="application/json" id="jj-map-data" set:html={JSON.stringify(mapData).replace(/</g,'\\u003c')}></script>
<script type="application/json" id="jj-i18n-data" set:html={JSON.stringify({found:copy.found,mapMissing:copy.mapMissing,mapFailed:copy.mapFailed,noCoords:copy.noCoords,price:copy.price,detail:copy.detail})}></script>
<script src="/js/joyjoy-marketplace.js" defer></script>
<script src="/js/joyjoy-unslop-stage1.js" defer></script>
<script src="/js/joyjoy-maplibre.js" defer></script>
