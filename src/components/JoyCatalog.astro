{projects&&<script type="application/json" id="jj-project-fx-data" set:html={JSON.stringify(sourceListings.filter(isPublishedProject).map(x=>({slug:x.slug,investment:x.investment}))).replace(/</g,'\\u003c')}></script>}
{projects&&<script src="/js/joyjoy-project-fx.js" type="module"></script>}
<script type="application/json" id="jj-map-data" set:html={JSON.stringify(mapData).replace(/</g,'\\u003c')}></script>
