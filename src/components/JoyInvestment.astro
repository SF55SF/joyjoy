---
// JOYJOY_CALCULATOR_MARKUP_V1
import {investmentCopy} from '../../public/js/joyjoy-investment-copy.js';
import {investmentFields,hasPublishedInvestment,calculateInvestment,investmentDefaults} from '../../public/js/joyjoy-investment-model.js';
const {listing,lang='ru'}=Astro.props;
const c=investmentCopy[lang];
const published=hasPublishedInvestment(listing);
const model=published?{...listing.investment,...Object.fromEntries(Object.entries(investmentDefaults).map(([key,value])=>[key,listing.investment[key]??value]))}:{currency:'USD',purchasePrice:listing.priceUsd,lettableArea:null,transactionCosts:null,fitOutCosts:null,otherCosts:null,monthlyRent:null,occupancy:null,annualExpenses:null,...investmentDefaults};
const result=published?calculateInvestment(model):null;
const money=n=>new Intl.NumberFormat(lang==='ru'?'ru-RU':lang==='uz'?'uz-UZ':'en-US',{style:'currency',currency:'USD',maximumFractionDigits:0}).format(n);
---
<section class="jj-investment" data-investment data-lang={lang} data-published={String(published)} aria-labelledby="investment-heading">
 <header><p class="jj-investment-kicker">{published?c.published:c.personal}</p><h2 id="investment-heading">{c.title}</h2><p>{published?c.estimate:c.unavailable}</p></header>
 {published&&<dl class="jj-model-source"><div><dt>{c.source}</dt><dd>{c[model.rentBasis]}</dd></div><div><dt>{c.asOf}</dt><dd><time datetime={model.asOf}>{model.asOf}</time></dd></div><div><dt>{lang==='ru'?'Источник и условия':lang==='en'?'Source and terms':'Manba va shartlar'}</dt><dd>{model.sourceNote}</dd></div></dl>}
 <form class="jj-investment-inputs" data-investment-form>
 <label><span>{lang==='ru'?'Валюта аренды':lang==='en'?'Rent currency':'Ijara valyutasi'}</span><select name="rentCurrency"><option value="USD" selected={(model.rentCurrency??'USD')==='USD'}>USD</option><option value="UZS" selected={model.rentCurrency==='UZS'}>UZS</option></select></label><label><span>USD/UZS · CBU</span><input name="usdUzs" type="number" step="any" readonly value={model.usdUzs??''}/></label><label><span>{lang==='ru'?'Средняя годовая девальвация UZS за последние 5 лет, % в год':lang==='en'?'Average annual UZS depreciation over the last 5 years, % per year':'So‘nggi 5 yildagi o‘rtacha yillik UZS devalvatsiyasi, %/yil'}</span><input name="uzsDevaluation" type="number" step="any" readonly value={model.uzsDevaluation??''}/></label>{investmentFields.map(key=><label><span>{c[key]}</span><input name={key} type="number" inputmode="decimal" min={key==='holdYears'?'1':['purchasePrice','lettableArea','exitCapRate'].includes(key)?'0.01':'0'} max={['occupancy','exitCapRate','annualRentGrowth'].includes(key)?'100':key==='holdYears'?'40':'1000000000000'} step={key==='holdYears'?'1':'any'} value={model[key]??''} required /></label>)}
 <button type="reset" class="jj-model-reset">{c.reset}</button>
 </form>
 <p class="jj-model-status" data-model-status role="status">{c.missing}</p>
 <dl class="jj-investment-results" aria-live="polite" aria-atomic="true">{['irrPercent','totalInvestment','annualRent','annualNet','salePrice'].map(key=><div><dt>{c[key]}</dt><dd data-result={key}>—</dd></div>)}</dl>
 {published&&result?.ok&&<section class="jj-investment-presentation" aria-labelledby="investment-forecast-heading"><h3 id="investment-forecast-heading">{lang==='ru'?'Прогноз денежных потоков':lang==='en'?'Projected cash flows':'Pul oqimlari prognozi'}</h3><div class="jj-investment-table-scroll" tabindex="0" role="region" aria-label={lang==='ru'?'Таблица денежных потоков':lang==='en'?'Cash flow table':'Pul oqimlari jadvali'}><table class="jj-investment-table"><thead><tr><th scope="col">{lang==='ru'?'Год':lang==='en'?'Year':'Yil'}</th><th scope="col">NOI, $</th><th scope="col">{lang==='ru'?'Продажа, $':lang==='en'?'Sale, $':'Sotish, $'}</th><th scope="col">{lang==='ru'?'Поток, $':lang==='en'?'Cash flow, $':'Pul oqimi, $'}</th></tr></thead><tbody data-investment-schedule><tr><th scope="row">0</th><td>—</td><td>—</td><td>{money(-result.totalInvestment)}</td></tr>{result.schedule.map(row=><tr><th scope="row">{row.year}</th><td>{money(row.noi)}</td><td>{row.sale?money(row.sale):'—'}</td><td>{money(row.cashFlow)}</td></tr>)}</tbody></table></div><p class="jj-model-note">{lang==='ru'?'Продажа: NOI следующего года / Exit Cap Rate. IRR рассчитан без кредита.':lang==='en'?'Exit value: next-year NOI / exit cap rate. Unlevered IRR.':'Sotish: keyingi yil NOI / exit cap rate. Kreditsiz IRR.'}</p></section>}
 <p class="jj-model-note">{lang==='ru'?'Модель включает капитальные вложения, индексируемую аренду и продажу в конце срока. Налоги учитываются в заданных расходах.':lang==='en'?'The model includes initial CAPEX, rent growth and sale at the end of the holding period. Taxes are included only if entered in expenses.':'Model dastlabki CAPEX, ijara o‘sishi va muddat oxiridagi sotishni hisobga oladi.'}</p>
 <script type="application/json" data-investment-defaults set:html={JSON.stringify(model).replaceAll('<',String.fromCharCode(92)+'u003c')}></script>
</section>
<style>
.jj-investment-presentation{margin:28px 0;padding:24px;border:1px solid #e9e9e9;border-radius:18px;background:#fff}.jj-investment-presentation h3{font-size:1.35rem;margin:0 0 22px}.jj-investment-kpis{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px;margin-bottom:20px}.jj-investment-kpis div{background:#f7f7f7;border-radius:12px;padding:16px;display:flex;flex-direction:column;gap:8px}.jj-investment-kpis span{font-size:12px;color:#666}.jj-investment-kpis strong{font-size:clamp(16px,2vw,24px);font-weight:750;overflow-wrap:anywhere}.jj-investment-kpis div:first-child strong{color:#D90016}.jj-investment-table-scroll{overflow-x:auto}.jj-investment-table{border-collapse:collapse;width:100%;min-width:480px;font-variant-numeric:tabular-nums}.jj-investment-table th,.jj-investment-table td{padding:12px;text-align:right;border-bottom:1px solid #ececec}.jj-investment-table th:first-child{text-align:left}.jj-investment-table thead th{color:#666;font-size:12px}@media(max-width:640px){.jj-investment-presentation{padding:14px}.jj-investment-kpis{grid-template-columns:1fr}.jj-investment-kpis div{padding:12px}}
</style>
<script src="/js/joyjoy-investment.js" type="module"></script>
