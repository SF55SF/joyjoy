---
// JOYJOY_MARKETPLACE_LAYOUT_V1
import '../styles/joyjoy.css';
const lang = Astro.props.lang ?? 'ru';
const title = Astro.props.title ?? 'JoyJoy — коммерческая недвижимость';
const description = Astro.props.description ?? 'Каталог коммерческой недвижимости: офисы, торговые и складские помещения.';
const origin = Astro.site?.origin;
const canonical = origin ? new URL(Astro.url.pathname, origin).toString() : undefined;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex,follow" />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta name="theme-color" content="#123b38" />
  </head>
  <body><slot /></body>
</html>
