---
// JOYJOY_MAINTENANCE_LAYOUT_V1
// Keep the copied Trilliant pages hidden until JoyJoy content is ready.
const lang = Astro.props.lang ?? 'ru';
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex,nofollow" />
    <title>JoyJoy — сайт в разработке</title>
    <style>
      html, body { margin: 0; min-height: 100%; background: #000; }
      body { min-height: 100vh; display: grid; place-items: center; color: #fff; font-family: Arial, Helvetica, sans-serif; }
      main { padding: 24px; text-align: center; }
      h1 { margin: 0 0 12px; font-size: clamp(38px, 7vw, 72px); }
      p { margin: 0; font-size: clamp(18px, 3vw, 28px); }
    </style>
  </head>
  <body>
    <main>
      <h1>JoyJoy</h1>
      <p>Сайт в разработке</p>
    </main>
  </body>
</html>
