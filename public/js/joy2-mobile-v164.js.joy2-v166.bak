/* JOY2_V164_ORIGINAL_CARDS: existing card nodes only; no fake content. */
(()=>{function start(){const hero=document.querySelector('main.jj-ref-home>.jj-ref-hero'),grid=document.getElementById('jj-results'),sort=document.getElementById('jj-sort');if(!hero||!grid||!sort||document.getElementById('joy2-mobile-tools-v164'))return;
const lang=document.documentElement.lang||'ru',t=lang==='en'?['Investment only','Sort']:lang==='uz'?['Faqat investitsiya','Saralash']:['Инвестиционные','Сортировка'];
const bar=document.createElement('div');bar.id='joy2-mobile-tools-v164';const lab=document.createElement('label'),check=document.createElement('input');check.type='checkbox';lab.append(check,document.createTextNode(t[0]));const sel=document.createElement('select');sel.setAttribute('aria-label',t[1]);for(const o of sort.options)sel.append(o.cloneNode(true));sel.value=sort.value;sel.addEventListener('change',()=>{sort.value=sel.value;sort.dispatchEvent(new Event('change',{bubbles:true}))});sort.addEventListener('change',()=>sel.value=sort.value);
let native=()=>document.getElementById('jj-investment-only')||document.querySelector('.jj-rf-invest-input');check.addEventListener('change',()=>{const n=native();if(n){n.checked=check.checked;n.dispatchEvent(new Event('change',{bubbles:true}))}else{const u=new URL(location.href);if(check.checked)u.searchParams.set('investment','1');else u.searchParams.delete('investment');location.assign(u.href)}});bar.append(lab,sel);hero.after(bar);
const mq=matchMedia('(max-width:900px)'),base=390;let running=false;
function update(){running=false;const stage=hero.querySelector('.jj-hero-right-v2.jj-hero-stage-v6'),cards=[...grid.querySelectorAll(':scope>.jj-property-card')];check.checked=!!native()?.checked;if(!mq.matches){if(stage)stage.style.removeProperty('zoom');for(const c of cards)c.style.removeProperty('zoom');return;}
if(stage){const w=hero.clientWidth;stage.style.setProperty('zoom',String(Math.min(1,w/base)),'important');let h=0;for(const slide of stage.querySelectorAll('.jj-hero-slide-v6')){const c=slide.querySelector('.jj-property-card');if(c){c.style.setProperty('width',base+'px','important');c.style.setProperty('min-width',base+'px','important');h=Math.max(h,c.scrollHeight)}}const v=stage.querySelector('.jj-hero-rotator-v6');if(v&&h>100)v.style.setProperty('height',Math.ceil(h)+'px','important')}
const avail=grid.clientWidth,gap=12,z=Math.min(1,Math.max(.12,(avail-gap)/(2*base)));for(const c of cards){c.style.setProperty('width',base+'px','important');c.style.setProperty('min-width',base+'px','important');c.style.setProperty('zoom',String(z),'important');for(const p of ['v151','v152','v153'])c.removeAttribute('data-joy2-paged-'+p)}for(const p of document.querySelectorAll('.joy2-mobile-pagination-v151,.joy2-mobile-pagination-v152,.joy2-mobile-pagination-v153'))p.hidden=true}
function schedule(){if(!running){running=true;requestAnimationFrame(update)}}window.addEventListener('resize',schedule,{passive:true});window.addEventListener('pageshow',schedule);window.addEventListener('joyjoy:filter-change',()=>requestAnimationFrame(schedule));if(typeof ResizeObserver!=='undefined'){const ro=new ResizeObserver(schedule);ro.observe(grid)}schedule();requestAnimationFrame(schedule)}if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',start,{once:true});else start()})();
