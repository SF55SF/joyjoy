/* JOY2_V208_FINANCE_FOOTER_TWO_SIZES_START */
/* Only the lower part of the mobile investment calculator: two font sizes, 16px and 13px. */
@media screen and (max-width:780px){
  /* Footer section headings: former 20px -> 16px (-20%). */
