@media(max-width:999px){.jj-ref-home>.jj-ref-hero.jj-hero-layout-v2{display:flex!important;flex-direction:column!important;min-height:calc(100svh - 98px)!important;justify-content:center!important;gap:28px!important;}.jj-ref-home .jj-hero-right-v2{width:min(100%,390px)!important;padding:12px!important;border-radius:26px!important;background:rgba(255,255,255,.43)!important;box-shadow:0 14px 36px rgba(0,0,0,.12)!important;}.jj-ref-home .jj-hero-left-v2>.jj-ref-actions{justify-content:center!important;}}
@media(prefers-reduced-motion:reduce){.jj-ref-home .jj-hero-slide-v2{transition:none!important;}}
/* JOY2 HERO REPAIR V4 END */

/* Align right edge of card to the hero container and cast shadow on the card itself. */
@media(min-width:1000px){
 body .jj-ref-home>.jj-ref-hero.jj-hero-layout-v2 .jj-hero-right-v2.jj-hero-stage-v6{
   margin-right:0!important;
   justify-self:end!important;
   align-self:center!important;
 }
}
body .jj-ref-home .jj-hero-right-v2.jj-hero-stage-v6{overflow:visible!important;}
body .jj-ref-home .jj-hero-rotator-v6{overflow:visible!important;}
body .jj-ref-home .jj-hero-slide-v6>.jj-property-card{
 box-shadow:0 22px 42px rgba(16,18,25,.23),0 5px 12px rgba(16,18,25,.10)!important;
 border-radius:22px!important;
}

/* JOY2 HERO BUTTON & CARD V10 START */
/* Header remains at top of the document. */
body:has(>main.jj-ref-home)>.jj-ref-header{position:relative!important;top:0!important;margin-top:0!important;}
/* Replace competing button declarations with authoritative final colors. */
html body main.jj-ref-home .jj-hero-left-v2 .jj-ref-actions>a.jj-ref-cta[href*="investment=1"]{
  background:linear-gradient(#fff,#f9f9fb)!important;background-image:linear-gradient(#fff,#f9f9fb)!important;
  color:#101112!important;box-shadow:0 12px 19px #737b8c2e,0 2px 3px #fff9!important;
}
html body main.jj-ref-home .jj-hero-left-v2 .jj-ref-actions>a.jj-ref-cta[href*="investment=1"]>span.joy2-hero-cta-label{color:#101112!important;}
html body main.jj-ref-home .jj-hero-left-v2 .jj-ref-actions>a.jj-ref-cta[href*="investment=1"] svg.joy2-cta-real-arrow,
html body main.jj-ref-home .jj-hero-left-v2 .jj-ref-actions>a.jj-ref-cta[href*="investment=1"] svg.joy2-cta-real-arrow path{color:#b8ff28!important;stroke:#b8ff28!important;}
html body main.jj-ref-home .jj-hero-left-v2 .jj-ref-actions>a.jj-ref-cta[href="#catalog"]{background:linear-gradient(#292929,#111)!important;background-image:linear-gradient(#292929,#111)!important;color:#fff!important;}
html body main.jj-ref-home .jj-hero-left-v2 .jj-ref-actions>a.jj-ref-cta[href="#catalog"]>span.joy2-hero-cta-label{color:#fff!important;}
html body main.jj-ref-home .jj-hero-left-v2 .jj-ref-actions>a.jj-ref-cta[href="#catalog"] svg.joy2-cta-real-arrow,
html body main.jj-ref-home .jj-hero-left-v2 .jj-ref-actions>a.jj-ref-cta[href="#catalog"] svg.joy2-cta-real-arrow path{color:#fff!important;stroke:#fff!important;}
/* No outer card background or frame: shadow follows the real catalog card only. */
html body main.jj-ref-home .jj-hero-right-v2.jj-hero-stage-v6{padding:0!important;border:0!important;background:none!important;background-image:none!important;box-shadow:none!important;backdrop-filter:none!important;-webkit-backdrop-filter:none!important;overflow:visible!important;}
html body main.jj-ref-home .jj-hero-rotator-v6{overflow:visible!important;}
/* JOY2 HERO BUTTON & CARD V10 END */
/* JOY2_HERO_CARD_CENTER_V12_START */
/* Red guide in approved 1728px screenshot sits 94px left of actual card center. */
@media (min-width: 1000px) {
  html body main.jj-ref-home > .jj-ref-hero .jj-hero-right-v2.jj-hero-stage-v6 {
    transform: translateX(-160px) !important;
  }
}
@media (max-width: 999px) {
  html body main.jj-ref-home > .jj-ref-hero .jj-hero-right-v2.jj-hero-stage-v6 {
    transform: none !important;
  }
}
/* JOY2_HERO_CARD_CENTER_V12_END */

/* JOY2_CATALOG_COMPACT_V13_START */
/* Compact catalog layout only; keep hero, buttons and card typography unchanged. */
body main.jj-ref-home #catalog.jj-filter-shell {
  padding-top:22px!important;
  padding-bottom:8px!important;
}
body main.jj-ref-home #catalog .jj-catalog-head {
  margin-bottom:14px!important;
}
body main.jj-ref-home #catalog .jj-catalog-head h2 {
  font-size:clamp(24px,2.8vw,36.8px)!important;
  line-height:1.12!important;
  margin-bottom:6px!important;
}
body main.jj-ref-home #catalog .jj-catalog-head p {
  margin-bottom:0!important;
}
body main.jj-ref-home #catalog .jj-filter-form {
  padding:12px!important;
}
body main.jj-ref-home #catalog #jj-filters>.jj-rf-top {
  gap:10px!important;
}
body main.jj-ref-home #catalog-results.jj-listing-section {
  padding-top:10px!important;
  padding-bottom:44px!important;
}
body main.jj-ref-home #catalog-results .jj-catalog-toolbar {
  margin-bottom:12px!important;
  gap:12px!important;
}
@media(max-width:700px){
  body main.jj-ref-home #catalog.jj-filter-shell{padding-top:16px!important;padding-bottom:6px!important;}
  body main.jj-ref-home #catalog .jj-catalog-head{margin-bottom:12px!important;}
  body main.jj-ref-home #catalog .jj-catalog-head h2{font-size:24.8px!important;}
  body main.jj-ref-home #catalog .jj-filter-form{padding:10px!important;}
  body main.jj-ref-home #catalog-results.jj-listing-section{padding-top:8px!important;padding-bottom:32px!important;}
}
/* JOY2_CATALOG_COMPACT_V13_END */

/* JOY2_COMPACT_FOOTER_FILTERS_V15_START */
/* Search is no longer shown, even when the filter-enhancement script moves it. */
body .jj-ref-home #catalog #jj-filters .jj-field-search,
body .jj-ref-home #catalog #jj-filters #jj-advanced-filters .jj-field-search {
  display:none!important;
  position:static!important;
  height:0!important;
  min-height:0!important;
  padding:0!important;
  margin:0!important;
  border:0!important;
}
/* Compact extended filters: area | budget | status + price-on-request. */
@media (min-width:900px) {
  body .jj-ref-home #catalog #jj-filters > #jj-advanced-filters:not([hidden]) {
    display:grid!important;
    grid-template-columns:repeat(3,minmax(0,1fr))!important;
    align-items:start!important;
    gap:12px!important;
    padding:12px 14px!important;
    margin-top:8px!important;
  }
  body .jj-ref-home #catalog #jj-advanced-filters > .jj-filter-options {
    display:flex!important;
    flex-direction:column!important;
    gap:7px!important;
    min-width:0!important;
  }
}
body .jj-ref-home #catalog #jj-filters > #jj-advanced-filters {
  padding:12px 14px!important;
  gap:12px!important;
  margin-top:8px!important;
  border-radius:16px!important;
}
body .jj-ref-home #catalog #jj-advanced-filters .jj-range {
  min-width:0!important;
  margin:0!important;
  padding:0!important;
  border:0!important;
}
body .jj-ref-home #catalog #jj-advanced-filters .jj-range legend,
body .jj-ref-home #catalog #jj-advanced-filters .jj-field > span {
  font-size:13px!important;
  line-height:18px!important;
  margin:0 0 6px!important;
}
body .jj-ref-home #catalog #jj-advanced-filters .jj-range > div {
  display:grid!important;
  grid-template-columns:repeat(2,minmax(0,1fr))!important;
  gap:0!important;
}
body .jj-ref-home #catalog #jj-advanced-filters .jj-range label,
body .jj-ref-home #catalog #jj-advanced-filters .jj-filter-options .jj-field {
  min-height:56px!important;
  padding:8px 11px!important;
  border-radius:12px!important;
  box-sizing:border-box!important;
  margin:0!important;
}
body .jj-ref-home #catalog #jj-advanced-filters .jj-range :is(input,select),
body .jj-ref-home #catalog #jj-advanced-filters .jj-filter-options :is(input,select) {
  font-size:14px!important;
  line-height:20px!important;
}
body .jj-ref-home #catalog #jj-advanced-filters .jj-price-unknown {
  display:flex!important;
  align-items:center!important;
  gap:8px!important;
  margin:0!important;
  font-size:13px!important;
  line-height:19px!important;
}
@media (max-width:899px) {
  body .jj-ref-home #catalog #jj-filters > #jj-advanced-filters:not([hidden]) {
    display:grid!important;
    grid-template-columns:repeat(2,minmax(0,1fr))!important;
  }
  body .jj-ref-home #catalog #jj-advanced-filters > .jj-filter-options {
    grid-column:1/-1!important;
  }
}
@media (max-width:600px) {
  body .jj-ref-home #catalog #jj-filters > #jj-advanced-filters:not([hidden]) {
    grid-template-columns:minmax(0,1fr)!important;
    padding:10px!important;
  }
  body .jj-ref-home #catalog #jj-advanced-filters > .jj-filter-options {grid-column:1!important;}
}
/* JOY2_COMPACT_FOOTER_FILTERS_V15_END */

/* JOY2 FLOATING HERO CARD SHADOW V17 START */
/* Four-layer shadow from v16: offsets, blur and opacity increased by 50%. */
body:has(main.jj-ref-home) .jj-ref-home .jj-hero-right-v2.jj-hero-stage-v6,
body:has(main.jj-ref-home) .jj-ref-home .jj-hero-rotator-v6,
body:has(main.jj-ref-home) .jj-ref-home .jj-hero-slide-v6{
  overflow:visible!important;
}
body:has(main.jj-ref-home) .jj-ref-home .jj-hero-slide-v6 > .jj-property-card{
  box-shadow:
    0 21px 33px rgba(17,20,30,.27),
    0 57px 97.5px rgba(17,20,30,.345),
    0 111px 172.5px rgba(17,20,30,.315),
    0 165px 232.5px rgba(17,20,30,.18)!important;
  filter:none!important;
}
/* JOY2 FLOATING HERO CARD SHADOW V17 END */

/* JOY2_DETAIL_COMPACT_V18_START */
/* JOY2_DETAIL_BACK_TIDY_V129 */
/* Detail page only: remove unused vertical space while retaining the existing structure. */
.jj-detail-sitebar .jj-sitebar-in{gap:18px!important;}
.jj-detail-sitebar .jj-detail-back-nav{display:inline-flex!important;align-items:center!important;justify-content:center!important;vertical-align:middle!important;gap:9px!important;flex:0 0 auto!important;align-self:center!important;min-height:46px!important;height:46px!important;box-sizing:border-box!important;margin:0!important;padding:0 17px!important;border:1px solid #dce1e5!important;border-radius:12px!important;background:#fff!important;color:#121417!important;font:600 15px/1 Arial,Helvetica,sans-serif!important;letter-spacing:0!important;white-space:nowrap!important;box-shadow:0 3px 12px rgba(13,22,30,.055)!important;text-decoration:none!important;transition:background .15s ease,border-color .15s ease,box-shadow .15s ease!important;}
.jj-detail-sitebar .jj-detail-back-nav:hover{background:#f5f7f8!important;border-color:#cdd3d8!important;box-shadow:0 4px 13px rgba(13,22,30,.09)!important;}
.jj-detail-sitebar .jj-detail-back-nav svg{display:block!important;width:18px!important;height:18px!important;flex:0 0 18px!important;stroke-width:2.2!important;}
.jj-detail.jj-shell{padding-top:14px!important;padding-bottom:22px!important;}
.jj-detail>.jj-crumb{margin:0 0 11px!important;font-size:12px!important;line-height:1.3!important;}
.jj-detail .jj-detail-heading{margin:0 0 14px!important;gap:16px!important;}
.jj-detail .jj-detail-heading h1{font-size:clamp(30px,2.7vw,44px)!important;margin:0 0 4px!important;line-height:1.1!important;}
.jj-detail .jj-detail-heading p{font-size:13px!important;line-height:1.4!important;}
.jj-detail .jj-detail-price-top{gap:3px!important;}
.jj-detail .jj-detail-price-top strong{font-size:clamp(23px,2.4vw,37px)!important;}
.jj-detail .jj-photo-layout{height:clamp(230px,27vw,395px)!important;margin-bottom:14px!important;}
.jj-detail .jj-detail-units-wide{margin-bottom:14px!important;}
.jj-detail .jj-detail-units-wide .jj-units{padding:14px 17px 12px!important;}
.jj-detail .jj-detail-units-wide .jj-units-heading{margin-bottom:7px!important;}
.jj-detail .jj-detail-units-wide .jj-units-intro{margin:0 0 10px!important;}
.jj-detail .jj-detail-columns{gap:16px!important;margin-bottom:14px!important;align-items:start!important;}
.jj-detail .jj-detail-main{padding:16px 19px!important;}
.jj-detail .jj-detail-main>section{margin-bottom:12px!important;padding-bottom:12px!important;}
.jj-detail .jj-detail-main h2{font-size:clamp(18px,1.45vw,23px)!important;margin-bottom:7px!important;}
.jj-detail .jj-detail-main p{font-size:13px!important;line-height:1.48!important;}
.jj-detail .jj-detail-sidebar{padding:16px 19px!important;}
.jj-detail .jj-detail-finance{padding-bottom:10px!important;}
.jj-detail .jj-detail-finance strong{font-size:clamp(22px,1.9vw,29px)!important;}
.jj-detail .jj-detail-metrics>div{padding:9px 0!important;}
.jj-detail .jj-detail-contact h3{margin:10px 0 5px!important;}
.jj-detail .jj-detail-location-wide{margin-bottom:12px!important;padding:14px 17px!important;}
.jj-detail .jj-detail-location-wide h2{font-size:21px!important;margin-bottom:7px!important;}
.jj-detail .jj-detail-location-wide .jj-detail-map{height:clamp(145px,15vw,200px)!important;}
.jj-detail-bottom .jj-shell{padding-top:15px!important;padding-bottom:15px!important;}
/* Non-investment rows stay visible as information, without an expandable investment panel. */
.jj-detail .jj-unit-option:disabled{opacity:1!important;cursor:default!important;filter:none!important;}
.jj-detail .jj-unit-option:disabled:hover{transform:none!important;}
/* Investment drawer: 70% typography, proportionately tightened geometry. */
.jj-detail .jj-unit-finance-drawer{padding:21px!important;margin:8px 0 0!important;border-radius:18px!important;}
.jj-detail .jj-unit-details:has(.jj-unit-finance-drawer){padding:8px!important;margin:8px 0 12px!important;}
.jj-detail .jj-rinv-header{gap:12px!important;margin-bottom:22px!important;}
.jj-detail .jj-rinv-header h3{font-size:clamp(16px,1.4vw,22.4px)!important;margin-top:12px!important;line-height:1.2!important;}
.jj-detail .jj-rinv-header .jj-unit-finance-flag{font-size:10.5px!important;padding:6px 11px!important;min-height:29px!important;}
.jj-detail .jj-rinv-close{width:32px!important;height:32px!important;font-size:18px!important;}
.jj-detail .jj-rinv-kpis{gap:12px!important;margin-bottom:21px!important;}
.jj-detail .jj-rinv-kpis>div{min-height:79px!important;padding:12px 15px!important;border-radius:11px!important;}
.jj-detail .jj-rinv-kpis small{font-size:10.5px!important;margin-bottom:8px!important;line-height:1.3!important;}
.jj-detail .jj-rinv-kpis strong{font-size:clamp(14px,1.58vw,23.8px)!important;line-height:1.22!important;}
.jj-detail .jj-unit-finance-drawer>h4{font-size:16.1px!important;margin:20px 0 12px!important;}
.jj-detail .jj-rinv-inputs{gap:9px 11px!important;margin-bottom:17px!important;}
.jj-detail .jj-rinv-inputs>div{min-height:53px!important;padding:9px 14px!important;border-radius:9px!important;}
.jj-detail .jj-rinv-inputs dt{font-size:9.8px!important;line-height:1.4!important;}
.jj-detail .jj-rinv-inputs dd{font-size:13.3px!important;margin-top:4px!important;}
.jj-detail .jj-rinv-flow-strip{gap:5px!important;margin-bottom:24px!important;}
.jj-detail .jj-rinv-flow-strip>.jj-rinv-year{min-height:109px!important;padding:10px 4px 8px!important;border-radius:10px!important;gap:3px!important;}
.jj-detail .jj-rinv-year-label{font-size:9.1px!important;min-height:14px!important;}
.jj-detail .jj-rinv-year strong{font-size:clamp(12px,1.2vw,17.5px)!important;margin-top:3px!important;}
.jj-detail .jj-rinv-year .jj-rinv-thousands,.jj-detail .jj-rinv-year small{font-size:8.4px!important;line-height:1.3!important;margin-top:4px!important;}
.jj-detail .jj-rinv-footer{margin-top:17px!important;padding-top:14px!important;gap:15px!important;}
.jj-detail .jj-rinv-footer .jj-rinv-tax-assumptions{font-size:9.1px!important;}
.jj-detail .jj-rinv-footer .jj-rinv-disclaimer{font-size:8.4px!important;}
.jj-detail .jj-rinv-pdf{min-width:139px!important;min-height:35px!important;padding:7px 12px!important;font-size:9.8px!important;border-radius:9px!important;gap:8px!important;}
.jj-detail .jj-rinv-pdf svg{width:14px!important;height:14px!important;}
@media(max-width:760px){
 .jj-detail-sitebar .jj-sitebar-in{gap:7px!important;}
 .jj-detail-sitebar .jj-detail-back-nav{display:inline-flex!important;align-items:center!important;justify-content:center!important;flex:0 0 auto!important;align-self:center!important;gap:7px!important;min-height:40px!important;height:40px!important;box-sizing:border-box!important;margin:0!important;padding:0 12px!important;border:1px solid #dce1e5!important;border-radius:11px!important;background:#fff!important;color:#121417!important;font:600 13px/1 Arial,Helvetica,sans-serif!important;letter-spacing:0!important;white-space:nowrap!important;box-shadow:0 3px 12px rgba(13,22,30,.055)!important;text-decoration:none!important;}
 .jj-detail-sitebar .jj-detail-back-nav svg{display:block!important;width:16px!important;height:16px!important;flex:0 0 16px!important;stroke-width:2.2!important;}
 .jj-detail.jj-shell{padding-top:10px!important;}
 .jj-detail .jj-photo-layout{height:245px!important;margin-bottom:12px!important;}
 .jj-detail .jj-detail-heading{margin-bottom:12px!important;}
 .jj-detail .jj-detail-columns{grid-template-columns:minmax(0,1fr)!important;gap:12px!important;}
 .jj-detail .jj-rinv-kpis{grid-template-columns:repeat(2,minmax(0,1fr))!important;gap:8px!important;}
 .jj-detail .jj-rinv-inputs{grid-template-columns:repeat(2,minmax(0,1fr))!important;}
 .jj-detail .jj-rinv-flow-strip{grid-template-columns:repeat(2,minmax(0,1fr))!important;}
}
@media print{.jj-detail .jj-unit-finance-drawer{font-size:inherit!important;}}
/* JOY2_DETAIL_COMPACT_V18_END */

/* JOY2 FOOTER DISCLAIMER V19 START */
.jj-bottom p.jj-footer-disclaimer{font-size:11.2px!important;line-height:1.5!important;font-weight:400!important;max-width:900px!important;}
/* JOY2 FOOTER DISCLAIMER V19 END */

/* JOY2_INVESTMENT_READABLE_V20_START */
/* Light compact typography. Only the opened investment drawer on property detail pages. */
.jj-detail .jj-units .jj-unit-finance-drawer{padding:19px 22px!important;border-radius:18px!important;}
.jj-detail .jj-units .jj-rinv-header{margin-bottom:16px!important;gap:12px!important;align-items:center!important;}
.jj-detail .jj-units .jj-rinv-header h3{font-size:clamp(18px,1.4vw,22px)!important;line-height:1.3!important;letter-spacing:-.025em!important;font-weight:700!important;margin:9px 0 0!important;}
.jj-detail .jj-units .jj-rinv-header .jj-unit-finance-flag{font-size:11px!important;font-weight:650!important;padding:6px 10px!important;min-height:26px!important;border-radius:8px!important;}
.jj-detail .jj-units .jj-rinv-close{width:34px!important;height:34px!important;font-size:19px!important;border-radius:9px!important;}
.jj-detail .jj-units .jj-rinv-kpis{gap:10px!important;margin-bottom:18px!important;}
.jj-detail .jj-units .jj-rinv-kpis>div{min-height:83px!important;padding:13px 15px!important;border-radius:11px!important;}
.jj-detail .jj-units .jj-rinv-kpis small{font-size:12px!important;line-height:1.35!important;font-weight:400!important;margin:0 0 7px!important;}
.jj-detail .jj-units .jj-rinv-kpis strong{font-size:clamp(18px,1.65vw,25px)!important;line-height:1.2!important;font-weight:700!important;letter-spacing:-.015em!important;}
.jj-detail .jj-units .jj-unit-finance-drawer>h4{font-size:17px!important;line-height:1.35!important;font-weight:700!important;letter-spacing:-.015em!important;margin:19px 0 10px!important;}
.jj-detail .jj-units .jj-rinv-inputs{gap:9px 10px!important;margin-bottom:16px!important;}
.jj-detail .jj-units .jj-rinv-inputs>div{min-height:57px!important;padding:10px 12px!important;border-radius:9px!important;}
.jj-detail .jj-units .jj-rinv-inputs dt{font-size:11.5px!important;line-height:1.35!important;font-weight:400!important;}
.jj-detail .jj-units .jj-rinv-inputs dd{font-size:15px!important;line-height:1.3!important;font-weight:650!important;margin:4px 0 0!important;}
.jj-detail .jj-units .jj-rinv-flow-strip{gap:6px!important;margin-bottom:16px!important;}
.jj-detail .jj-units .jj-rinv-flow-strip>.jj-rinv-year{min-height:112px!important;padding:11px 5px 9px!important;border-radius:10px!important;gap:3px!important;}
.jj-detail .jj-units .jj-rinv-year-label{font-size:11px!important;line-height:1.3!important;font-weight:600!important;min-height:14px!important;}
.jj-detail .jj-units .jj-rinv-year strong{font-size:clamp(15px,1.2vw,19px)!important;line-height:1.25!important;font-weight:700!important;margin-top:3px!important;}
.jj-detail .jj-units .jj-rinv-year .jj-rinv-thousands{font-size:10px!important;font-weight:600!important;}
.jj-detail .jj-units .jj-rinv-year small{font-size:10px!important;line-height:1.35!important;margin-top:6px!important;}
.jj-detail .jj-units .jj-rinv-footer{margin-top:13px!important;padding-top:13px!important;gap:12px!important;}
.jj-detail .jj-units .jj-rinv-footer .jj-rinv-tax-assumptions{font-size:11px!important;line-height:1.45!important;}
.jj-detail .jj-units .jj-rinv-footer .jj-rinv-disclaimer{font-size:10px!important;line-height:1.45!important;}
.jj-detail .jj-units .jj-rinv-pdf{min-width:142px!important;min-height:35px!important;padding:7px 11px!important;font-size:11.5px!important;border-radius:9px!important;gap:7px!important;}
.jj-detail .jj-units .jj-rinv-pdf svg{width:15px!important;height:15px!important;}
@media(max-width:620px){
 .jj-detail .jj-units .jj-unit-finance-drawer{padding:14px!important;}
 .jj-detail .jj-units .jj-rinv-header h3{font-size:18px!important;}
 .jj-detail .jj-units .jj-rinv-kpis>div{min-height:74px!important;padding:11px!important;}
 .jj-detail .jj-units .jj-rinv-kpis strong{font-size:clamp(16px,4vw,21px)!important;}
 .jj-detail .jj-units .jj-rinv-inputs dd{font-size:14px!important;}
 .jj-detail .jj-units .jj-rinv-flow-strip>.jj-rinv-year{min-height:100px!important;}
}
/* JOY2_INVESTMENT_READABLE_V20_END */

/* JOY2 HERO CARD OUTLINE BOOST V23 START */
.jj-ref-home .jj-hero-slide-v6 > .jj-property-card,
.jj-ref-home .jj-hero-slide-v5 > .jj-property-card,
.jj-ref-home .jj-hero-slide-v2 > .jj-property-card,
.jj-ref-home .jj-hero-right-v2 .jj-property-card{
  border:4.5px solid rgba(255,255,255,1)!important;
  box-sizing:border-box!important;
}
/* JOY2 HERO CARD OUTLINE BOOST V23 END */

/* JOY2_DETAIL_CONTACT_HEADER_V24_START */
.jj-detail .jj-detail-heading .jj-detail-contact-top{flex:0 0 auto!important;display:flex!important;align-items:center!important;justify-content:flex-end!important;gap:12px!important;flex-wrap:wrap!important;max-width:48%!important;min-width:0!important;white-space:normal!important;}
.jj-detail .jj-detail-heading .jj-detail-contact-person{font:700 20px/1.3 Inter,Arial,sans-serif!important;color:#141618!important;letter-spacing:-.02em!important;}
.jj-detail .jj-detail-heading .jj-detail-contact-call{color:#151719!important;text-decoration:none!important;font:600 19px/1.3 Inter,Arial,sans-serif!important;white-space:nowrap!important;}
.jj-detail .jj-detail-heading .jj-detail-contact-call:hover{text-decoration:underline!important;}
.jj-detail .jj-detail-heading .jj-detail-contact-telegram{display:inline-flex!important;align-items:center!important;justify-content:center!important;width:43px!important;height:43px!important;flex:0 0 43px!important;background:#b6ff00!important;color:#161a10!important;border-radius:12px!important;text-decoration:none!important;box-shadow:0 3px 12px rgba(0,0,0,.09)!important;transition:transform .2s ease!important;}
.jj-detail .jj-detail-heading .jj-detail-contact-telegram:hover{transform:translateY(-2px)!important;}
.jj-detail .jj-detail-heading .jj-detail-contact-telegram svg{width:23px!important;height:23px!important;display:block!important;}
@media(max-width:760px){.jj-detail .jj-detail-heading .jj-detail-contact-top{max-width:100%!important;justify-content:flex-start!important;gap:10px!important;}.jj-detail .jj-detail-heading .jj-detail-contact-person{font-size:17px!important;}.jj-detail .jj-detail-heading .jj-detail-contact-call{font-size:16px!important;}.jj-detail .jj-detail-heading .jj-detail-contact-telegram{width:40px!important;height:40px!important;flex-basis:40px!important;}}
/* JOY2_DETAIL_CONTACT_HEADER_V24_END */

/* JOY2 DETAIL GALLERY AND INVESTMENT ATTENTION V25 START */
.jj-detail .jj-photo-layout.jj-gallery-v25{display:grid!important;grid-template-columns:minmax(0,1.85fr) minmax(260px,.78fr)!important;gap:12px!important;height:clamp(315px,29vw,495px)!important;margin:0 0 17px!important}
.jj-detail .jj-gallery-v25.is-single{grid-template-columns:minmax(0,1fr)!important}
.jj-detail .jj-gallery-v25 .jj-photo-main{height:100%!important;min-width:0!important;border-radius:16px!important;overflow:hidden!important}
.jj-detail .jj-gallery-v25 .jj-photo-main .jj-gallery-launch{display:block!important;width:100%!important;height:100%!important;padding:0!important}
.jj-detail .jj-gallery-v25 .jj-photo-main img{display:block!important;width:100%!important;height:100%!important;object-fit:cover!important}
.jj-detail .jj-gallery-v25 .jj-detail-gallery-side{display:grid!important;grid-template-rows:repeat(2,minmax(0,1fr))!important;min-width:0!important;min-height:0!important;gap:12px!important}
.jj-detail .jj-gallery-v25 .jj-detail-gallery-side button{position:relative!important;display:block!important;min-height:0!important;min-width:0!important;width:100%!important;height:100%!important;border:0!important;padding:0!important;border-radius:14px!important;overflow:hidden!important;background:#f2f3f4!important;cursor:pointer!important}
.jj-detail .jj-gallery-v25 .jj-detail-gallery-side button img{display:block!important;width:100%!important;height:100%!important;object-fit:cover!important}
.jj-detail .jj-gallery-v25 .jj-detail-gallery-side button.is-plan img{object-fit:contain!important;padding:7px!important;box-sizing:border-box!important;background:#fff!important}
.jj-detail .jj-gallery-v25 .jj-detail-gallery-side button span{position:absolute!important;left:10px!important;bottom:10px!important;padding:5px 9px!important;border-radius:7px!important;background:#ffffffec!important;color:#1a1c1d!important;font:600 12px/1.25 Inter,Arial,sans-serif!important;pointer-events:none!important;box-shadow:0 2px 8px #00000014!important}
.jj-detail .jj-gallery-v25 .jj-detail-gallery-side button:hover{outline:2px solid #b6ff00!important;outline-offset:-2px!important}
.jj-detail .jj-detail-units-wide .jj-unit-data-row{min-height:55px!important;padding:8px 14px!important;gap:12px!important}
.jj-detail .jj-detail-units-wide .jj-unit-data-row b{font-size:14px!important;line-height:1.25!important}
.jj-detail .jj-detail-units-wide .jj-unit-data-row small{font-size:11px!important;margin-top:3px!important;line-height:1.3!important}
.jj-detail .jj-detail-units-wide .jj-unit-finance-flag{padding:7px 10px!important;border-radius:8px!important;font-size:11px!important}
.jj-detail .jj-units[data-jj-invest-project="yes"] .jj-unit-data-row:has(.jj-unit-finance-flag):not(.is-active){animation:joy2-invest-invite-v25 1.12s ease-in-out 3!important}
.jj-detail .jj-units[data-jj-invest-project="yes"] .jj-unit-data-row:has(.jj-unit-finance-flag):not(.is-active) .jj-unit-finance-flag{animation:joy2-invest-flag-v25 1.12s ease-in-out 3!important}
@keyframes joy2-invest-invite-v25{0%,100%{background:#fff;box-shadow:inset 0 0 0 0 transparent}47%{background:#f1ffd4;box-shadow:inset 4px 0 0 #b6ff00}}
@keyframes joy2-invest-flag-v25{0%,100%{filter:brightness(1);transform:scale(1)}50%{filter:brightness(1.06);transform:scale(1.035)}}
.jj-detail a[href*="t.me/"]{color:#229ed9!important}
.jj-detail :is(.jj-detail-price-top,.jj-detail-heading,.jj-detail-contact) a[href*="t.me/"]{border-color:#229ed9!important}
.jj-detail :is(.jj-detail-price-top,.jj-detail-heading,.jj-detail-contact) a[href*="t.me/"] svg{color:#229ed9!important;stroke:#229ed9!important}
.jj-detail :is(.jj-detail-price-top,.jj-detail-heading,.jj-detail-contact) a[href*="t.me/"] svg path[fill]:not([fill="none"]){fill:#229ed9!important}
.jj-detail :is(.jj-detail-price-top,.jj-detail-heading,.jj-detail-contact) a[href*="t.me/"][class*="telegram"]{background:#229ed9!important;color:#fff!important}
.jj-detail :is(.jj-detail-price-top,.jj-detail-heading,.jj-detail-contact) a[href*="t.me/"][class*="telegram"] svg{color:#fff!important;stroke:#fff!important}
@media(max-width:760px){.jj-detail .jj-photo-layout.jj-gallery-v25{grid-template-columns:minmax(0,1fr)!important;height:auto!important;gap:9px!important}.jj-detail .jj-gallery-v25 .jj-photo-main{height:clamp(230px,52vw,370px)!important}.jj-detail .jj-gallery-v25 .jj-detail-gallery-side{grid-template-columns:repeat(2,minmax(0,1fr))!important;grid-template-rows:minmax(100px,150px)!important;gap:9px!important}.jj-detail .jj-gallery-v25 .jj-detail-gallery-side button{height:100%!important}.jj-detail .jj-detail-units-wide .jj-unit-data-row{padding:9px 12px!important}}
@media(prefers-reduced-motion:reduce){.jj-detail .jj-units[data-jj-invest-project="yes"] .jj-unit-data-row:has(.jj-unit-finance-flag),.jj-detail .jj-units[data-jj-invest-project="yes"] .jj-unit-data-row:has(.jj-unit-finance-flag) .jj-unit-finance-flag{animation:none!important}}
/* JOY2 DETAIL GALLERY AND INVESTMENT ATTENTION V25 END */

/* JOY2_DETAIL_LAYOUT_V27_START */
/* Do not stretch the detail sidebar to the height of the description and features. */
.jj-detail .jj-detail-columns{align-items:start!important;}
.jj-detail .jj-detail-sidebar.joy2-sidebar-location-v27{
 align-self:start!important;display:flex!important;flex-direction:column!important;
 padding:18px 19px!important;gap:0!important;min-height:0!important;height:auto!important;
}
.jj-detail .jj-detail-sidebar .jj-detail-location-wide.joy2-location-in-sidebar-v27{
 display:block!important;width:100%!important;box-sizing:border-box!important;
 padding:16px 0 0!important;margin:14px 0 0!important;
 border:0!important;border-top:1px solid #e5e9eb!important;
 border-radius:0!important;background:transparent!important;box-shadow:none!important;
}
.jj-detail .jj-detail-sidebar .jj-detail-location-wide h2{
 font-size:19px!important;line-height:1.3!important;margin:0 0 11px!important;
 font-weight:750!important;
}
.jj-detail .jj-detail-sidebar .jj-detail-location-wide .jj-detail-map{
 height:clamp(210px,18vw,300px)!important;max-height:none!important;
 width:100%!important;border-radius:12px!important;overflow:hidden!important;
}
.jj-detail .jj-detail-sidebar .jj-detail-location-wide section{margin:0!important;padding:0!important;}
.jj-detail .jj-detail-sidebar .jj-detail-location-wide p{margin:10px 0 0!important;line-height:1.45!important;font-size:12px!important;}
/* Hide recommendations before the deferred DOM simplification runs (no flash). */
.jj-detail .jj-related-grid{display:none!important;}
.jj-detail .jj-detail-main>section:has(> .jj-related-grid){display:none!important;}
@media(max-width:760px){
 .jj-detail .jj-detail-sidebar.joy2-sidebar-location-v27{padding:16px!important;}
 .jj-detail .jj-detail-sidebar .jj-detail-location-wide .jj-detail-map{height:230px!important;}
}
/* JOY2_DETAIL_LAYOUT_V27_END */

/* JOY2 DETAIL UNITS CONSISTENCY V28 START */
/* No duplicate line above the financial drawer. */
.jj-detail .jj-unit-details:has(.jj-unit-finance-drawer)>.jj-unit-summary{display:none!important}
.jj-detail .jj-unit-details:has(.jj-unit-finance-drawer){margin:3px 0 10px!important;padding:0!important;background:transparent!important;border:0!important;border-radius:0!important;box-shadow:none!important}
.jj-detail .jj-unit-details .jj-unit-finance-drawer{margin:0!important;padding:17px 19px!important;border-radius:16px!important;box-shadow:0 5px 17px #1420190a!important}
.jj-detail .jj-unit-finance-drawer .jj-rinv-header{margin-bottom:15px!important;gap:10px!important;align-items:center!important}
.jj-detail .jj-unit-finance-drawer .jj-rinv-header h3{font-size:clamp(17px,1.4vw,21px)!important;line-height:1.25!important;margin:7px 0 0!important;font-weight:730!important}
.jj-detail .jj-unit-finance-drawer .jj-rinv-header .jj-unit-finance-flag{min-height:25px!important;padding:5px 9px!important;font-size:10px!important;border-radius:7px!important}
.jj-detail .jj-unit-finance-drawer .jj-rinv-close{width:32px!important;height:32px!important;border-radius:8px!important;font-size:19px!important}
.jj-detail .jj-unit-finance-drawer .jj-rinv-kpis{gap:9px!important;margin:0 0 13px!important}
.jj-detail .jj-unit-finance-drawer .jj-rinv-kpis>div{min-height:68px!important;padding:10px 13px!important;border-radius:10px!important}
.jj-detail .jj-unit-finance-drawer .jj-rinv-kpis small{font-size:11px!important;line-height:1.3!important;margin:0 0 6px!important}
.jj-detail .jj-unit-finance-drawer .jj-rinv-kpis strong{font-size:clamp(17px,1.5vw,23px)!important;line-height:1.22!important}
.jj-detail .jj-unit-finance-drawer>h4{font-size:17px!important;line-height:1.25!important;margin:15px 0 9px!important}
.jj-detail .jj-unit-finance-drawer .jj-rinv-inputs{gap:7px 9px!important;margin:0 0 13px!important}
.jj-detail .jj-unit-finance-drawer .jj-rinv-inputs>div{min-height:49px!important;padding:8px 12px!important;border-radius:9px!important}
.jj-detail .jj-unit-finance-drawer .jj-rinv-inputs dt{font-size:11px!important;line-height:1.25!important}
.jj-detail .jj-unit-finance-drawer .jj-rinv-inputs dd{font-size:14px!important;line-height:1.25!important;margin:3px 0 0!important}
.jj-detail .jj-unit-finance-drawer .jj-rinv-flow-strip{gap:5px!important;margin:0 0 13px!important}
.jj-detail .jj-unit-finance-drawer .jj-rinv-flow-strip>.jj-rinv-year{min-height:92px!important;padding:9px 4px 8px!important;gap:2px!important;border-radius:9px!important}
.jj-detail .jj-unit-finance-drawer .jj-rinv-year-label{font-size:10px!important;min-height:0!important;line-height:1.25!important}
.jj-detail .jj-unit-finance-drawer .jj-rinv-year strong{font-size:clamp(14px,1.2vw,19px)!important;margin-top:3px!important}
.jj-detail .jj-unit-finance-drawer .jj-rinv-thousands{font-size:10px!important}
.jj-detail .jj-unit-finance-drawer .jj-rinv-year small{font-size:10px!important;line-height:1.2!important;margin-top:3px!important}
.jj-detail .jj-unit-finance-drawer .jj-rinv-footer{gap:10px!important;padding-top:10px!important;margin-top:10px!important}
.jj-detail .jj-unit-finance-drawer .jj-rinv-pdf{min-height:34px!important;min-width:145px!important;padding:7px 11px!important;font-size:11px!important;border-radius:9px!important}
.jj-detail .jj-unit-finance-drawer .jj-rinv-footer .jj-rinv-tax-assumptions{font-size:10px!important;line-height:1.4!important}
.jj-detail .jj-unit-finance-drawer .jj-rinv-footer .jj-rinv-disclaimer{font-size:10px!important;line-height:1.4!important}
/* Always invite interaction for published investments; do not animate inactive project rows. */
.jj-detail .jj-units[data-jj-invest-project="yes"] .jj-unit-data-row:has(.jj-unit-finance-flag):not(.is-active){animation:joy2-invest-invite-v28 2.2s ease-in-out infinite!important;will-change:background-color,box-shadow}
@keyframes joy2-invest-invite-v28{0%,100%{background-color:#fff;box-shadow:inset 3px 0 0 #b6ff00}50%{background-color:#edffd5;box-shadow:inset 5px 0 0 #b6ff00,0 0 0 1px #b6ff0060}}
@media(max-width:760px){.jj-detail .jj-unit-details .jj-unit-finance-drawer{padding:12px!important}.jj-detail .jj-unit-finance-drawer .jj-rinv-kpis{gap:6px!important}.jj-detail .jj-unit-finance-drawer .jj-rinv-inputs{gap:6px!important}.jj-detail .jj-unit-finance-drawer .jj-rinv-flow-strip>.jj-rinv-year{min-height:82px!important}}
@media(prefers-reduced-motion:reduce){.jj-detail .jj-units[data-jj-invest-project="yes"] .jj-unit-data-row:has(.jj-unit-finance-flag):not(.is-active){animation:none!important;will-change:auto!important;background:#f5ffe7!important}}
/* JOY2 DETAIL UNITS CONSISTENCY V28 END */

/* JOY2_DETAIL_PLAN_IN_INVESTMENT_HIDE_V29_START */
/* Floor plans remain in the gallery and admin, never inside an investment calculation drawer. */
.jj-detail .jj-unit-details:has(.jj-unit-finance-drawer) .jj-unit-plan,
.jj-detail .jj-unit-finance-drawer .jj-unit-plan{display:none!important;}
/* Keep title alignment measured against the header logo without moving the gallery or units. */
.jj-detail .jj-detail-heading>div:first-child{will-change:transform;}
/* JOY2_DETAIL_PLAN_IN_INVESTMENT_HIDE_V29_END */

/* JOY2_LOCAL_ADMIN_PREVIEW_V34_STYLE_START */
.joy2-dev-admin-link{display:inline-flex!important;align-items:center;justify-content:center;padding:9px 15px!important;border:1.5px solid #151515!important;border-radius:11px;background:#b6ff00!important;color:#111!important;font-size:14px!important;font-weight:800!important;text-decoration:none!important;white-space:nowrap;box-shadow:0 4px 12px #00000017!important;}
.joy2-dev-admin-link:hover{background:#c9ff4f!important;}
.joy2-dev-admin-banner{margin:14px 18px 0;padding:12px 16px;border:1px solid #d5dfbf;border-radius:12px;background:#f3ffe1;color:#202e10;font-size:13px;font-weight:650;}
@media(max-width:700px){.joy2-dev-admin-link{font-size:12px!important;padding:7px 9px!important}.joy2-dev-admin-banner{font-size:12px;margin:8px 12px 0}}
/* JOY2_LOCAL_ADMIN_PREVIEW_V34_STYLE_END */

/* JOY2_FINAL_HEADER_V38_START */
/* JOY2_FINAL_HEADER_V38: one static header, no JS reveal, no legacy nav. */
html body > header.jj-sitebar.jj-ref-header[data-joy2-final-header] {display:block!important;visibility:visible!important;opacity:1!important;transform:none!important;animation:none!important;transition:none!important;position:relative!important;top:auto!important;height:98px!important;background:transparent!important;border:0!important;box-shadow:none!important;z-index:5!important}
html body > header.jj-sitebar.jj-ref-header[data-joy2-final-header] > .jj-sitebar-in {display:flex!important;align-items:center!important;justify-content:space-between!important;min-height:85px!important;height:100%!important;width:calc(100% - 36px)!important;max-width:none!important;margin:0 18px!important;padding:0!important;gap:18px!important;background:transparent!important;box-shadow:none!important}
html body > header.jj-sitebar.jj-ref-header[data-joy2-final-header] .jj-wordmark {display:inline-flex!important;align-items:center!important;flex-shrink:0!important;background:transparent!important;box-shadow:none!important}
html body > header.jj-sitebar.jj-ref-header[data-joy2-final-header] .jj-brand-logo {display:block!important;width:181.2px!important;max-height:75px!important;height:auto!important;object-fit:contain!important;filter:drop-shadow(0 3px 3px rgba(0,0,0,.20)) drop-shadow(0 8px 11px rgba(0,0,0,.09))!important}
html body > header.jj-sitebar.jj-ref-header[data-joy2-final-header] .jj-primary-nav {display:none!important}
html body > header.jj-sitebar.jj-ref-header[data-joy2-final-header] .jj-sitebar-right {display:flex!important;align-items:center!important;justify-content:flex-end!important;gap:clamp(12px,1.6vw,25px)!important;margin-left:auto!important}
html body > header.jj-sitebar.jj-ref-header[data-joy2-final-header] .jj-lang {display:flex!important;align-items:center!important;gap:3px!important;padding:0!important;border:0!important}
html body > header.jj-sitebar.jj-ref-header[data-joy2-final-header] .jj-lang a {display:flex!important;align-items:center!important;justify-content:center!important;min-width:41px!important;min-height:43px!important;border:0!important;font-size:15px!important}
html body > header.jj-sitebar.jj-ref-header[data-joy2-final-header] .jj-lang a[aria-current] {background:#b6ff00!important;color:#000!important;border-radius:12px!important;text-decoration:none!important;box-shadow:none!important}
@media(max-width:700px){html body > header.jj-sitebar.jj-ref-header[data-joy2-final-header]{height:78px!important}html body > header.jj-sitebar.jj-ref-header[data-joy2-final-header] > .jj-sitebar-in{min-height:70px!important;width:calc(100% - 32px)!important;margin:0 16px!important;gap:9px!important}html body > header.jj-sitebar.jj-ref-header[data-joy2-final-header] .jj-brand-logo{width:159.6px!important;max-height:65px!important}html body > header.jj-sitebar.jj-ref-header[data-joy2-final-header] .jj-sitebar-right{gap:4px!important}html body > header.jj-sitebar.jj-ref-header[data-joy2-final-header] .jj-lang a{min-width:29px!important;min-height:34px!important;font-size:11px!important}}

/* JOY2_FINAL_HEADER_V38_END */

/* JOY2_HERO_TYPO_ONLY_V39_START */
/* Only hero heading and its two CTA buttons. */

html body .jj-ref-home .jj-ref-hero > .jj-ref-actions {
  display:flex!important;
  flex-wrap:wrap!important;
  justify-content:center!important;
  align-items:stretch!important;
  max-width:100%!important;
  min-width:0!important;
  box-sizing:border-box!important;
  gap:clamp(12px,2vw,28px)!important;
}
html body .jj-ref-home .jj-ref-hero > .jj-ref-actions > a.jj-ref-cta {
  box-sizing:border-box!important;
  min-width:0!important;
  max-width:100%!important;
  flex:0 1 auto!important;
  font-family:Arial,Helvetica,sans-serif!important;
  font-weight:700!important;
  font-size:clamp(14px,1.7vw,22px)!important;
  column-gap:clamp(10px,2vw,30px)!important;
  white-space:normal!important;
}
html body .jj-ref-home .jj-ref-hero > .jj-ref-actions > a.jj-ref-cta > span.joy2-hero-cta-label {
  font-family:Arial,Helvetica,sans-serif!important;
  font-weight:700!important;
  font-size:inherit!important;
  letter-spacing:.012em!important;
  line-height:1.22!important;
  white-space:normal!important;
  overflow-wrap:break-word!important;
  min-width:0!important;
  text-align:center!important;
}
html body .jj-ref-home .jj-ref-hero > .jj-ref-actions > a.jj-ref-cta > svg.joy2-cta-real-arrow {
  flex-shrink:0!important;
  max-width:clamp(27px,4vw,56px)!important;
}
@media(max-width:760px){
  html body .jj-ref-home .jj-ref-hero > .jj-ref-actions{width:100%!important;}
  html body .jj-ref-home .jj-ref-hero > .jj-ref-actions > a.jj-ref-cta{width:min(100%,530px)!important;flex:1 1 100%!important;justify-content:space-between!important;}
}
/* JOY2_HERO_TYPO_ONLY_V39_END */

/* JOY2_HERO_RESTORE_SIZE_V42_START */
/* Same headline sizes as before v39; restore letter clarity without changing sizes. */
html body main.jj-ref-home section.jj-ref-hero > h1 {
  letter-spacing: .022em !important;
  font-kerning: none !important;
}
html body main.jj-ref-home section.jj-ref-hero > h1 > .jj-concept-highlight {
  letter-spacing: .022em !important;
  font-kerning: none !important;
}
/* JOY2_HERO_RESTORE_SIZE_V42_END */

/* JOY2_HERO_SINGLE_BACKGROUND_V45_START */
/* Exactly one concrete-background image. No gradient/noise overlay. */
html body:has(> main.jj-ref-home)::before{content:""!important;display:block!important;position:absolute!important;inset:0 0 auto!important;width:100%!important;height:100svh!important;min-height:0!important;background-image:url('/images/joy2-concrete-ribs-hq.png')!important;background-position:center top!important;background-size:cover!important;background-repeat:no-repeat!important;opacity:1!important;pointer-events:none!important}
html body:has(> main.jj-ref-home)::after{content:none!important;display:none!important;background:none!important}
/* JOY2_HERO_SINGLE_BACKGROUND_V45_END */

/* JOY2_HERO_SPACING_V46_START */
html body main.jj-ref-home section.jj-ref-hero > h1,
html body main.jj-ref-home section.jj-ref-hero > h1 > .jj-concept-highlight,
html body main.jj-ref-home section.jj-ref-hero > h1 > span,
html body main.jj-ref-home section.jj-ref-hero > h1 > .jj-concept-highlight > span {
  letter-spacing: .03em !important;
  font-kerning: none !important;
  font-feature-settings: "kern" 0 !important;
}
/* JOY2_HERO_SPACING_V46_END */

/* JOY2_FINAL_HERO_90_V51_REMOVED_BY_V215: do not scale individual hero blocks */

/* JOY2_HERO_CLEANUP_V59_START */
/* Final hero only: tighter letter spacing, remove oversized gaps on the left, keep everything else intact. */
html body main.jj-ref-home section.jj-ref-hero > h1,
html body .jj-ref-home .jj-ref-hero > h1 {
  letter-spacing: -0.02em !important;
  font-kerning: none !important;
  margin-bottom: 22px !important;
}

html body main.jj-ref-home section.jj-ref-hero > h1 .jj-concept-highlight,
html body .jj-ref-home .jj-ref-hero > h1 .jj-concept-highlight {
  letter-spacing: -0.02em !important;
  font-kerning: none !important;
}

html body main.jj-ref-home section.jj-ref-hero > p,
html body .jj-ref-home .jj-ref-hero > p {
  margin-top: 0 !important;
  margin-bottom: 24px !important;
}

html body .jj-ref-home .jj-ref-actions,
html body main.jj-ref-home .jj-ref-actions {
  margin-top: 0 !important;
  gap: 18px !important;
}

html body .jj-ref-home .jj-ref-actions + *,
html body main.jj-ref-home .jj-ref-actions + * {
  margin-top: 0 !important;
}
/* JOY2_HERO_CLEANUP_V59_END */

/* JOY2_HERO_SPACING_V60_START */
/* Only the two lines of the finished hero heading. -2% of font size. */
html body main.jj-ref-home section.jj-ref-hero > h1,
html body main.jj-ref-home section.jj-ref-hero > h1 .jj-concept-highlight {
 letter-spacing: -0.02em !important;
 font-kerning: none !important;
}
/* JOY2_HERO_SPACING_V60_END */

/* JOY2_HERO_SPACING_MINUS3_V61_START */
/* Only headline in the final home hero. Do not change font size or layout. */
html body main.jj-ref-home section.jj-ref-hero > h1,
html body .jj-ref-home .jj-ref-hero > h1,
html body main.jj-ref-home section.jj-ref-hero > h1 .jj-concept-highlight,
html body .jj-ref-home .jj-ref-hero > h1 .jj-concept-highlight {
  letter-spacing: -0.03em !important;
}
/* JOY2_HERO_SPACING_MINUS3_V61_END */

/* JOY2_HERO_SUBTITLE_PLUS15_V62_START */
/* Only the descriptive line under the final hero heading: +15% font size. */
html body main.jj-ref-home section.jj-ref-hero > p:not(.jj-concept-kicker) {
  font-size: clamp(21.85px, 2.0125vw, 29.9px) !important;
}
@media (max-width:700px) {
  html body main.jj-ref-home section.jj-ref-hero > p:not(.jj-concept-kicker) {
    font-size:18.4px !important;
  }
}
/* JOY2_HERO_SUBTITLE_PLUS15_V62_END */

/* JOY2_HERO_BUTTONS_ARIAL_BLACK_V63_START */
/* Make the two lower hero buttons use Arial Black only. */
html body .jj-ref-home .jj-ref-actions .jj-ref-cta,
html body .jj-ref-home .jj-ref-actions .jj-ref-cta span,
html body .jj-ref-home .jj-ref-actions .joy2-hero-cta-label,
html body main.jj-ref-home .jj-ref-actions .jj-ref-cta,
html body main.jj-ref-home .jj-ref-actions .jj-ref-cta span,
html body main.jj-ref-home .jj-ref-actions .joy2-hero-cta-label {
  font-family: 'Arial Black', Arial, sans-serif !important;
  font-weight: 900 !important;
}
/* JOY2_HERO_BUTTONS_ARIAL_BLACK_V63_END */
/* JOY2_HERO_SHIFT_REAL_LEFT_V65_START */
/* Match the real elements even when a previous patch wraps them in another container. */
@media(min-width:1000px){
  html body main.jj-ref-home section.jj-ref-hero h1,
  html body main.jj-ref-home section.jj-ref-hero p,
  html body main.jj-ref-home section.jj-ref-hero .jj-ref-actions {
    translate:68px 0!important;
  }
}
/* JOY2_HERO_SHIFT_REAL_LEFT_V65_END */

/* JOY2_HERO_SUBTITLE_ALIGN_V67_START */
/* Only the final homepage headline. No font-size changes. */
html body main.jj-ref-home section.jj-ref-hero h1,
html body main.jj-ref-home section.jj-ref-hero h1 .jj-concept-highlight{
 letter-spacing:-0.04em!important;
}
/* Position remains in the natural flow; x is measured from the visible headline. */
html body main.jj-ref-home section.jj-ref-hero p.joy2-subtitle-aligned-v67{
 position:relative!important;
 left:0px!important;
}
/* JOY2_HERO_SUBTITLE_ALIGN_V67_END */

/* JOY2_HERO_CARD_POSITION_AND_ADDRESS_V76 */
/* Only the address inside the rotating HERO card; do not affect catalog cards. */
html body main.jj-ref-home .jj-hero-right-v2.jj-hero-stage-v6 .jj-property-card .jj-canonical-address{
  text-align:left!important;
  justify-content:flex-start!important;
  align-items:flex-start!important;
  width:100%!important;
}
html body main.jj-ref-home .jj-hero-right-v2.jj-hero-stage-v6 .jj-property-card .jj-canonical-address .jj-property-address{
  text-align:left!important;
  margin-left:0!important;
  margin-right:0!important;
  align-self:flex-start!important;
  width:100%!important;
}
/* JOY2_HERO_CARD_POSITION_AND_ADDRESS_V76_END */

/* JOY2_HERO_LEFT_AND_ADDRESS_V77_START */
/* 1) Remove remaining centering from the hero-card address only. */
html body main.jj-ref-home .jj-hero-right-v2.jj-hero-stage-v6 .jj-property-card .jj-canonical-address{
  display:flex!important;
  justify-content:flex-start!important;
  align-items:flex-start!important;
  text-align:left!important;
  width:100%!important;
}
html body main.jj-ref-home .jj-hero-right-v2.jj-hero-stage-v6 .jj-property-card .jj-canonical-address .jj-property-address{
  display:block!important;
  width:100%!important;
  text-align:left!important;
  margin:0!important;
  margin-left:0!important;
  margin-right:0!important;
  padding:0!important;
  align-self:flex-start!important;
}

/* 2) New hero line above "Недвижимость." with the same type family and weight. */
html body main.jj-ref-home section.jj-ref-hero .joy2-hero-pretitle-v77{
  display:block!important;
  margin:0 0 6px!important;
  font-family:Arial,Helvetica,sans-serif!important;
  font-size:clamp(40px,4.15vw,66px)!important;
  line-height:1.04!important;
  letter-spacing:-0.065em!important;
  font-weight:800!important;
  color:#101112!important;
}
@media (max-width:800px){
  html body main.jj-ref-home section.jj-ref-hero .joy2-hero-pretitle-v77{
    font-size:clamp(30px,6vw,48px)!important;
    margin:0 0 4px!important;
    line-height:1.05!important;
  }
}
/* JOY2_HERO_LEFT_AND_ADDRESS_V77_END */

/* JOY2_HERO_HEADING_ADDRESS_V78: same real H1 typography and single left edge. */
html body main.jj-ref-home .jj-ref-hero h1 [data-joy2-hero-first-line-v78]{
  display:inline!important;
  font:inherit!important;
  color:inherit!important;
  letter-spacing:inherit!important;
  margin:0!important;
  padding:0!important;
  transform:none!important;
  translate:none!important;
}
/* End JOY2_HERO_HEADING_ADDRESS_V78 */

/* JOY2_HERO_SUBTITLE_INTER_V80_START */
/* Only the exact descriptive line below Недвижимость / Инвестиции.
   v67 JS aligns the first text glyph against the headline first glyph. */
html body main.jj-ref-home section.jj-ref-hero .jj-hero-left-v2 > p.joy2-subtitle-aligned-v67,
html body main.jj-ref-home section.jj-ref-hero > p.joy2-subtitle-aligned-v67 {
  font-family: 'Inter', Arial, Helvetica, sans-serif !important;
  font-size: 22px !important;
  font-weight: 500 !important;
  font-style: normal !important;
  line-height: 1.4 !important;
  letter-spacing: -0.01em !important;
  color: #45474d !important;
  text-align: left !important;
  margin-top: 6px !important;
  margin-bottom: 24px !important;
}
@media(max-width:700px){
  html body main.jj-ref-home section.jj-ref-hero .jj-hero-left-v2 > p.joy2-subtitle-aligned-v67,
  html body main.jj-ref-home section.jj-ref-hero > p.joy2-subtitle-aligned-v67 {
    font-size: 18px !important;
    margin-top: 8px !important;
  }
}
/* JOY2_HERO_SUBTITLE_INTER_V80_END */

