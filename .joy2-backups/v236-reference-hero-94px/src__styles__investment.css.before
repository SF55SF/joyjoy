 align-items:stretch!important;justify-content:stretch!important;gap:0!important;
 position:static!important;inset:auto!important;transform:none!important;
 grid-area:auto!important;grid-column:auto!important;grid-row:auto!important;
 min-width:0!important;max-width:none!important;width:100%!important;padding:0!important;margin:0!important;
 border:0!important;background:none!important;}
.jj-detail .joy2-v93-drawer .jj-rinv-pdf{display:flex!important;justify-content:center!important;align-items:center!important;
 width:100%!important;min-height:55px!important;border:1px solid #bbc3cb!important;
