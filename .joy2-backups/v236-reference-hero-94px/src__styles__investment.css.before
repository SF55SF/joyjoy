}
html body main.jj-ref-home .jj-hero-right-v2.jj-hero-stage-v6 .jj-property-card-image img { width:100%!important;height:100%!important;object-fit:cover!important; }
html body main.jj-ref-home .jj-hero-right-v2.jj-hero-stage-v6 .jj-property-card-main {
  flex:1 1 auto!important; min-height:0!important;
  display:grid!important;
  grid-template-columns:minmax(0,1fr)!important;
  grid-template-rows:22px minmax(48px,auto) 75px minmax(51px,auto) 82px!important;
  gap:0!important; align-content:start!important; align-items:stretch!important;
  padding:18px 19px 18px!important; margin:0!important;
  font-family:Inter,Arial,Helvetica,sans-serif!important;
}
html body main.jj-ref-home .jj-hero-right-v2.jj-hero-stage-v6 .jj-property-card-main > * {min-width:0!important;box-sizing:border-box!important;}
html body main.jj-ref-home .jj-hero-right-v2.jj-hero-stage-v6 .jj-card-overline {
  grid-row:1!important; margin:0!important; padding:0!important;
  font-size:14px!important; font-weight:400!important; color:#505762!important;
  line-height:20px!important;letter-spacing:0!important;
}
html body main.jj-ref-home .jj-hero-right-v2.jj-hero-stage-v6 .jj-property-card h3 {
  grid-row:2!important; min-height:0!important; max-height:none!important;
  margin:0!important; padding:3px 0 0!important;
  font-family:Inter,Arial,Helvetica,sans-serif!important;
  font-size:20px!important; font-weight:700!important;
  line-height:1.27!important; letter-spacing:-.027em!important;
  color:#111318!important;
}
html body main.jj-ref-home .jj-hero-right-v2.jj-hero-stage-v6 .jj-match-summary {
  grid-row:3!important; display:grid!important;
  grid-template-columns:minmax(0,1fr) minmax(0,1fr)!important;
  align-items:center!important; gap:0!important;
  margin:0!important; padding:0 0 10px!important;
  border-bottom:1px solid #e1e4e8!important; border-top:0!important;
  min-height:0!important;
}
html body main.jj-ref-home .jj-hero-right-v2.jj-hero-stage-v6 .jj-match-metric {
  position:relative!important; min-width:0!important;
  display:flex!important; flex-direction:column!important;
