html body main.jj-ref-home .jj-hero-right-v2.jj-hero-stage-v6 .jj-match-metric-label{font:400 12px/1.25 Inter,Arial,sans-serif!important;color:#606773!important;}
html body main.jj-ref-home .jj-hero-right-v2.jj-hero-stage-v6 .jj-match-metric-value{font:700 18px/1.24 Inter,Arial,sans-serif!important;overflow-wrap:anywhere!important;}
