 font-family:inherit!important;font-size:clamp(20px,2vw,32px)!important;font-weight:750!important;
 letter-spacing:-.025em!important;line-height:1.1!important;margin:0!important;white-space:nowrap!important;
 overflow-wrap:normal!important;}
.jj-detail .joy2-v93-drawer .jj-rinv-kpis>div:nth-child(2) strong{font-size:clamp(18px,1.55vw,25px)!important;}
.jj-detail .joy2-v93-drawer .joy2-v93-chart-head{display:flex!important;align-items:center!important;justify-content:space-between!important;
 margin:0!important;padding:0!important;font-family:inherit!important;font-size:17px!important;font-weight:700!important;
 border:0!important;line-height:1.25!important;}
.jj-detail .joy2-v93-chart-unit{font-size:12px!important;font-weight:400!important;color:#656d78!important;}
.jj-detail .joy2-v93-drawer .joy2-v90-chart{display:block!important;position:relative!important;
 padding:12px 10px 8px!important;margin:10px 0 0!important;height:auto!important;min-height:0!important;
 border:1px solid #dce1e6!important;border-radius:17px!important;background:#fff!important;
 overflow:hidden!important;}
.jj-detail .joy2-v93-drawer .joy2-v93-svg{display:block!important;width:100%!important;height:auto!important;max-height:275px!important;}
.jj-detail .joy2-v93-svg .axis-grid{stroke:#e6e9ec;stroke-width:1;}
.jj-detail .joy2-v93-svg .axis-zero{stroke:#aeb7bf;stroke-width:1.5;}
.jj-detail .joy2-v93-svg .axis-tick{font:13px Arial,sans-serif;fill:#4c535e;}
.jj-detail .joy2-v93-svg .bar-label{font:700 14px Arial,sans-serif;fill:#121417;}
.jj-detail .joy2-v93-svg .year-label{font:12px Arial,sans-serif;fill:#4e5660;}
.jj-detail .joy2-v93-drawer .joy2-v91-main>.jj-rinv-flow-strip{display:none!important;}
.jj-detail .joy2-v93-drawer>.joy2-v93-right{grid-area:right!important;grid-column:auto!important;grid-row:auto!important;
