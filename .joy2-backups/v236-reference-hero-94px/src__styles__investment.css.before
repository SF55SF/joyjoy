html body main.jj-ref-home #catalog #jj-filters>.jj-rf-top{
  grid-template-columns:minmax(150px,1.05fr) minmax(190px,1.18fr) minmax(150px,1fr) minmax(150px,1fr) minmax(170px,.9fr)!important;
  column-gap:12px!important;
