/* JOY2_ARROW_REFERENCE_194822_V1_START: silhouette measured from the user's screenshot, 1219x226 px. */
/* Visible arrow 57x40 px; 60x44 CSS box; 39 px separation from label; vertical centering. */
body .jj-ref-home .jj-ref-actions a.jj-ref-cta{
  display:inline-flex!important;
  align-items:center!important;
  justify-content:center!important;
  gap:39px!important;
}
/* Hide only the original text glyph; the arrow itself is the exact screenshot silhouette. */
body .jj-ref-home .jj-ref-actions a.jj-ref-cta > span[aria-hidden]{
  display:none!important;visibility:hidden!important;opacity:0!important;
}
/* Any older decorative arrow preceding the label is disabled. */
body .jj-ref-home .jj-ref-actions a.jj-ref-cta::before{
  content:none!important;display:none!important;
}
body .jj-ref-home .jj-ref-actions a.jj-ref-cta::after{
  content:""!important;
  display:block!important;
  visibility:visible!important;
  opacity:1!important;
  position:static!important;
  flex:0 0 60px!important;
  width:60px!important;
  height:44px!important;
  box-sizing:border-box!important;
  margin:0!important;
  padding:0!important;
  border:0!important;
  border-radius:0!important;
  background-color:#fff!important;
  background-image:none!important;
  -webkit-mask-image:url("data:image/png;base64,")!important;
  mask-image:url("data:image/png;base64,")!important;
  -webkit-mask-repeat:no-repeat!important;mask-repeat:no-repeat!important;
  -webkit-mask-position:center!important;mask-position:center!important;
  -webkit-mask-size:60px 44px!important;mask-size:60px 44px!important;
  color:transparent!important;
  font-size:0!important;line-height:0!important;
  transform:none!important;rotate:none!important;translate:none!important;
  filter:none!important;box-shadow:none!important;text-shadow:none!important;
  clip-path:none!important;
}
/* Reference: black investment button = white arrow; white all-objects button = #8bda00 arrow. */
body .jj-ref-home .jj-ref-actions a.jj-ref-cta:first-child::after{background-color:#fff!important;}
