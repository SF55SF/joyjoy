  html body .jj-detail .jj-unit-finance-drawer.joy2-v111 .joy2-v111-right :is(.joy2-v111-params,.joy2-v111-status) h3,
  html body .jj-detail .jj-unit-finance-drawer.joy2-v111 .joy2-v111-right h4,
  html body .jj-detail .jj-unit-finance-drawer.joy2-v111 .joy2-v113-notes h3,
  html body .jj-detail .jj-unit-finance-drawer.joy2-v111 .joy2-v114-notes-wide h3 {
    font-family:Inter,Arial,Helvetica,sans-serif!important;
    font-size:16px!important;font-weight:750!important;line-height:1.25!important;
    letter-spacing:-.02em!important;
  }
  /* All captions, parameters, values, helper copy and footer action labels share one size. */
  html body .jj-detail .jj-unit-finance-drawer.joy2-v111 .joy2-v111-right :is(dt,dd,p,small,span,label,li,strong,b),
  html body .jj-detail .jj-unit-finance-drawer.joy2-v111 .joy2-v111-right .jj-rinv-inputs :is(dt,dd),
  html body .jj-detail .jj-unit-finance-drawer.joy2-v111 :is(.joy2-v113-notes,.joy2-v114-notes-wide) :is(p,small,span,li,strong,b),
  html body .jj-detail .jj-unit-finance-drawer.joy2-v111 :is(.joy2-v111-actions,.joy2-v113-pdf-box,.joy2-v114-pdf-bottom) :is(summary,button,a,span,p,small) {
    font-family:Inter,Arial,Helvetica,sans-serif!important;
    font-size:13px!important;line-height:1.35!important;
  }
  /* Section action labels also use the small size; no third title size. */
  html body .jj-detail .jj-unit-finance-drawer.joy2-v111 .joy2-v111-right :is(summary,button,a),
  html body .jj-detail .jj-unit-finance-drawer.joy2-v111 :is(.joy2-v111-actions,.joy2-v113-pdf-box,.joy2-v114-pdf-bottom) :is(summary,button,a) {
    font-size:13px!important;line-height:1.35!important;
  }
}
