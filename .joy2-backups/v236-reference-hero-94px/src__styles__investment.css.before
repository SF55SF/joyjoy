html body main.jj-ref-home .jj-hero-right-v2.jj-hero-stage-v6 .jj-u-card .jj-property-summary{border:0!important;margin:0!important;padding:0 0 10px!important;align-self:start!important;align-items:baseline!important;flex-wrap:wrap!important;gap:6px!important;}
html body main.jj-ref-home .jj-hero-right-v2.jj-hero-stage-v6 .jj-u-card .jj-property-address{margin:0!important;padding:9px 0 12px!important;min-height:0!important;align-self:start!important;border-top:1px solid #e8e9ec!important;font-size:12.5px!important;line-height:1.4!important;display:-webkit-box!important;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;}
html body main.jj-ref-home .jj-hero-right-v2.jj-hero-stage-v6 .jj-u-card .jj-u-bottom{box-sizing:border-box;align-self:stretch;display:flex;flex-direction:column;justify-content:center;gap:5px;min-height:78px;padding:12px 13px;border-radius:10px;background:#f5f6f7;color:#14171a;font-family:Inter,Arial,sans-serif;}
html body main.jj-ref-home .jj-hero-right-v2.jj-hero-stage-v6 .jj-u-card .jj-u-bottom-label,html body main.jj-ref-home .jj-hero-right-v2.jj-hero-stage-v6 .jj-u-card .jj-u-metrics span{font-size:11px;line-height:1.35;color:#717781;font-weight:500;}
html body main.jj-ref-home .jj-hero-right-v2.jj-hero-stage-v6 .jj-u-card .jj-u-status{font-size:15px;line-height:1.4;font-weight:650;}
html body main.jj-ref-home .jj-hero-right-v2.jj-hero-stage-v6 .jj-u-card .jj-u-metrics{display:grid;grid-template-columns:minmax(0,.8fr) minmax(0,1.35fr);gap:10px;}
html body main.jj-ref-home .jj-hero-right-v2.jj-hero-stage-v6 .jj-u-card .jj-u-metrics>div{min-width:0;display:flex;flex-direction:column;gap:5px;}
html body main.jj-ref-home .jj-hero-right-v2.jj-hero-stage-v6 .jj-u-card .jj-u-metrics strong{font-size:16px;font-weight:700;line-height:1.25;letter-spacing:-.025em;overflow-wrap:anywhere;font-variant-numeric:tabular-nums;}
html body main.jj-ref-home .jj-hero-right-v2.jj-hero-stage-v6 .jj-u-card .jj-u-bottom.jj-u-empty{background:transparent;}
html body main.jj-ref-home .jj-hero-right-v2.jj-hero-stage-v6 .jj-u-card .jj-property-card-image .jj-u-ribbon{position:absolute!important;z-index:5!important;top:12px!important;left:12px!important;bottom:auto!important;right:auto!important;display:inline-flex!important;align-items:center!important;max-width:calc(100% - 66px)!important;padding:7px 11px!important;background:#b6ff00!important;color:#172100!important;clip-path:none!important;box-shadow:0 2px 8px #00000016!important;border-radius:6px!important;font:650 11px/1.25 Inter,Arial,sans-serif!important;letter-spacing:0!important;text-align:left!important;}
@media(max-width:1px){html body main.jj-ref-home .jj-hero-right-v2.jj-hero-stage-v6 .jj-u-card .jj-property-card-main{padding:14px!important}html body main.jj-ref-home .jj-hero-right-v2.jj-hero-stage-v6 .jj-u-card .jj-u-metrics strong{font-size:15px;}}
/* END JOY2_UNIFIED_CARDS_V1 */
/* JOY2_CARD_MATCH_REFERENCE_V1 */
/* Scope deliberately includes the catalog: legacy design patches must not affect cards here. */
html body main.jj-ref-home .jj-hero-right-v2.jj-hero-stage-v6 .jj-card-grid { align-items:stretch!important; grid-auto-rows:auto!important; }
html body main.jj-ref-home .jj-hero-right-v2.jj-hero-stage-v6 .jj-property-card {
  align-self:stretch!important; height:auto!important; min-height:0!important;
  display:flex!important; flex-direction:column!important;
  border-radius:20px!important; background:#fff!important;
  border:1px solid #e1e5e9!important; overflow:hidden!important;
  box-shadow:0 9px 26px rgba(22,31,46,.065)!important;
  font-family:Inter,Arial,Helvetica,sans-serif!important;
}
html body main.jj-ref-home .jj-hero-right-v2.jj-hero-stage-v6 .jj-property-card-image {
  display:block!important; width:100%!important; aspect-ratio:1.75!important;
