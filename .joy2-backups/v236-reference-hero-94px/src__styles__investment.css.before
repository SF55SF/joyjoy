html body main.jj-ref-home .jj-hero-right-v2.jj-hero-stage-v6 .jj-u-card .jj-u-metrics{display:grid!important;grid-template-columns:minmax(0,.8fr) minmax(0,1.35fr)!important;gap:10px!important;}
