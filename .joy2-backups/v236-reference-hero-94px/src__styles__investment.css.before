    gap: 18px !important;
    margin-top: 0 !important;
    margin-bottom: 16px !important;
  }
  .jj-detail .jj-detail-columns .jj-detail-main,
  .jj-detail .jj-detail-columns .jj-detail-sidebar {
    padding: 17px 20px !important;
  }
  .jj-detail .jj-detail-columns .jj-detail-main > section {
    margin: 0 0 13px !important;
    padding: 0 0 13px !important;
  }
  .jj-detail .jj-detail-columns .jj-detail-main > section:last-child {
    margin-bottom: 0 !important;
    padding-bottom: 0 !important;
  }
  .jj-detail .jj-detail-columns .jj-detail-main h2 {
    font-size: 24px !important;
    line-height: 1.2 !important;
    letter-spacing: -.028em !important;
    font-weight: 740 !important;
    margin: 0 0 8px !important;
  }
  .jj-detail .jj-detail-columns .jj-detail-main p,
  .jj-detail .jj-detail-columns .jj-detail-main .jj-feature-list,
  .jj-detail .jj-detail-columns .jj-detail-main .jj-feature-list li {
    font-size: 16px !important;
    line-height: 1.4 !important;
    font-weight: 400 !important;
    letter-spacing: -.005em !important;
    color: #445261 !important;
  }
  .jj-detail .jj-detail-columns .jj-detail-main p {
    margin: 0 !important;
  }
  .jj-detail .jj-detail-columns .jj-detail-main .jj-feature-list {
    column-gap: 24px !important;
    row-gap: 0 !important;
    margin: 0 !important;
    padding: 0 !important;
  }
  .jj-detail .jj-detail-columns .jj-detail-main .jj-feature-list li {
    padding: 9px 0 !important;
    min-height: 0 !important;
    margin: 0 !important;
    border-bottom: 1px solid #e9edf0 !important;
  }
  /* Right card: matching 16px body labels, tighter rows, consistent hierarchy. */
  .jj-detail .jj-detail-columns .jj-detail-sidebar .jj-detail-finance {
    padding-bottom: 12px !important;
    margin-bottom: 0 !important;
    gap: 5px !important;
  }
  .jj-detail .jj-detail-columns .jj-detail-sidebar .jj-detail-finance small,
  .jj-detail .jj-detail-columns .jj-detail-sidebar .jj-detail-finance > span,
  .jj-detail .jj-detail-columns .jj-detail-sidebar .jj-detail-metrics > div > span,
  .jj-detail .jj-detail-columns .jj-detail-sidebar .jj-detail-metrics > div > b,
  .jj-detail .jj-detail-columns .jj-detail-sidebar .jj-detail-location-wide p,
  .jj-detail .jj-detail-columns .jj-detail-sidebar .jj-detail-location-wide a {
    font-size: 16px !important;
    line-height: 1.4 !important;
    letter-spacing: -.005em !important;
  }
  .jj-detail .jj-detail-columns .jj-detail-sidebar .jj-detail-metrics > div {
    min-height: 0 !important;
    padding: 11px 0 !important;
    gap: 12px !important;
    align-items: baseline !important;
  }
  .jj-detail .jj-detail-columns .jj-detail-sidebar .jj-detail-metrics > div > span {
    font-weight: 450 !important;
    color: #445261 !important;
  }
  .jj-detail .jj-detail-columns .jj-detail-sidebar .jj-detail-metrics > div > b {
    font-weight: 650 !important;
    color: #101820 !important;
  }
  .jj-detail .jj-detail-columns .jj-detail-sidebar .jj-detail-finance strong {
    font-size: clamp(25px, 2vw, 31px) !important;
    line-height: 1.15 !important;
    letter-spacing: -.03em !important;
  }
  .jj-detail .jj-detail-columns .jj-detail-sidebar .jj-detail-location-wide {
    margin-top: 12px !important;
    padding-top: 12px !important;
  }
  .jj-detail .jj-detail-columns .jj-detail-sidebar .jj-detail-location-wide h2,
  .jj-detail .jj-detail-columns .jj-detail-sidebar .jj-detail-location-wide h3 {
    font-size: 22px !important;
    line-height: 1.22 !important;
    margin: 0 0 6px !important;
  }
}
@media screen and (max-width: 760px) {
  .jj-detail .jj-detail-columns { gap: 12px !important; }
  .jj-detail .jj-detail-columns .jj-detail-main,
  .jj-detail .jj-detail-columns .jj-detail-sidebar { padding: 15px !important; }
  .jj-detail .jj-detail-columns .jj-detail-main h2 { font-size: 21px !important; }
  .jj-detail .jj-detail-columns .jj-detail-main p,
  .jj-detail .jj-detail-columns .jj-detail-main .jj-feature-list li,
  .jj-detail .jj-detail-columns .jj-detail-sidebar .jj-detail-metrics > div > span,
  .jj-detail .jj-detail-columns .jj-detail-sidebar .jj-detail-metrics > div > b,
  .jj-detail .jj-detail-columns .jj-detail-sidebar .jj-detail-location-wide p { font-size: 15px !important; }
}
