/* JOY2_V126_BACKGROUND_CANONICAL: preserve final single-asset homepage background. */

/* JOY2_INVEST_DRAWER_SCALE_V128_REMOVED_BY_V215: browser controls the zoom */


/* JOY2_SUBTITLE_ALIGN_N_V133 */
html body main.jj-ref-home section.jj-ref-hero .jj-hero-left-v2 > p.joy2-subtitle-aligned-v67 { left:0!important; right:auto!important; margin-left:0!important; text-align:left!important; }
@media (max-width:999px) { html body main.jj-ref-home section.jj-ref-hero .jj-hero-left-v2 > p.joy2-subtitle-aligned-v67 { margin-inline:auto!important; text-align:center!important; } }

/* JOY2_HERO_BUTTON_WHITE_BORDER_SHADOW_V140 */
/* Same soft lifted shadow as the hero property card, on both hero CTA buttons. */
html body main.jj-ref-home section.jj-ref-hero .jj-ref-actions > a.jj-ref-cta,
html body main.jj-ref-home section.jj-ref-hero .jj-ref-actions > a.jj-ref-cta:hover,
html body main.jj-ref-home section.jj-ref-hero .jj-ref-actions > a.jj-ref-cta:focus-visible{
  box-shadow:0 22px 44px rgba(19,22,29,.23),0 7px 15px rgba(19,22,29,.10)!important;
}
html body main.jj-ref-home section.jj-ref-hero #joy2-hero-invest-cta-v11{border-color:#FFFFFF!important;}
/* JOY2_HERO_BUTTON_WHITE_BORDER_SHADOW_V140_END */

/* JOY2_SUBTITLE_STABLE_V141_START */
html body main.jj-ref-home section.jj-ref-hero p.joy2-subtitle-aligned-v67{
 position:relative!important;left:var(--joy2-subtitle-offset-v141,0px)!important;
 right:auto!important;transition:none!important;animation:none!important;
}
html body main.jj-ref-home section.jj-ref-hero p.joy2-subtitle-aligned-v67:not([data-joy2-caption-ready="yes"]){visibility:hidden!important;}
/* JOY2_SUBTITLE_STABLE_V141_END */

/* JOY2_HERO_CTA_SHADOW_DOUBLE_V142_START */
/* Twice v140 shadow distance and blur; same alpha, no layout changes. */
html body main.jj-ref-home section.jj-ref-hero .jj-ref-actions > a.jj-ref-cta,
html body main.jj-ref-home section.jj-ref-hero .jj-ref-actions > a.jj-ref-cta:hover,
html body main.jj-ref-home section.jj-ref-hero .jj-ref-actions > a.jj-ref-cta:focus-visible {
  box-shadow:0 44px 88px rgba(19,22,29,.23),0 14px 30px rgba(19,22,29,.10)!important;
}
/* JOY2_HERO_CTA_SHADOW_DOUBLE_V142_END */

/* JOY2_CTA_STRONG_SHADOW_V144_START */
html body main.jj-ref-home section.jj-ref-hero .jj-ref-actions > a.jj-ref-cta,
html body main.jj-ref-home section.jj-ref-hero .jj-ref-actions > a.jj-ref-cta:hover,
html body main.jj-ref-home section.jj-ref-hero .jj-ref-actions > a.jj-ref-cta:focus-visible {
 box-shadow:0 44px 88px rgba(19,22,29,.46),0 14px 30px rgba(19,22,29,.20)!important;
}
/* JOY2_CTA_STRONG_SHADOW_V144_END */




/* JOY2_CTA_LIFT_ONLY_V147_START */
/* Shadow remains constant; only the button lifts on hover. */
html body main.jj-ref-home section.jj-ref-hero .jj-ref-actions > a.jj-ref-cta,
html body main.jj-ref-home section.jj-ref-hero .jj-ref-actions > a.jj-ref-cta:hover,
html body main.jj-ref-home section.jj-ref-hero .jj-ref-actions > a.jj-ref-cta:focus-visible,
html body main.jj-ref-home section.jj-ref-hero .jj-ref-actions > a.jj-ref-cta:active{
 box-shadow:0 44px 88px rgba(19,22,29,.46),0 14px 30px rgba(19,22,29,.20)!important;
 transition:transform .15s ease,background-color .15s ease,color .15s ease!important;
}
html body main.jj-ref-home section.jj-ref-hero .jj-ref-actions > a.jj-ref-cta{transform:translateY(0)!important;translate:none!important;}
html body main.jj-ref-home section.jj-ref-hero .jj-ref-actions > a.jj-ref-cta:hover{transform:translateY(-2px)!important;translate:none!important;}
html body main.jj-ref-home section.jj-ref-hero .jj-ref-actions > a.jj-ref-cta:active{transform:translateY(0)!important;}
/* JOY2_CTA_LIFT_ONLY_V147_END */

/* JOY2_RESPONSIVE_ZOOM_V150_FIXED */
@media screen and (min-width:1200px){html body .jj-detail .jj-unit-finance-drawer[data-jj-finance-drawer],html body .jj-detail .jj-unit-finance-drawer.joy2-v111{zoom:.9!important}}
