html body main.jj-ref-home .jj-hero-right-v2.jj-hero-stage-v6 .jj-canonical-address{display:flex!important;align-items:flex-start!important;padding:5px 0 0!important;min-height:0!important;}
html body main.jj-ref-home .jj-hero-right-v2.jj-hero-stage-v6 .jj-canonical-address .jj-property-address{margin:0!important;min-height:0!important;padding:0!important;font:400 12px/19px 'Inter',Arial,sans-serif!important;color:#59616a!important;display:-webkit-box!important;-webkit-line-clamp:2!important;line-clamp:2!important;-webkit-box-orient:vertical!important;overflow:hidden!important;}
html body main.jj-ref-home .jj-hero-right-v2.jj-hero-stage-v6 .jj-canonical-bottom{box-sizing:border-box!important;min-height:76px!important;border-radius:10px!important;border:1px solid #e8ebed!important;background:#f6f7f7!important;padding:11px 12px!important;margin:0!important;font-family:'Inter',Arial,sans-serif!important;}
html body main.jj-ref-home .jj-hero-right-v2.jj-hero-stage-v6 .jj-canonical-bottom small{font:500 11px/16px 'Inter',Arial,sans-serif!important;color:#6a717b!important;display:block!important;margin-bottom:6px!important;}
