/* JOY2_CARD_CANONICAL_V1_END */
/* JOY2_UNIFIED_CARDS_V1 */
html body main.jj-ref-home .jj-hero-right-v2.jj-hero-stage-v6 .jj-card-grid{align-items:stretch!important;}
html body main.jj-ref-home .jj-hero-right-v2.jj-hero-stage-v6 .jj-u-card{height:100%!important;min-height:0!important;display:flex!important;flex-direction:column!important;}
html body main.jj-ref-home .jj-hero-right-v2.jj-hero-stage-v6 .jj-u-card .jj-property-card-main{flex:1 1 auto!important;min-height:0!important;display:grid!important;grid-template-rows:auto minmax(47px,auto) auto minmax(43px,auto) minmax(78px,auto)!important;align-content:start!important;gap:0!important;padding:16px!important;font-family:Inter,Arial,sans-serif!important;}
html body main.jj-ref-home .jj-hero-right-v2.jj-hero-stage-v6 .jj-u-card .jj-card-overline{margin:0 0 5px!important;font-size:12px!important;line-height:18px!important;}
