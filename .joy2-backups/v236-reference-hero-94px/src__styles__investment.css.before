/* JOY2_V200_DETAIL_MOBILE_TABLE_START */
@media screen and (max-width:760px){
 /* The entire page stays within the viewport; table alone can scroll. */
 html body main.jj-detail,html body main.jj-detail .jj-detail-units-wide,html body main.jj-detail .jj-detail-units-wide .jj-units{min-width:0!important;max-width:100%!important;box-sizing:border-box!important;}
 html body main.jj-detail .jj-detail-units-wide .jj-unit-table-wrap{display:block!important;position:relative!important;width:100%!important;max-width:100%!important;min-width:0!important;overflow-x:auto!important;overflow-y:hidden!important;-webkit-overflow-scrolling:touch!important;overscroll-behavior-x:contain!important;scrollbar-width:thin!important;scrollbar-color:#aeb5bb #edf0f2!important;border-radius:12px!important;}
 html body main.jj-detail .jj-unit-table-wrap .jj-unit-table-heading,html body main.jj-detail .jj-unit-table-wrap .jj-unit-data-row{width:760px!important;min-width:760px!important;max-width:none!important;grid-template-columns:minmax(155px,1.27fr) minmax(110px,.75fr) minmax(118px,.85fr) minmax(160px,.95fr) minmax(190px,1.13fr)!important;gap:12px!important;box-sizing:border-box!important;}
 html body main.jj-detail .jj-unit-table-wrap .jj-units-list{width:760px!important;min-width:760px!important;max-width:none!important;}
 html body main.jj-detail .jj-unit-table-wrap::-webkit-scrollbar{height:7px!important;}
 html body main.jj-detail .jj-unit-table-wrap::-webkit-scrollbar-thumb{background:#acb3ba!important;border-radius:8px!important;}
 html body main.jj-detail .jj-unit-table-wrap::-webkit-scrollbar-track{background:#eceff1!important;border-radius:8px!important;}
 /* Visual cue, outside the scrolling content. The existing heading and info remain. */
 html body main.jj-detail .jj-detail-units-wide .jj-units-intro::after{content:'  ·  Листайте таблицу вправо →';display:inline;color:#46515a;font-weight:650;white-space:normal;}
 html:lang(uz) body main.jj-detail .jj-detail-units-wide .jj-units-intro::after{content:'  ·  Jadvalni o‘ngga suring →';}
 html:lang(en) body main.jj-detail .jj-detail-units-wide .jj-units-intro::after{content:'  ·  Swipe table right →';}
 /* Header only: preserve the same logo and existing actions, but avoid crowding. */
 html body .jj-detail-sitebar .jj-sitebar-in{gap:6px!important;}
 html body .jj-detail-sitebar .jj-brand-logo{width:clamp(80px,18vw,104px)!important;height:auto!important;}
 html body .jj-detail-sitebar .jj-detail-back-nav{flex:0 0 auto!important;min-width:0!important;padding:8px 10px!important;gap:5px!important;white-space:nowrap!important;font-size:clamp(12px,2.4vw,15px)!important;}
 html body .jj-detail-sitebar .joy2-dev-admin-link{flex:0 0 auto!important;padding:8px 9px!important;font-size:clamp(12px,2.3vw,14px)!important;white-space:nowrap!important;}
 html body .jj-detail-sitebar .jj-sitebar-right{gap:3px!important;flex:0 0 auto!important;}
 html body .jj-detail-sitebar .jj-lang{gap:0!important;}
 html body .jj-detail-sitebar .jj-lang a{min-width:29px!important;padding:0 2px!important;font-size:clamp(11px,2vw,13px)!important;}
}
/* JOY2_V200_DETAIL_MOBILE_TABLE_END */

/* JOY2_V201_DETAIL_START */
@media screen and (max-width:760px){
 /* Remove the scrolling hint introduced in V200 and show just 3 columns. */
 html body main.jj-detail .jj-detail-units-wide .jj-units-intro::after{content:none!important;display:none!important;}
 html body main.jj-detail .jj-detail-units-wide .jj-unit-table-wrap{
   position:static!important;display:block!important;width:100%!important;min-width:0!important;
   max-width:100%!important;overflow:visible!important;scrollbar-width:none!important;
   border-radius:12px!important;
 }
 html body main.jj-detail .jj-detail-units-wide .jj-unit-table-wrap::-webkit-scrollbar{display:none!important;}
 html body main.jj-detail .jj-detail-units-wide .jj-unit-table-heading,
 html body main.jj-detail .jj-detail-units-wide .jj-unit-data-row{
   display:grid!important;grid-template-columns:minmax(0,.85fr) minmax(0,.75fr) minmax(0,1.25fr)!important;
   column-gap:8px!important;width:100%!important;min-width:0!important;max-width:100%!important;
   box-sizing:border-box!important;padding-left:10px!important;padding-right:10px!important;
 }
 html body main.jj-detail .jj-detail-units-wide .jj-units-list{min-width:0!important;max-width:100%!important;width:100%!important;}
