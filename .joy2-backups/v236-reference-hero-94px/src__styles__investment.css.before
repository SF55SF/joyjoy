/* JOY2_V211_FIXED_END */

/* JOY2_V213_DETAIL_SPACING_START */
@media screen and (max-width:760px){
 /* Match the actual property heading's left edge, not the old header shell gutters. */
 html body header.jj-detail-sitebar .jj-sitebar-in{
  box-sizing:border-box!important;width:100%!important;max-width:100%!important;
  margin:0!important;padding-left:var(--joy2-v213-side,16px)!important;
  padding-right:var(--joy2-v213-side,16px)!important;
  display:flex!important;align-items:center!important;justify-content:flex-start!important;
  gap:7px!important;min-width:0!important;
 }
 html body header.jj-detail-sitebar .jj-sitebar-in>.jj-wordmark{
  position:relative!important;left:auto!important;right:auto!important;
  transform:none!important;translate:none!important;
  margin:0!important;padding:0!important;flex:0 0 auto!important;
 }
 html body header.jj-detail-sitebar .jj-sitebar-in>.jj-wordmark .jj-brand-logo{
  display:block!important;margin:0!important;padding:0!important;
 }
 html body header.jj-detail-sitebar .jj-sitebar-in>a.jj-detail-back-nav{
  margin:0!important;flex:0 0 auto!important;gap:6px!important;
  box-sizing:border-box!important;height:38px!important;min-height:38px!important;
  padding:0 11px!important;border:1px solid #dbe2e8!important;
  border-radius:12px!important;background:#fff!important;color:#17202a!important;
  font:700 13px/1 Inter,Arial,sans-serif!important;white-space:nowrap!important;
  box-shadow:0 4px 13px rgba(16,25,33,.08)!important;
 }
 html body header.jj-detail-sitebar .jj-sitebar-in>a.jj-detail-back-nav svg{
  width:16px!important;height:16px!important;flex:0 0 16px!important;
 }
 html body header.jj-detail-sitebar .jj-sitebar-in>a.jj-detail-back-nav:hover{
  background:#f5f8f9!important;border-color:#bfd0d5!important;
 }
 html body header.jj-detail-sitebar .jj-sitebar-in>a.jj-detail-back-nav:active{
  background:#eaffc9!important;transform:translateY(1px)!important;
 }
 html body header.jj-detail-sitebar .jj-sitebar-in .jj-sitebar-right{
  margin-left:auto!important;min-width:0!important;gap:5px!important;
 }
}
/* JOY2_V213_DETAIL_SPACING_END */

/* JOY2_V214_MOBILE_HEADER_START */
@media screen and (max-width:760px){
 html body header.jj-detail-sitebar .jj-sitebar-in{display:flex!important;align-items:center!important;justify-content:flex-start!important;box-sizing:border-box!important;gap:7px!important;}
 html body header.jj-detail-sitebar .jj-sitebar-in>.jj-wordmark{flex:0 0 auto!important;position:relative!important;left:auto!important;right:auto!important;top:auto!important;bottom:auto!important;padding:0!important;}
 html body header.jj-detail-sitebar .jj-sitebar-in>.jj-detail-back-nav{display:inline-flex!important;align-items:center!important;justify-content:center!important;flex-shrink:0!important;height:38px!important;min-height:38px!important;padding:0 11px!important;gap:6px!important;margin:0!important;border:1px solid #dce4e7!important;border-radius:12px!important;background:white!important;color:#18222c!important;box-shadow:0 3px 10px #16212b12!important;font:700 13px/1 Inter,Arial,sans-serif!important;text-decoration:none!important;}
 html body header.jj-detail-sitebar .jj-sitebar-in>.jj-detail-back-nav svg{width:16px!important;height:16px!important;flex:0 0 16px!important;}
 html body header.jj-detail-sitebar .jj-sitebar-in>.jj-detail-back-nav:active{background:#eaffbd!important;transform:translateY(1px)!important;}
 html body header.jj-detail-sitebar .jj-sitebar-in .jj-sitebar-right{margin-left:auto!important;min-width:0!important;}
}
/* JOY2_V214_MOBILE_HEADER_END */

/* JOY2_V215_RESPONSIVE_ZOOM_START */
/* Keep native browser zoom functional. Layout dimensions stay in the flow. */
html{ -webkit-text-size-adjust:100%; text-size-adjust:100%; }
html body{ max-width:100%; }
html body .jj-ref-home, html body main.jj-detail{ min-width:0; }
html body .jj-ref-home .jj-ref-hero h1,
html body .jj-ref-home .jj-ref-hero h1 + p,
html body .jj-ref-home .jj-ref-hero .jj-ref-actions{
  scale:1!important;
}
html body main.jj-detail .jj-unit-finance-drawer[data-jj-finance-drawer],
html body main.jj-detail .jj-unit-finance-drawer.joy2-v111{
  zoom:1!important;
}
@media(max-width:900px){
 html body .jj-detail-sitebar .jj-sitebar-in,
 html body main.jj-detail,
 html body main.jj-ref-home,
 html body .jj-detail .jj-detail-heading,
 html body .jj-detail .jj-detail-units-wide,
 html body .jj-detail .jj-unit-table-wrap{
  box-sizing:border-box!important;max-width:100%;min-width:0;
 }
 html body .jj-detail .jj-detail-heading>div:first-child{min-width:0!important;max-width:100%;}
 html body .jj-detail .jj-detail-heading p{overflow-wrap:anywhere;}
}
/* JOY2_V215_RESPONSIVE_ZOOM_END */

/* JOY2_V222_RESPONSIVE_START */
/* Native browser zoom only. Never infer device type from outerWidth or force a wide body. */
html, body { min-width:0; }
html body main.jj-ref-home, html body main.jj-detail { min-width:0; box-sizing:border-box; }
html body .jj-ref-home :is(.jj-ref-hero,.jj-hero-left-v2,.jj-hero-right-v2,.jj-workspace,.jj-card-grid,.jj-property-card),
html body main.jj-detail :is(.jj-detail-heading,.jj-detail-columns,.jj-detail-main,.jj-detail-sidebar,.jj-photo-layout,.jj-detail-units-wide,.jj-unit-table-wrap) {min-width:0;box-sizing:border-box;}
html body .jj-ref-home .jj-card-grid > * { min-width:0;max-width:100%; }
html body main.jj-detail .jj-detail-heading > div:first-child {min-width:0;}
html body main.jj-detail .jj-detail-heading p {overflow-wrap:anywhere;}
/* Large desktop: columns retain their proportions and are capped instead of drifting apart. */
@media screen and (min-width:1400px) {
 html body main.jj-ref-home > .jj-ref-hero.jj-hero-layout-v2 {
  display:grid!important;grid-template-columns:minmax(0,1fr) minmax(320px,390px)!important;
  gap:clamp(24px,3vw,48px)!important;
  width:min(1880px,calc(100% - clamp(48px,6vw,144px)))!important;
  max-width:1880px!important;margin-inline:auto!important;box-sizing:border-box!important;
 }
 html body main.jj-ref-home > .jj-ref-hero.jj-hero-layout-v2 .jj-hero-right-v2 {width:100%!important;max-width:390px!important;margin:0!important;justify-self:end!important;}
 html body main.jj-ref-home > .jj-ref-hero.jj-hero-layout-v2 .jj-hero-left-v2 {min-width:0!important;max-width:100%!important;}
}
/* Smaller desktop: reduce the fixed card width before text begins to collide. */
@media screen and (min-width:1200px) and (max-width:1399px) {
 html body main.jj-ref-home > .jj-ref-hero.jj-hero-layout-v2 {
  display:grid!important;grid-template-columns:minmax(0,1fr) minmax(280px,330px)!important;
  gap:clamp(18px,2vw,30px)!important;width:calc(100% - 64px)!important;
  margin-inline:auto!important;box-sizing:border-box!important;
 }
 html body main.jj-ref-home > .jj-ref-hero.jj-hero-layout-v2 .jj-hero-right-v2 {width:100%!important;max-width:330px!important;margin:0!important;justify-self:end!important;}
 html body main.jj-ref-home > .jj-ref-hero.jj-hero-layout-v2 .jj-hero-left-v2 {min-width:0!important;max-width:100%!important;}
 html body main.jj-ref-home > .jj-ref-hero.jj-hero-layout-v2 .jj-hero-left-v2 > h1 {font-size:clamp(44px,4.5vw,65px)!important;max-width:100%!important;}
}
/* Zooming a 2560px monitor to 200-250% crosses laptop/tablet breakpoints.
   Avoid pretending a 1024px viewport can still hold the full desktop hero. */
@media screen and (min-width:1000px) and (max-width:1199px) {
 html body main.jj-ref-home > .jj-ref-hero.jj-hero-layout-v2 {
  display:flex!important;flex-direction:column!important;justify-content:center!important;
  align-items:center!important;gap:22px!important;padding:30px 0!important;
  width:calc(100% - 48px)!important;margin-inline:auto!important;
  min-height:0!important;height:auto!important;
 }
 html body main.jj-ref-home > .jj-ref-hero.jj-hero-layout-v2 .jj-hero-left-v2 {
  width:100%!important;max-width:850px!important;min-width:0!important;
  align-items:center!important;text-align:center!important;margin-inline:auto!important;
 }
 html body main.jj-ref-home > .jj-ref-hero.jj-hero-layout-v2 .jj-hero-left-v2 > h1 {font-size:clamp(42px,5.2vw,65px)!important;max-width:100%!important;}
 html body main.jj-ref-home > .jj-ref-hero.jj-hero-layout-v2 .jj-hero-right-v2 {
  width:min(100%,390px)!important;max-width:390px!important;margin:0 auto!important;
  justify-self:center!important;align-self:center!important;
 }
 html body main.jj-ref-home #catalog-results .jj-card-grid,
 html body main.jj-ref-home .jj-workspace[data-jj-mode="list"] .jj-card-grid {grid-template-columns:repeat(2,minmax(0,1fr))!important;}
}
/* Across tablet/laptop widths the detail page becomes one column before
   a 330px sidebar squeezes out the content. */
@media screen and (min-width:761px) and (max-width:1100px) {
 html body main.jj-detail .jj-detail-columns {display:grid!important;grid-template-columns:minmax(0,1fr)!important;gap:18px!important;}
 html body main.jj-detail .jj-detail-sidebar {position:static!important;min-width:0!important;width:100%!important;}
 html body main.jj-detail .jj-detail-heading {flex-wrap:wrap!important;gap:12px 20px!important;}
 html body main.jj-detail .jj-detail-contact-top {flex:1 1 290px!important;max-width:100%!important;}
}
@media screen and (min-width:761px) and (max-width:900px) {
 html body main.jj-detail .jj-photo-layout.jj-gallery-v25:not(.is-single) {grid-template-columns:minmax(0,1.4fr) minmax(0,1fr)!important;}
}
/* Site headers must not keep a single oversized row at increased browser zoom. */
@media screen and (max-width:1199px) {
 html body > header.jj-sitebar.jj-ref-header[data-joy2-final-header],
 html body header.jj-detail-sitebar {height:auto!important;min-height:68px!important;}
 html body > header.jj-sitebar.jj-ref-header[data-joy2-final-header] > .jj-sitebar-in,
 html body header.jj-detail-sitebar .jj-sitebar-in {height:auto!important;min-height:68px!important;flex-wrap:wrap!important;gap:8px 12px!important;padding-block:8px!important;box-sizing:border-box!important;}
 html body header.jj-detail-sitebar .jj-sitebar-right {min-width:0!important;margin-left:auto!important;}
}
/* Retain the already-designed mobile layouts rather than forcing desktop grids. */
@media screen and (max-width:760px) {
 html body main.jj-detail .jj-detail-columns {grid-template-columns:minmax(0,1fr)!important;}
 html body main.jj-detail .jj-detail-heading,
 html body main.jj-detail .jj-detail-units-wide,
 html body main.jj-detail .jj-unit-table-wrap {min-width:0!important;max-width:100%!important;}
 html body main.jj-ref-home > .jj-ref-hero.jj-hero-layout-v2 {max-width:100%!important;box-sizing:border-box!important;}
}

/* Do not allow oversized intrinsic widths to force the entire viewport wider. */
html body .jj-ref-home :is(.jj-filter-shell,.jj-filter-form,.jj-card-grid,.jj-workspace,#catalog-results),
html body main.jj-detail :is(.jj-photo-layout,.jj-detail-columns,.jj-unit-table-wrap,.jj-detail-contact-top){min-width:0;max-width:100%;box-sizing:border-box;}
html body :is(.jj-card-grid,.jj-detail-columns,.jj-filter-form) > *{min-width:0;}
@media screen and (max-width:1199px){
 html body main.jj-ref-home .jj-ref-hero h1{overflow-wrap:normal;max-width:100%;}
 html body main.jj-ref-home .jj-ref-hero .jj-ref-actions{max-width:100%;flex-wrap:wrap;}
}
/* Responsive refinements for the fixed-size site header. */
@media screen and (min-width:701px) and (max-width:1199px) {
 html body > header.jj-sitebar.jj-ref-header[data-joy2-final-header] > .jj-sitebar-in {
  width:calc(100% - 32px)!important;max-width:100%!important;margin-inline:16px!important;
  gap:clamp(8px,1.2vw,16px)!important;
 }
 html body > header.jj-sitebar.jj-ref-header[data-joy2-final-header] .jj-brand-logo {
  width:clamp(135px,14vw,181px)!important;
 }
}
@media screen and (max-width:700px) {
 html body > header.jj-sitebar.jj-ref-header[data-joy2-final-header] > .jj-sitebar-in {
  width:calc(100% - 24px)!important;margin-inline:12px!important;gap:6px!important;
 }
 html body > header.jj-sitebar.jj-ref-header[data-joy2-final-header] .jj-brand-logo {
  width:clamp(100px,33vw,159px)!important;
 }
 html body > header.jj-sitebar.jj-ref-header[data-joy2-final-header] .jj-lang a {
  min-width:clamp(24px,7vw,29px)!important;
 }
}
/* JOY2_V222_RESPONSIVE_END */

/* JOY2_V224_TWO_LAYOUT_MODES_START */
/* Two structural layouts only: desktop >=1000 CSS px, mobile <1000 CSS px.
   Browser zoom follows available viewport, with no page-wide scale/forced canvas. */
html{-webkit-text-size-adjust:100%;text-size-adjust:100%}
html body{width:100%;min-width:0;max-width:100%}
html body main.jj-ref-home,html body main.jj-detail{min-width:0;box-sizing:border-box}
html body main.jj-ref-home img,html body main.jj-detail img{max-width:100%}
html body .jj-ref-home .jj-workspace,html body .jj-ref-home #catalog-results,
html body .jj-ref-home #jj-results,html body main.jj-detail .jj-detail-columns,
html body main.jj-detail .jj-detail-units-wide{min-width:0;max-width:100%;box-sizing:border-box}
html body .jj-ref-home .jj-card-grid>*{min-width:0;max-width:100%;box-sizing:border-box}
html body .jj-ref-home .jj-property-card{min-width:0;max-width:100%;box-sizing:border-box}
html body .jj-ref-home .jj-property-card img{max-width:100%}
html body main.jj-detail .jj-detail-heading>div:first-child{min-width:0}
html body main.jj-detail .jj-detail-heading p{overflow-wrap:anywhere}
/* DESKTOP: stable hierarchy, no intermediate tablet layout. */
@media (min-width:1000px){
 html body main.jj-ref-home>.jj-ref-hero.jj-hero-layout-v2{
  display:grid!important;grid-template-columns:minmax(0,1fr) minmax(310px,390px)!important;
  width:calc(100% - 2*clamp(24px,4vw,80px))!important;
  max-width:1740px!important;margin-inline:auto!important;column-gap:clamp(22px,3vw,56px)!important;
  align-items:center!important;box-sizing:border-box!important
 }
 html body main.jj-ref-home>.jj-ref-hero .jj-hero-left-v2{min-width:0!important;max-width:100%!important}
 html body main.jj-ref-home>.jj-ref-hero .jj-hero-right-v2.jj-hero-stage-v6{
  width:100%!important;max-width:390px!important;margin-right:0!important;min-width:0!important
 }
 html body main.jj-ref-home #catalog-results{max-width:1560px!important;margin-inline:auto!important}
 html body main.jj-ref-home #catalog-results #jj-results.jj-card-grid,
 html body main.jj-ref-home #catalog-results .jj-workspace[data-jj-mode="list"] #jj-results.jj-card-grid{
  display:grid!important;grid-template-columns:repeat(3,minmax(0,1fr))!important;
  gap:clamp(14px,1.3vw,22px)!important
 }
 html body main.jj-detail .jj-detail-columns{display:grid!important;grid-template-columns:minmax(0,1fr) minmax(280px,330px)!important;gap:clamp(14px,2vw,26px)!important}
 html body main.jj-detail .jj-detail-heading{min-width:0;max-width:100%}
}
/* MOBILE: same order, 2-column listing and 3-column units on all device models. */
@media (max-width:999px){
 html body main.jj-ref-home>.jj-ref-hero.jj-hero-layout-v2{
  display:flex!important;flex-direction:column!important;align-items:stretch!important;
  min-width:0!important;max-width:100%!important;box-sizing:border-box!important
 }
 html body main.jj-ref-home>.jj-ref-hero .jj-hero-left-v2,
 html body main.jj-ref-home>.jj-ref-hero .jj-hero-right-v2{min-width:0!important;max-width:100%!important}
 html body main.jj-ref-home>.jj-ref-hero.jj-hero-layout-v2 .jj-hero-left-v2>h1{font-size:clamp(34px,6vw,54px)!important;line-height:1.08!important;width:100%!important;max-width:100%!important;overflow-wrap:anywhere!important;box-sizing:border-box!important}
 html body main.jj-ref-home #catalog-results{width:100%!important;max-width:560px!important;margin-inline:auto!important}
 html body main.jj-ref-home #catalog-results #jj-results.jj-card-grid,
 html body main.jj-ref-home #catalog-results .jj-workspace[data-jj-mode="list"] #jj-results.jj-card-grid{
  display:grid!important;grid-template-columns:repeat(2,minmax(0,1fr))!important;
  gap:clamp(8px,2vw,12px)!important;width:100%!important;min-width:0!important
 }
 html body main.jj-ref-home #catalog-results #jj-results.jj-card-grid>*{min-width:0!important;width:100%!important;max-width:100%!important}
 html body main.jj-detail.jj-shell{min-width:0!important;max-width:100%!important;box-sizing:border-box!important}
 html body main.jj-detail .jj-detail-columns{display:grid!important;grid-template-columns:minmax(0,1fr)!important;gap:14px!important}
 html body main.jj-detail .jj-detail-heading{display:flex!important;flex-direction:column!important;align-items:stretch!important;gap:8px!important}
 html body main.jj-detail .jj-detail-heading>.jj-detail-contact-top{max-width:100%!important;flex-wrap:wrap!important}
 html body main.jj-detail .jj-photo-layout.jj-gallery-v25:not(.is-single){
  display:grid!important;grid-template-columns:minmax(0,1fr)!important;height:auto!important;gap:9px!important
 }
 html body main.jj-detail .jj-photo-layout.jj-gallery-v25 .jj-photo-main{min-width:0!important;height:auto!important;aspect-ratio:16/10!important}
 html body main.jj-detail .jj-photo-layout.jj-gallery-v25 .jj-detail-gallery-side{min-width:0!important;grid-template-columns:repeat(2,minmax(0,1fr))!important;grid-template-rows:none!important}
 html body main.jj-detail .jj-detail-units-wide .jj-unit-table-wrap{
  width:100%!important;max-width:100%!important;min-width:0!important;overflow-x:hidden!important;box-sizing:border-box!important
 }
 html body main.jj-detail .jj-detail-units-wide .jj-unit-table-heading,
 html body main.jj-detail .jj-detail-units-wide .jj-unit-data-row{
  display:grid!important;grid-template-columns:minmax(0,29fr) minmax(0,25fr) minmax(0,46fr)!important;
  width:100%!important;min-width:0!important;max-width:100%!important;
  box-sizing:border-box!important;gap:6px!important;padding-inline:10px!important
 }
 html body main.jj-detail .jj-detail-units-wide .jj-unit-table-heading>:nth-child(3),
 html body main.jj-detail .jj-detail-units-wide .jj-unit-table-heading>:nth-child(5),
 html body main.jj-detail .jj-detail-units-wide .jj-unit-data-row>:nth-child(3),
 html body main.jj-detail .jj-detail-units-wide .jj-unit-data-row>:nth-child(5){display:none!important}
 html body main.jj-detail .jj-detail-units-wide .jj-unit-table-heading>*,
 html body main.jj-detail .jj-detail-units-wide .jj-unit-data-row>*{min-width:0!important;max-width:100%!important;overflow-wrap:anywhere!important}
 html body main.jj-detail .jj-detail-units-wide .jj-unit-table-heading>:nth-child(1),
 html body main.jj-detail .jj-detail-units-wide .jj-unit-data-row>:nth-child(1){text-align:left!important}
 html body main.jj-detail .jj-detail-units-wide .jj-unit-table-heading>:nth-child(2),
 html body main.jj-detail .jj-detail-units-wide .jj-unit-data-row>:nth-child(2){text-align:center!important}
 html body main.jj-detail .jj-detail-units-wide .jj-unit-table-heading>:nth-child(4),
 html body main.jj-detail .jj-detail-units-wide .jj-unit-data-row>:nth-child(4){text-align:right!important}
 html body header.jj-detail-sitebar .jj-sitebar-in{display:flex!important;align-items:center!important;gap:clamp(5px,1.4vw,10px)!important;min-width:0!important;box-sizing:border-box!important}
 html body header.jj-detail-sitebar .jj-sitebar-in .jj-sitebar-right{min-width:0!important;margin-left:auto!important}
}
/* JOY2_V224_TWO_LAYOUT_MODES_END */




/* JOY2_V228_SORT_FILTER_STYLE_START */
/* Native select remains the single source of truth; only its visual control is replaced. */
html body main.jj-ref-home .jj-listing-actions label:has(#jj-sort){display:none!important}
html body main.jj-ref-home .jj-listing-actions .joy2-sort-v228{position:relative!important;min-width:0!important;width:clamp(180px,16vw,238px)!important;max-width:100%!important;flex:0 0 auto!important;font-family:Inter,Arial,sans-serif!important;z-index:4!important}
html body main.jj-ref-home .jj-listing-actions .joy2-sort-v228.is-open{z-index:350!important}
html body main.jj-ref-home .jj-listing-actions .joy2-sort-v228-trigger{display:flex!important;align-items:center!important;justify-content:space-between!important;gap:12px!important;box-sizing:border-box!important;width:100%!important;min-width:0!important;min-height:44px!important;height:44px!important;margin:0!important;padding:8px 13px!important;background:#fff!important;background-image:none!important;border:1px solid #e1e5e9!important;border-radius:13px!important;box-shadow:0 2px 10px #121a240c!important;color:#161719!important;text-align:left!important;font:600 13px/1.35 Inter,Arial,sans-serif!important;cursor:pointer!important;outline:none!important;transform:none!important}
html body main.jj-ref-home .jj-listing-actions .joy2-sort-v228-trigger:hover{border-color:#cfd5db!important}
html body main.jj-ref-home .jj-listing-actions .joy2-sort-v228-trigger:focus-visible{border-color:#d5d9df!important;box-shadow:0 0 0 2px #dce2e7!important;outline:none!important}
html body main.jj-ref-home .jj-listing-actions .joy2-sort-v228.is-open .joy2-sort-v228-trigger{border-color:#d5d9df!important;box-shadow:0 2px 10px #121a2414!important;outline:none!important}
html body main.jj-ref-home .jj-listing-actions .joy2-sort-v228-trigger>span{overflow:hidden!important;text-overflow:ellipsis!important;white-space:nowrap!important;min-width:0!important}
html body main.jj-ref-home .jj-listing-actions .joy2-sort-v228-chevron{width:16px!important;height:16px!important;flex:0 0 16px!important;transition:transform .15s ease!important}
html body main.jj-ref-home .jj-listing-actions .joy2-sort-v228.is-open .joy2-sort-v228-chevron{transform:rotate(180deg)!important}
html body main.jj-ref-home .jj-listing-actions .joy2-sort-v228-menu{display:grid!important;gap:2px!important;position:absolute!important;right:0!important;top:calc(100% + 7px)!important;box-sizing:border-box!important;width:max(100%,230px)!important;max-width:min(340px,calc(100vw - 24px))!important;max-height:min(65vh,370px)!important;overflow-y:auto!important;z-index:351!important;padding:7px!important;background:#fff!important;border:1px solid #e3e6e9!important;border-radius:14px!important;box-shadow:0 12px 30px rgba(21,28,38,.16)!important}
html body main.jj-ref-home .jj-listing-actions .joy2-sort-v228-menu[hidden]{display:none!important}
html body main.jj-ref-home .jj-listing-actions .joy2-sort-v228-option{display:block!important;box-sizing:border-box!important;width:100%!important;margin:0!important;padding:10px 12px!important;min-height:37px!important;background:#fff!important;border:0!important;border-radius:9px!important;box-shadow:none!important;outline:none!important;color:#161719!important;text-align:left!important;font:600 13px/1.35 Inter,Arial,sans-serif!important;white-space:normal!important;cursor:pointer!important}
html body main.jj-ref-home .jj-listing-actions .joy2-sort-v228-option:hover,
html body main.jj-ref-home .jj-listing-actions .joy2-sort-v228-option:focus-visible{background:#f0f1f3!important;outline:none!important}
html body main.jj-ref-home .jj-listing-actions .joy2-sort-v228-option[aria-selected="true"]:not(:hover):not(:focus-visible){background:#f6f7f8!important}
@media(max-width:700px){html body main.jj-ref-home .jj-listing-actions .joy2-sort-v228{width:min(176px,42vw)!important}html body main.jj-ref-home .jj-listing-actions .joy2-sort-v228-trigger{min-height:36px!important;height:36px!important;padding:6px 10px!important;font-size:12px!important}html body main.jj-ref-home .jj-listing-actions .joy2-sort-v228-menu{width:max(100%,200px)!important}}
/* JOY2_V228_SORT_FILTER_STYLE_END */


/* JOY2_V233_START */
/* Revert V232's forced 1600px hero grid, fixed 390px investment-column position,
   and typography overrides. The original Joy² hero rules now own the card position
   at ALL desktop sizes, including large monitors. */
/* Fit one unmodified 1760px desktop composition on laptop-sized viewports.
   Do not change hero/grid/card placement inside this shell. */
@media screen and (min-width:1000px){
 html body.joy2-v233-fit{
  box-sizing:border-box!important;width:1760px!important;min-width:1760px!important;
  max-width:none!important;zoom:var(--joy2-v233-ratio,1)!important;
 }
 html body.joy2-v233-fit>main.jj-ref-home,
 html body.joy2-v233-fit>header.jj-ref-header{
  box-sizing:border-box!important;width:100%!important;max-width:none!important;
 }
}
/* Keep the last working four-column catalog rule from V232; no card styling changes. */
@media screen and (min-width:1000px){
 html body main.jj-ref-home #catalog-results.jj-listing-section{
  box-sizing:border-box!important;width:calc(100% - 48px)!important;
  max-width:1600px!important;min-width:0!important;margin-inline:auto!important;
 }
 html body main.jj-ref-home #catalog-results .jj-workspace[data-jj-mode="list"] #jj-results.jj-card-grid{
  box-sizing:border-box!important;display:grid!important;
  grid-template-columns:repeat(4,minmax(0,1fr))!important;
  gap:18px!important;max-width:100%!important;min-width:0!important;width:100%!important;
 }
 html body main.jj-ref-home #catalog-results .jj-workspace[data-jj-mode="list"] #jj-results.jj-card-grid>.jj-property-card{
  box-sizing:border-box!important;width:100%!important;max-width:100%!important;min-width:0!important;
 }
}
/* JOY2_V233_END */


/* JOY2_V235_START */
/* Measured 2026-11-22: old V12 rule translated the hero investment stage -160px,
   causing the card to drift on both 1366 and 2560 physical pixel monitors.
   Restore natural alignment inside the existing two-column grid.
   Do NOT change the catalog layout, card widths, or page zoom. */
@media screen and (min-width:1000px){
 html body main.jj-ref-home > .jj-ref-hero .jj-hero-right-v2.jj-hero-stage-v6{
  transform:none!important;
  translate:none!important;
  min-height:520px!important;
 }
 html body main.jj-ref-home > .jj-ref-hero .jj-hero-right-v2.jj-hero-stage-v6 > .jj-hero-rotator-v6{
  min-height:520px!important;
 }
}
/* JOY2_V235_END */
