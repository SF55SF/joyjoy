}
@media(max-width:700px){
 html body main.jj-ref-home #catalog #jj-filters>.jj-rf-top{grid-template-columns:repeat(2,minmax(0,1fr))!important;}
}
@media(max-width:420px){
 html body main.jj-ref-home #catalog #jj-filters>.jj-rf-top{grid-template-columns:1fr!important;}
}
/* JOY2_FILTER_STATUS_V83_END */

/* JOY2_FILTER_STATUS_MATCH_V84_START */
/* Keep original select for search but replace its presentation with the EXACT
   same .jj-rf-wrap/.jj-rf-trigger/.jj-rf-menu used by Type, Price and Area. */
html body main.jj-ref-home #catalog .joy2-v83-status.joy2-v84-native-status-hidden{
 display:none!important;
}
html body main.jj-ref-home #catalog .joy2-v84-status-wrap{
 min-width:0!important;width:100%!important;
}
html body main.jj-ref-home #catalog .joy2-v84-status-wrap>.jj-rf-trigger{
 width:100%!important;
}
/* JOY2_FILTER_STATUS_MATCH_V84_END */

/* JOY2_FILTER_DROPDOWN_ALIGN_V85_START */
/* Use one consistent alignment for Type, Price, Area and Construction status. */
html body main.jj-ref-home #catalog .jj-rf-top > .jj-rf-wrap{min-width:0!important;}
html body main.jj-ref-home #catalog .jj-rf-top > .jj-rf-wrap > .jj-rf-trigger{
  display:flex!important;align-items:center!important;justify-content:space-between!important;
  gap:10px!important;text-align:left!important;
}
html body main.jj-ref-home #catalog .jj-rf-top > .jj-rf-wrap > .jj-rf-trigger > .jj-rf-caption{
  flex:1 1 auto!important;min-width:0!important;white-space:nowrap!important;
  overflow:hidden!important;text-overflow:ellipsis!important;text-align:left!important;
}
html body main.jj-ref-home #catalog .jj-rf-top > .jj-rf-wrap > .jj-rf-trigger > svg{
  width:18px!important;height:18px!important;flex:0 0 18px!important;margin-left:auto!important;
}
html body main.jj-ref-home #catalog .jj-rf-top .jj-rf-menu{
  box-sizing:border-box!important;width:max(100%,300px)!important;
  max-width:min(360px,calc(100vw - 36px))!important;
  padding:10px!important;display:grid!important;grid-template-columns:minmax(0,1fr)!important;
  gap:3px!important;text-align:left!important;overflow-x:hidden!important;
}
html body main.jj-ref-home #catalog .jj-rf-top .jj-rf-menu[hidden]{display:none!important;}
html body main.jj-ref-home #catalog .jj-rf-top .jj-rf-menu > .jj-rf-option{
  display:flex!important;align-items:center!important;justify-content:flex-start!important;
  box-sizing:border-box!important;width:100%!important;min-height:37px!important;
  margin:0!important;padding:9px 12px!important;text-align:left!important;
  font-size:14px!important;line-height:19px!important;border-radius:9px!important;
}
html body main.jj-ref-home #catalog .jj-rf-top .jj-rf-menu > .joy2-v82-range{
  display:block!important;box-sizing:border-box!important;width:100%!important;
  min-width:0!important;margin:8px 0 0!important;padding:11px 0 0!important;
  border:0!important;border-top:1px solid #e7e9ee!important;
}
html body main.jj-ref-home #catalog .jj-rf-top .jj-rf-menu > .joy2-v82-range legend{
  width:100%!important;display:block!important;padding:0 0 8px!important;
  margin:0!important;font-size:12px!important;line-height:18px!important;text-align:left!important;
}
html body main.jj-ref-home #catalog .jj-rf-top .jj-rf-menu > .joy2-v82-range > div{
  display:grid!important;grid-template-columns:repeat(2,minmax(0,1fr))!important;
  align-items:stretch!important;gap:10px!important;min-width:0!important;
}
html body main.jj-ref-home #catalog .jj-rf-top .jj-rf-menu > .joy2-v82-range label{
  box-sizing:border-box!important;min-width:0!important;width:100%!important;min-height:65px!important;
  display:flex!important;flex-direction:column!important;align-items:stretch!important;
  justify-content:center!important;gap:4px!important;margin:0!important;
  padding:8px 10px!important;text-align:left!important;border-radius:10px!important;
}
html body main.jj-ref-home #catalog .jj-rf-top .jj-rf-menu > .joy2-v82-range label > span{
  display:block!important;font-size:12px!important;line-height:16px!important;text-align:left!important;
  padding:0!important;margin:0!important;
}
html body main.jj-ref-home #catalog .jj-rf-top .jj-rf-menu > .joy2-v82-range input{
  display:block!important;box-sizing:border-box!important;width:100%!important;
  max-width:100%!important;min-width:0!important;margin:0!important;padding:0!important;
  line-height:22px!important;font-size:15px!important;text-align:left!important;
}
@media(min-width:900px){
  html body main.jj-ref-home #catalog .jj-rf-top > .jj-rf-wrap:nth-last-child(-n+2) > .jj-rf-menu{
    left:auto!important;right:0!important;
  }
}
/* JOY2_FILTER_DROPDOWN_ALIGN_V85_END */

/* JOY2_READY_EQUAL_FIVE_FILTERS_V86_CORRECTED_START */
/* Five equal controls with equal gaps on large screens. */
html body main.jj-ref-home #catalog #jj-filters>.jj-rf-top{
 display:grid!important;grid-template-columns:repeat(5,minmax(0,1fr))!important;
 gap:12px!important;align-items:stretch!important;
}
html body main.jj-ref-home #catalog #jj-filters>.jj-rf-top>*{
 box-sizing:border-box!important;min-width:0!important;width:100%!important;margin:0!important;
}
html body main.jj-ref-home #catalog #jj-filters>.jj-rf-top>.jj-rf-wrap>.jj-rf-trigger{
 box-sizing:border-box!important;width:100%!important;min-width:0!important;
 min-height:50px!important;height:50px!important;
}
html body main.jj-ref-home #catalog #jj-filters>.jj-rf-top>.jj-rf-invest{
 box-sizing:border-box!important;width:100%!important;min-height:50px!important;
 padding:0 8px!important;justify-content:center!important;gap:9px!important;
 font-size:14px!important;line-height:18px!important;white-space:normal!important;
}
/* No duplicate lower area/price form, but keep its real inputs for marketplace logic. */
html body main.jj-ref-home #catalog #jj-filters .jj-rf-menu :is(.joy2-v81-range,.joy2-v82-range,fieldset.jj-range),
html body main.jj-ref-home #catalog #jj-filters #jj-advanced-filters{
 display:none!important;
}
html body main.jj-ref-home #catalog #jj-filters .jj-rf-menu{
 padding:7px!important;gap:2px!important;
}
html body main.jj-ref-home #catalog #jj-filters .jj-rf-menu>.jj-rf-option{
 box-sizing:border-box!important;width:100%!important;min-height:39px!important;
 padding:9px 12px!important;
}
@media(max-width:1100px){
 html body main.jj-ref-home #catalog #jj-filters>.jj-rf-top{
  grid-template-columns:repeat(3,minmax(0,1fr))!important;
 }
}
@media(max-width:680px){
 html body main.jj-ref-home #catalog #jj-filters>.jj-rf-top{
  grid-template-columns:repeat(2,minmax(0,1fr))!important;gap:9px!important;
 }
}
@media(max-width:410px){
 html body main.jj-ref-home #catalog #jj-filters>.jj-rf-top{
  grid-template-columns:minmax(0,1fr)!important;
 }
}
/* JOY2_READY_EQUAL_FIVE_FILTERS_V86_CORRECTED_END */

/* JOY2_FAST_HERO_SEPARATED_FILTERS_V87_START */
/* Give the five controls breathing space, without affecting their individual widths. */
html body main.jj-ref-home #catalog #jj-filters > .jj-rf-top{
 display:grid!important;
 grid-template-columns:repeat(5,minmax(0,1fr))!important;
 column-gap:20px!important;
 row-gap:14px!important;
 align-items:center!important;
 padding:0 5px!important;
 box-sizing:border-box!important;
}
html body main.jj-ref-home #catalog #jj-filters > .jj-rf-top > *{
 min-width:0!important;max-width:100%!important;
 box-sizing:border-box!important;
}
html body main.jj-ref-home #catalog #jj-filters > .jj-rf-top > .jj-rf-wrap{
 margin:0!important;
}
html body main.jj-ref-home #catalog #jj-filters > .jj-rf-top > .jj-rf-invest{
 margin:0!important;
 padding-inline:9px!important;
}
/* Preserve usable widths on tablets and phones. */
@media(max-width:1150px){
 html body main.jj-ref-home #catalog #jj-filters > .jj-rf-top{
  grid-template-columns:repeat(3,minmax(0,1fr))!important;
  column-gap:16px!important;row-gap:12px!important;
 }
}
@media(max-width:700px){
 html body main.jj-ref-home #catalog #jj-filters > .jj-rf-top{
  grid-template-columns:repeat(2,minmax(0,1fr))!important;
  column-gap:12px!important;row-gap:10px!important;
  padding:0!important;
 }
}
@media(max-width:430px){
 html body main.jj-ref-home #catalog #jj-filters > .jj-rf-top{
  grid-template-columns:minmax(0,1fr)!important;
 }
}
/* JOY2_FAST_HERO_SEPARATED_FILTERS_V87_END */

/* JOY2_HERO_BUTTONS_INTER_BOLD_V89_START */
/* Text in the two HOMEPAGE hero buttons only. Preserve dimensions, arrows and backgrounds. */
html body main.jj-ref-home section.jj-ref-hero .jj-ref-actions > a.jj-ref-cta,
html body main.jj-ref-home section.jj-ref-hero .jj-ref-actions > a.jj-ref-cta > span.joy2-hero-cta-label {
  font-family: 'Inter', Arial, Helvetica, sans-serif !important;
  font-weight: 700 !important;
  font-size: 21px !important;
  letter-spacing: -0.01em !important;
  line-height: 1.2 !important;
}
@media (max-width: 700px) {
  html body main.jj-ref-home section.jj-ref-hero .jj-ref-actions > a.jj-ref-cta,
  html body main.jj-ref-home section.jj-ref-hero .jj-ref-actions > a.jj-ref-cta > span.joy2-hero-cta-label {
    font-size: 14px !important;
  }
}
/* JOY2_HERO_BUTTONS_INTER_BOLD_V89_END */

@media print{.jj-detail .joy2-v90-chart{display:none!important;}}

/* JOY2_REFERENCE_PIXEL_LAYOUT_V93_START */
/* Reference: /download.png, same hierarchy and approximate relative dimensions.
   Scoped to the property detail page. No catalog, backend, or print changes. */
@media screen {
.jj-detail .jj-detail-units-wide .jj-units{font-family:inherit!important;}
.jj-detail .jj-unit-details:has(.joy2-v93-drawer){padding:4px!important;margin:5px 0 8px!important;border:1px solid #e5e8ea!important;background:#fff!important;border-radius:15px!important;box-shadow:none!important;}
.jj-detail .jj-unit-details:has(.joy2-v93-drawer)>.jj-unit-summary{display:none!important;}
.jj-detail .jj-unit-finance-drawer.joy2-v93-drawer{
 display:grid!important;grid-template-columns:minmax(0,2.1fr) minmax(285px,1fr)!important;
 grid-template-areas:"main right"!important;column-gap:30px!important;
 grid-template-rows:auto!important;align-items:start!important;
 padding:22px 24px 18px!important;margin:0!important;
 min-height:0!important;height:auto!important;border:0!important;
 background:#fff!important;box-shadow:none!important;border-radius:14px!important;
 font-family:inherit!important;color:#111318!important;
}
.jj-detail .joy2-v93-drawer>.jj-rinv-header{
 position:absolute!important;top:12px!important;right:12px!important;z-index:3!important;
 display:block!important;width:32px!important;min-height:0!important;
 padding:0!important;margin:0!important;border:0!important;
}
.jj-detail .joy2-v93-drawer>.jj-rinv-header>div{display:none!important;}
.jj-detail .joy2-v93-drawer .jj-rinv-close{display:flex!important;align-items:center!important;justify-content:center!important;
 width:30px!important;height:30px!important;min-width:30px!important;background:#f5f6f7!important;
 color:#17191b!important;border:0!important;border-radius:8px!important;position:static!important;}
.jj-detail .joy2-v93-drawer>.joy2-v91-main{grid-area:main!important;grid-column:auto!important;grid-row:auto!important;
 display:flex!important;flex-direction:column!important;align-items:stretch!important;gap:0!important;min-width:0!important;padding:0!important;margin:0!important;}
.jj-detail .joy2-v93-title{font-size:clamp(20px,1.8vw,28px)!important;font-weight:750!important;
 letter-spacing:-.035em!important;line-height:1.2!important;margin:0 0 20px!important;padding:0 0 15px!important;
