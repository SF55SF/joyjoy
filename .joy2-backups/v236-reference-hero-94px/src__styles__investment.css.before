}
html body main.jj-ref-home #catalog #jj-filters .jj-rf-menu .joy2-v81-range label span{font-size:12px!important;font-weight:500!important;color:#68717a!important;}
html body main.jj-ref-home #catalog #jj-filters .jj-rf-menu .joy2-v81-range input{
  display:block!important;width:100%!important;min-width:0!important;box-sizing:border-box!important;
  border:0!important;box-shadow:none!important;outline:none!important;padding:0!important;
  font-size:16px!important;line-height:1.5!important;color:#14171a!important;background:transparent!important;
}
html body main.jj-ref-home #catalog #jj-filters>#jj-advanced-filters:not([hidden]){
  display:grid!important;grid-template-columns:minmax(0,1fr)!important;
  gap:12px!important;padding:16px!important;margin-top:10px!important;
}
html body main.jj-ref-home #catalog #jj-filters>#jj-advanced-filters .jj-filter-options{
  display:grid!important;grid-template-columns:minmax(0,1fr) minmax(0,1fr)!important;
  column-gap:16px!important;align-items:center!important;
}
html body main.jj-ref-home #catalog #jj-filters .jj-price-unknown{
  display:flex!important;align-items:center!important;gap:11px!important;min-height:46px!important;
  font-size:14px!important;color:#202429!important;position:relative!important;cursor:pointer!important;
}
html body main.jj-ref-home #catalog #jj-filters .jj-price-unknown>input[type=checkbox]{
  position:absolute!important;opacity:0!important;width:1px!important;height:1px!important;
}
html body main.jj-ref-home #catalog #jj-filters .joy2-v81-switch-track{
  display:block!important;position:relative!important;flex:0 0 48px!important;
  width:48px!important;height:28px!important;border-radius:30px!important;background:#d9dce1!important;transition:background .18s!important;
}
html body main.jj-ref-home #catalog #jj-filters .joy2-v81-switch-track:after{
  content:'';position:absolute;top:3px;left:3px;width:22px;height:22px;border-radius:50%;
  background:white;box-shadow:0 2px 5px #0002;transition:transform .18s;
}
html body main.jj-ref-home #catalog #jj-filters .jj-price-unknown>input:checked+.joy2-v81-switch-track{background:#b6ff00!important;}
html body main.jj-ref-home #catalog #jj-filters .jj-price-unknown>input:checked+.joy2-v81-switch-track:after{transform:translateX(20px);}
html body main.jj-ref-home #catalog #jj-filters .jj-price-unknown>input:focus-visible+.joy2-v81-switch-track{outline:2px solid #111;outline-offset:3px;}
@media(max-width:1250px){html body main.jj-ref-home #catalog #jj-filters>.jj-rf-top{grid-template-columns:repeat(3,minmax(0,1fr))!important;}}
@media(max-width:740px){html body main.jj-ref-home #catalog #jj-filters>.jj-rf-top{grid-template-columns:repeat(2,minmax(0,1fr))!important;}}
