html body main.jj-ref-home .jj-hero-right-v2.jj-hero-stage-v6 .jj-property-card-main.jj-canonical-main{box-sizing:border-box!important;display:grid!important;grid-template-rows:20px minmax(48px,auto) minmax(65px,auto) minmax(51px,auto) minmax(76px,auto)!important;gap:8px!important;align-content:start!important;align-items:stretch!important;flex:1 1 auto!important;padding:16px 16px 17px!important;font-family:'Inter',Arial,sans-serif!important;}
html body main.jj-ref-home .jj-hero-right-v2.jj-hero-stage-v6 .jj-canonical-main .jj-card-overline{font:500 12px/20px 'Inter',Arial,sans-serif!important;margin:0!important;overflow:hidden;}
html body main.jj-ref-home .jj-hero-right-v2.jj-hero-stage-v6 .jj-canonical-main h3{font-family:'Inter',Arial,sans-serif!important;font-size:17px!important;line-height:24px!important;letter-spacing:-.025em!important;font-weight:700!important;min-height:48px!important;margin:0!important;display:-webkit-box!important;-webkit-box-orient:vertical!important;-webkit-line-clamp:2!important;line-clamp:2!important;overflow:hidden!important;}
html body main.jj-ref-home .jj-hero-right-v2.jj-hero-stage-v6 .jj-property-summary.jj-canonical-price-row{box-sizing:border-box!important;display:grid!important;grid-template-columns:minmax(0,.8fr) minmax(0,1.2fr)!important;gap:8px!important;align-items:start!important;justify-content:stretch!important;min-width:0!important;padding:8px 0 10px!important;margin:0!important;border-top:0!important;border-bottom:1px solid #e6e8eb!important;}
html body main.jj-ref-home .jj-hero-right-v2.jj-hero-stage-v6 .jj-canonical-price-row>span{min-width:0!important;display:flex!important;flex-direction:column!important;gap:5px!important;white-space:normal!important;}
