 html body main.jj-detail .jj-unit-data-row .jj-unit-col-price b{white-space:normal!important;overflow-wrap:anywhere!important;}
 /* Move the actual contact elements one line upward, before the address. */
 html body main.jj-detail .jj-detail-heading{display:flex!important;flex-direction:column!important;align-items:stretch!important;gap:5px!important;}
 html body main.jj-detail .jj-detail-heading>div:first-child{display:contents!important;}
 html body main.jj-detail .jj-detail-heading h1{order:1!important;margin:0!important;}
 html body main.jj-detail .jj-detail-heading .jj-detail-contact-top{order:2!important;display:flex!important;flex-wrap:wrap!important;align-items:center!important;justify-content:flex-start!important;gap:6px 9px!important;max-width:100%!important;margin:1px 0!important;}
