 font-size:13px!important;font-weight:700!important;line-height:1.3!important;white-space:nowrap!important;text-align:right!important;margin:0!important;}
.jj-detail .joy2-v93-tax{display:block!important;min-width:0!important;border:1px solid #dfe4e8!important;
 background:#fff!important;border-radius:15px!important;overflow:hidden!important;}
.jj-detail .joy2-v93-tax summary{list-style:none!important;display:flex!important;justify-content:space-between!important;
 align-items:center!important;gap:12px!important;cursor:pointer!important;padding:15px 18px!important;
 font-family:inherit!important;font-weight:700!important;font-size:17px!important;line-height:1.3!important;}
.jj-detail .joy2-v93-tax summary::-webkit-details-marker{display:none;}
.jj-detail .joy2-v93-tax summary::after{content:'';width:9px;height:9px;flex:0 0 9px;
 border-right:2px solid currentColor;border-bottom:2px solid currentColor;transform:translateY(-2px) rotate(45deg);}
.jj-detail .joy2-v93-tax[open] summary::after{transform:translateY(2px) rotate(225deg);}
.jj-detail .joy2-v93-tax .jj-rinv-footer-notes{padding:0 17px 14px!important;margin:0!important;display:block!important;}
.jj-detail .joy2-v93-tax .jj-rinv-footer-notes p{margin:4px 0!important;color:#707883!important;
 font-family:inherit!important;font-size:11px!important;line-height:1.5!important;}
