---
import {calculateInvestment} from '../../public/js/joyjoy-investment-model.js';
// JOY2_UNIT_FLAG_ROW_DRAWER_V2 JOY2_INLINE_ROW_INVESTMENT_FIXED_TAX_V6 JOY2_TAX_REALISM_CLEAN_UI_V7 - public models are read-only
const {listing,lang='ru'}=Astro.props;
const units=(listing.units||[]).filter(u=>u.published!==false);
const investmentEnabled=listing.insestproject===true;
const L={
 ru:{heading:'Помещения в продаже',block:'Блок',floor:'Этаж',area:'Площадь',rate:'Цена за м²',price:'Стоимость',flag:'Инвестиционный расчёт',select:'Нажмите на помещение, чтобы посмотреть его параметры и расчёт',plan:'Поэтажный план',input:'Исходные параметры',results:'Показатели инвестиционного расчёта',cash:'Денежные потоки по годам',purchase:'Цена покупки',sale:'Цена продажи',returns:'Прогнозируемая прибыль проекта',rent:'Арендная ставка',mezz:'Мезонин',mezzRent:'Ставка мезонина',index:'Индексация',capex:'CAPEX',hold:'Срок владения',occupancy:'Заполняемость',expenses:'Годовые расходы',saleTax:'Налог при продаже',netSale:'После налога',taxUnset:'Налог при продаже: 15% от положительной разницы между ценой продажи и остаточной стоимостью после амортизации за 20 лет. НДС не включён.',year:'Год',exit:'Выход',outflow:'Первоначальные вложения',note:'Чистая прибыль = сумма всех денежных потоков: NOI + продажа − первоначальные вложения − налог и расходы на продажу. Налог при продаже: 15% от положительной разницы между продажной и остаточной стоимостью после 20-летней амортизации. НДС не учитывается.',disclaimer:'Расчёт основан на опубликованных допущениях. Фактическая доходность может отличаться.',noModel:'Для этого помещения инвестиционный расчёт не опубликован.',years:'лет'},
 en:{heading:'Available units',block:'Block',floor:'Floor',area:'Area',rate:'Price per m²',price:'Total price',flag:'Investment analysis',select:'Select a unit to see its details and investment analysis',plan:'Floor plan',input:'Assumptions',results:'Investment metrics',cash:'Annual cash flows',purchase:'Purchase price',sale:'Exit sale price',returns:'Projected project profit',rent:'Monthly rent',mezz:'Mezzanine',mezzRent:'Mezzanine rent',index:'Annual rent growth',capex:'CAPEX',hold:'Holding period',occupancy:'Occupancy',expenses:'Annual expenses',saleTax:'Tax on disposal',netSale:'Net sale proceeds',taxUnset:'Exit tax assumption: 15% on positive gain after 20-year straight-line depreciation of purchase price. VAT excluded.',year:'Year',exit:'Exit',outflow:'Initial investment',note:'Net profit = sum of annual cash flows, including rent, net exit proceeds and initial investment.',disclaimer:'Indicative assumptions; actual returns may differ.',noModel:'No published investment analysis for this unit.',years:'years'},
 uz:{heading:'Sotuvdagi xonalar',block:'Blok',floor:'Qavat',area:'Maydon',rate:'m² narxi',price:'Umumiy narx',flag:'Investitsiya hisobi',select:'Xona tafsilotlari va hisobini ko‘rish uchun qatorni tanlang',plan:'Qavat rejasi',input:'Boshlang‘ich parametrlar',results:'Investitsiya ko‘rsatkichlari',cash:'Yillar bo‘yicha pul oqimi',purchase:'Xarid narxi',sale:'Sotish narxi',returns:'Loyihaning prognoz foydasi',rent:'Oylik ijara',mezz:'Mezonin',mezzRent:'Mezonin ijarasi',index:'Ijara indeksatsiyasi',capex:'CAPEX',hold:'Egalik davri',occupancy:'Bandlik',expenses:'Yillik xarajatlar',saleTax:'Sotish solig‘i',netSale:'Soliqdan keyin',taxUnset:'Sotish solig‘i: sotuv narxi va 20 yillik amortizatsiyadan keyingi qoldiq qiymat orasidagi ijobiy farqning 15%. QQS hisoblanmagan.',year:'Yil',exit:'Sotish',outflow:'Boshlang‘ich investitsiya',note:'Sof foyda — ijara NOI va sotishdan tushum minus sarmoya va chiqish soliqlari.',disclaimer:'Taxminiy hisob; haqiqiy natijalar farq qilishi mumkin.',noModel:'Ushbu xona uchun investitsiya hisobi mavjud emas.',years:'yil'}
}[lang]||null;
const c=L||{};
const money=n=>Number.isFinite(Number(n))?'$'+Math.round(Number(n)).toLocaleString('en-US'):'—';
const joy2V93Money=n=>Number.isFinite(Number(n))?'$'+(Number(n)/1000000).toLocaleString(lang==='ru'?'ru-RU':lang==='uz'?'uz-UZ':'en-US',{minimumFractionDigits:2,maximumFractionDigits:2})+' '+(lang==='ru'?'млн':lang==='en'?'m':'mln'):'—';
const signedMoney=n=>Number.isFinite(n)?(n<0?'(':'')+'$'+Math.abs(Math.round(n)).toLocaleString('en-US')+(n<0?')':''):'—';
const num=n=>Number.isFinite(Number(n))?Number(n).toLocaleString('en-US',{maximumFractionDigits:2}):'—';
const pct=n=>Number.isFinite(n)?n.toLocaleString('en-US',{maximumFractionDigits:2})+'%':'—';
const getModel=u=>{ /* JOY2_V28_INVEST_FLAG_GATE */ if(listing.insestproject!==true)return null;const m=u.investment;if(!m||m.published!==true)return null;const r=calculateInvestment({...m,propertyTaxArea:Number(u.area)>0?Number(u.area):m.lettableArea,taxCity:listing.city});if(!r.ok)return null;return {m,r,total:r.netProfit,flow:[{year:0,cashFlow:r.cashFlows[0]},...r.schedule.map(y=>({...y}))]};};
// The model only exposes non-zero optional costs and mezzanine data.
const assumptions=x=>{
 const m=x.m, rows=[];
 const add=(label,value,formatted)=>{if(Number.isFinite(Number(value))&&Number(value)>0)rows.push([label,formatted]);};
 add(c.area,m.lettableArea,num(m.lettableArea)+' м²');
 add(c.mezz,m.mezzanineArea,num(m.mezzanineArea)+' м²');
 add(c.rent,m.monthlyRent,Math.round(Number(m.monthlyRent)).toLocaleString('ru-RU')+' '+(m.rentCurrency||'USD')+'/м²/мес.');
 add(c.mezzRent,m.mezzanineRent,Math.round(Number(m.mezzanineRent)).toLocaleString('ru-RU')+' USD/м²/мес.');
 add(c.index,m.annualRentGrowth,pct(m.annualRentGrowth));
 add(c.capex,m.capex,money(m.capex));
 add(c.occupancy,m.occupancy,pct(m.occupancy));
 add(c.expenses,m.annualExpenses,money(m.annualExpenses));
 add(c.hold,m.holdYears,num(m.holdYears)+' '+c.years);
 return rows;
};
// JOY2_CASHFLOWS_FILTERS_V8: whole thousands of dollars, negatives in parentheses.
const compact=value=>{
 if(!Number.isFinite(value))return '—';
 const amount=Math.round(Math.abs(value)/1000).toLocaleString(lang==='ru'?'ru-RU':lang==='uz'?'uz-UZ':'en-US',{maximumFractionDigits:2});
 return value<0?'('+amount+')':amount;
};
---
<section class="jj-units" data-jj-units data-jj-invest-project={listing.insestproject===true?"yes":"no"} aria-label={c.heading}>
 <header class="jj-units-heading"><h2>{c.heading}</h2><span>{units.length}</span></header>
 <p class="jj-units-intro">{c.select}</p>
 <div class="jj-unit-table-wrap">
  <div class="jj-unit-table-heading" aria-hidden="true"><span>{c.floor}</span><span>{c.area}</span><span>{c.rate}</span><span>{c.price}</span><span>{c.flag}</span></div>
  <div class="jj-units-list" role="group" aria-label={c.heading}>
   {units.map((u,i)=>{const x=investmentEnabled?getModel(u):null;return <><button type="button" class:list={['jj-unit-option','jj-unit-data-row',{'is-active':false}]} data-jj-unit-select={investmentEnabled?u.id:undefined} disabled={!investmentEnabled} aria-pressed="false" aria-controls={investmentEnabled?'jj-unit-detail-'+i:undefined}>
     <span class="jj-unit-row-title"><b>{c.floor} {u.floor}</b></span>
     <span class="jj-unit-col-area"><b>{num(u.area)}</b></span>
     <span class="jj-unit-col-rate"><b>{money(u.pricePerSqm)}</b></span>
     <span class="jj-unit-col-price"><b>{money(u.area*u.pricePerSqm)}</b></span>
     <span class="jj-unit-col-flag">{x&&<span class="jj-unit-finance-flag">{c.flag}</span>}{x&&u.tenancyStatus==='leased'&&<span class="jj-unit-tenancy-tag">{lang==='ru'?'С арендаторами':lang==='en'?'Tenanted':'Ijarachilar bilan'}</span>}{x&&u.tenancyStatus==='preliminary'&&<span class="jj-unit-tenancy-tag">{lang==='ru'?'Предварительные условия':lang==='en'?'Preliminary terms':'Dastlabki shartlar'}</span>}</span>{/* JOY2_UNIT_TENANCY_V13 */}
   </button>
  {investmentEnabled&&<article id={'jj-unit-detail-'+i} data-jj-unit-panel={u.id} hidden class="jj-unit-details">
   <div class="jj-unit-summary"><strong>{c.block} {u.block} · {u.number}</strong><span>{num(u.area)} м²</span></div>
   {x&&<div class="jj-unit-finance-drawer joy2-v91-drawer joy2-v93-drawer" data-jj-finance-drawer>
     <header class="jj-rinv-header"><div><span class="jj-unit-finance-flag">{c.flag}</span><h3>{c.results} · {u.block} {u.number}</h3></div><button type="button" class="jj-rinv-close" data-jj-finance-close aria-label="Close" title="Close">×</button></header>
     
<div class="joy2-v91-main"><h3 class="joy2-v93-title">{c.flag}</h3>
<div class="jj-rinv-kpis">
       <div><small>IRR</small><strong>{Number.isFinite(x.r.irrPercent)?x.r.irrPercent.toLocaleString(lang==='ru'?'ru-RU':'en-US',{minimumFractionDigits:2,maximumFractionDigits:2})+'%':'—'}</strong></div>
       <div><small>{c.purchase}</small><strong data-jj-v100-value={x.m.purchasePrice}>{joy2V93Money(x.m.purchasePrice)}</strong></div>
       <div><small>{c.sale}</small><strong data-jj-v100-value={x.r.salePrice}>{joy2V93Money(x.r.salePrice)}</strong></div>
       <div><small>{c.returns}</small><strong class:list={{'jj-negative':x.total<0,'jj-positive':x.total>=0}} data-jj-v100-value={x.total}>{joy2V93Money(x.total)}</strong></div>
     </div>
     <h4 class="joy2-v93-chart-head"><span>{c.cash}</span><span class="joy2-v93-chart-unit">{lang==='ru'?'тыс. $':lang==='uz'?'ming $':'k $'}</span></h4>
     <div class="jj-rinv-flow-strip" aria-label={c.cash}>
       {x.flow.map((y,idx)=><div class:list={['jj-rinv-year',{'is-negative':y.cashFlow<0,'is-positive':y.cashFlow>=0}]}>
         <span class="jj-rinv-year-label">{c.year} {y.year}{idx===x.flow.length-1?' · '+c.exit:''}</span>
         
         <strong>{compact(y.cashFlow)}</strong>
         <span class="jj-rinv-thousands">{lang==='ru'?'тыс. $':lang==='uz'?'ming $':'k $'}</span>
         <small>{y.year===0?c.outflow:idx===x.flow.length-1?'Cash Flow + '+c.sale:'Cash Flow'}</small>
       </div>)}
     </div>
     
</div>
<div class="joy2-v93-right"><aside class="joy2-v91-side">
<h4>{c.input}</h4>
     <dl class="jj-rinv-inputs">
       {assumptions(x).map(([name,value])=><div><dt>{name}</dt><dd>{value}</dd></div>)}
     </dl>
     
     
     
</aside>
      {u.rentalStatusText?.trim()&&<section class="jj-rental-status-card" data-jj-rental-status><h3>{lang==='ru'?'Арендный статус':lang==='uz'?'Ijara holati':'Tenancy status'}</h3><p>{u.rentalStatusText}</p></section>} {/* JOY2_UNIT_RENTAL_TEXT_V102_FIXED */}
<div class="jj-rinv-footer"><details class="joy2-v93-tax"><summary>{lang==='ru'?'Допущения и налоги':lang==='en'?'Assumptions and taxes':'Farazlar va soliqlar'}</summary><div class="jj-rinv-footer-notes"><p class="jj-rinv-tax-assumptions">{lang==='ru'?'В расчёте использованы налоговые допущения: налог на прибыль — 15%, налог на имущество — 1,5%.':lang==='uz'?'Hisobda quyidagi soliq taxminlari qo‘llangan: foyda solig‘i — 15%, mulk solig‘i — 1,5%.':'Tax assumptions used: 15% corporate profit tax and 1.5% property tax.'}</p>
     <p class="jj-rinv-disclaimer">{lang==='ru'?'Расчёт основан на допущениях. Фактические результаты могут отличаться. Не является финансовой или инвестиционной рекомендацией.':lang==='uz'?'Hisob taxminlarga asoslangan. Amaldagi natijalar farq qilishi mumkin. Moliyaviy yoki investitsiyaviy tavsiya emas.':'Calculations are based on assumptions. Actual results may differ. This is not financial or investment advice.'}</p></div></details><button type="button" class="jj-rinv-pdf" data-jj-investment-print aria-label={lang==='ru'?'Сохранить расчёт как PDF':lang==='en'?'Save as PDF':'PDF sifatida saqlash'}><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v12m0 0 4-4m-4 4-4-4M4 16v4h16v-4"/></svg><span>{lang==='ru'?'Скачать PDF':lang==='en'?'Save as PDF':'PDF yuklash'}</span></button></div><!-- JOY2_FINANCE_REFERENCE_20261119 --></div>
   </div>}
   {!x&&u.note&&<p class="jj-unit-note">{u.note}</p>}
   
  </article>}</>})}
  </div>
 </div>
</section>
<script src="/js/joyjoy-units.js" defer></script>
<script src="/js/joy2-investment-print.js" defer></script>

<script src="/js/joy2-detail-finance-minimal-v90.js" defer></script>
<script src="/js/joy2-detail-reference-v93.js" defer></script>
<script src="/js/joy2-detail-balance-v97.js" defer></script>
<script src="/js/joy2-detail-balance-v98.js" defer></script>
<script src="/js/joy2-detail-reference-v99.js" defer></script>
<script src="/js/joy2-detail-precision-v100.js" defer></script>
<script src="/js/joy2-ui-tidy-v101-fixed.js" defer></script>
<script src="/js/joy2-rental-format-v102-fixed.js" defer></script>
<script src="/js/joy2-unified-finance-v103.js" defer></script>
<script src="/js/joy2-finance-balance-v105.js" defer></script>
<script src="/js/joy2-reference-restore-v106.js" defer></script>
<script src="/js/joy2-exact-layout-v107.js" defer></script>
<script src="/js/joy2-grid-footer-v108.js" defer></script>
