<script is:inline>
(()=>{
  document.addEventListener('click',function(event){
    const link=event.target.closest?.('.jj-ref-actions .jj-ref-cta-secondary[href="#catalog"]');
    if(!link||event.defaultPrevented||event.button!==0||event.metaKey||event.ctrlKey||event.shiftKey||event.altKey)return;
    const catalog=document.getElementById('catalog');if(!catalog)return;
    event.preventDefault();
    if(location.hash!=='#catalog')history.pushState(null,'','#catalog');
    const top=Math.max(0,catalog.getBoundingClientRect().top+window.scrollY);
    window.scrollTo({top,behavior:matchMedia('(prefers-reduced-motion: reduce)').matches?'instant':'smooth'});
  });
})();
</script>
