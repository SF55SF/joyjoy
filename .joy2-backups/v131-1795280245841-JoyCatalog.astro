// JOYJOY_LOOPNET_CATALOG_V5
import { listings as availableListings } from '../data/listings';
import {isPublishedProject,calculateInvestment,hasPublishedInvestment,hasPublishedUnitInvestment} from '../../public/js/joyjoy-investment-model.js';
import {investmentCopy} from '../../public/js/joyjoy-investment-copy.js';
import { localizeListing } from '../data/listing-translations';
import JoyIcon from './JoyIcon.astro';
import JoyInvestmentRows from './JoyInvestmentRows.astro';
import { buildJoyCardMeta } from '../lib/joy-card-meta.js';
// JOY2_INVESTMENT_DIRECTORY_V19
import type { Lang } from '../lib/i18n';
const lang = (Astro.props.lang ?? 'ru') as Lang;
const projects = Astro.props.projects === true;
const investmentText = investmentCopy[lang];
const sourceListings = availableListings.filter(item=>projects?isPublishedProject(item):true);
const joyCardMatchData = sourceListings.map(buildJoyCardMeta);
const unitMinPrice=(p)=>p.units?.length?Math.min(...p.units.filter(u=>u.published!==false).map(u=>u.area*u.pricePerSqm)):p.priceUsd;
const unitAreaRange=(p)=>p.units?.length?(()=>{const a=p.units.filter(u=>u.published!==false).map(u=>u.area);return Math.min(...a).toLocaleString('ru-RU')+' – '+Math.max(...a).toLocaleString('ru-RU')})():null;
const projectIrr=(p)=>{const m=(p.units||[]).filter(u=>u.investment?.published).map(u=>calculateInvestment(u.investment)).filter(r=>r.ok&&r.irrPercent!==null).map(r=>r.irrPercent);if(!m.length&&p.investment){const r=calculateInvestment(p.investment);if(r.ok&&r.irrPercent!==null)m.push(r.irrPercent);}return m.length?Math.min(...m).toFixed(1)+(m.length>1?'–'+Math.max(...m).toFixed(1):'')+'%':'—';};

/* JOY2_SINGLE_CATALOG_INVEST_V1 */
const joy2BestInvestment = (p) => {
 if(!isPublishedProject(p))return null;
 const models=[];
 for(const u of p.units||[]){if(!hasPublishedUnitInvestment(u))continue;const r=calculateInvestment({...u.investment,propertyTaxArea:Number(u.area)>0?Number(u.area):u.investment.lettableArea,taxCity:p.city});if(r.ok&&Number.isFinite(r.irrPercent))models.push(r);}
 if(hasPublishedInvestment(p)){const r=calculateInvestment(p.investment);if(r.ok&&Number.isFinite(r.irrPercent))models.push(r);}
 models.sort((a,b)=>b.irrPercent-a.irrPercent||b.netProfit-a.netProfit);
 return models[0]||null;
};

const investmentRanking=(p)=>{
 if(!isPublishedProject(p))return {irr:'',profit:''};
 const results=[];
 for(const u of (p.units||[])){if(u.published===false||u.investment?.published!==true)continue;const r=calculateInvestment(u.investment);if(r.ok&&Number.isFinite(r.irrPercent))results.push(r);}
 if(p.investment?.published===true){const r=calculateInvestment(p.investment);if(r.ok&&Number.isFinite(r.irrPercent))results.push(r);}
 results.sort((a,b)=>b.irrPercent-a.irrPercent||(b.netProfit||0)-(a.netProfit||0));
 return results.length?{irr:String(results[0].irrPercent),profit:String(results[0].netProfit||0)}:{irr:'',profit:''};
};
// JOY2_CONTACTS_TELEGRAM_V2: URLs read only from property contact fields.
const joy2TgHref=(property:any):string=>{
 const raw=String(property?.contacts?.telegram||property?.telegramUrl||property?.telegram||'').trim();
 if(!raw)return '';
 let name=raw.replace(/^@/,'');
 if(/^https?:\/\//i.test(raw)){try{const u=new URL(raw);if(!['t.me','telegram.me','www.t.me','www.telegram.me'].includes(u.hostname.toLowerCase())||u.protocol!=='https:'||u.username||u.password)return '';return u.href;}catch{return ''}}
 else name=name.replace(/^(?:t\.me|telegram\.me)\//i,'');
 return /^[A-Za-z0-9_]{5,32}$/.test(name)?'https://t.me/'+name:'';
};
const listings = sourceListings.map(item => localizeListing(item, lang));
const base = lang === 'ru' ? '/' : `/${lang}/`;
const copy = {
  ru: {market:'Коммерческая недвижимость',sale:'Продажа',title:'Коммерческая недвижимость на продажу',intro:'Подберите помещение для бизнеса или инвестиций в Узбекистане',q:'Город, район, адрес или название',category:'Тип недвижимости',all:'Все типы',office:'Офисы',retail:'Ритейл',warehouse:'Склады',industrial:'Производство',building:'Здание',land:'Земля',other:'Другое',min:'Площадь от, м²',max:'Площадь до, м²',minPrice:'Цена от, $',maxPrice:'Цена до, $',unknown:'Включая цены по запросу',status:'Стадия строительства',existing:'Существующий',under_construction:'Строящийся',search:'Найти',reset:'Сбросить',found:'Найдено объектов',results:'Объекты',sort:'Сортировка',default:'По умолчанию',priceAsc:'Сначала дешевле',priceDesc:'Сначала дороже',areaDesc:'Площадь: по убыванию',areaAsc:'Площадь: по возрастанию',list:'Список',split:'Список + карта',map:'Карта',mapTitle:'Расположение объектов',searchArea:'Искать в этой области',resetArea:'Сбросить область',mapNote:'Расположение по данным объявлений',noCoords:'Пока нет объектов с подтверждёнными координатами',detail:'Смотреть объект',price:'Цена по запросу',clear:'Очистить фильтры',nothing:'По выбранным параметрам ничего не найдено',favorites:'Избранное',favorite:'В избранное',source:'Источник',mapMissing:'Карта временно недоступна',mapFailed:'Не удалось загрузить карту',notMapped:'Без координат',photos:'Фотографии объектов',disclaimer:'Предложения и параметры уточняйте у продавца. Информация об объектах носит справочный характер.'},
  uz: {market:'Tijorat ko‘chmas mulki',sale:'Sotuv',title:'Sotuvdagi tijorat ko‘chmas mulki',intro:'O‘zbekistonda biznes yoki investitsiya uchun obyekt toping',q:'Shahar, tuman, manzil yoki nom',category:'Mulk turi',all:'Barcha turlar',office:'Ofislar',retail:'Riteyl',warehouse:'Omborlar',industrial:'Ishlab chiqarish',building:'Bino',land:'Yer',other:'Boshqa',min:'Maydon, m² dan',max:'Maydon, m² gacha',minPrice:'Narx, $ dan',maxPrice:'Narx, $ gacha',unknown:'So‘rov asosidagi narxlarni kiritish',status:'Qurilish holati',existing:'Mavjud',under_construction:'Qurilmoqda',search:'Qidirish',reset:'Tozalash',found:'Obyektlar soni',results:'Obyektlar',sort:'Saralash',default:'Standart',priceAsc:'Arzonidan',priceDesc:'Qimmatidan',areaDesc:'Maydon: kattasidan',areaAsc:'Maydon: kichigidan',list:'Ro‘yxat',split:'Ro‘yxat + xarita',map:'Xarita',mapTitle:'Obyektlar xaritada',searchArea:'Shu hududda qidirish',resetArea:'Hududni tozalash',mapNote:'Joylashuv e’lonlar asosida ko‘rsatilgan',noCoords:'Tasdiqlangan koordinatali obyektlar hozircha yo‘q',detail:'Obyektni ko‘rish',price:'Narx so‘rov asosida',clear:'Filtrlarni tozalash',nothing:'Mos obyektlar topilmadi',favorites:'Saqlanganlar',favorite:'Saqlash',source:'Источник',mapMissing:'Xarita vaqtincha ishlamayapti',mapFailed:'Xaritani yuklab bo‘lmadi',notMapped:'Koordinatasiz',photos:'Obyekt suratlari',disclaimer:'Taklif va parametrlarni sotuvchi bilan aniqlang. Ma’lumotlar ma’lumot uchun berilgan.'},
  en: {market:'Commercial real estate',sale:'For sale',title:'Commercial properties for sale',intro:'Explore spaces for business and investment in Uzbekistan',q:'City, district, address or property',category:'Property type',all:'All types',office:'Offices',retail:'Retail',warehouse:'Warehouses',industrial:'Industrial',building:'Building',land:'Land',other:'Other',min:'Min area, m²',max:'Max area, m²',minPrice:'Min price, $',maxPrice:'Max price, $',unknown:'Include price on request',status:'Construction status',existing:'Existing',under_construction:'Under construction',search:'Search',reset:'Reset',found:'Properties found',results:'Listings',sort:'Sort by',default:'Default',priceAsc:'Price: low to high',priceDesc:'Price: high to low',areaDesc:'Area: largest first',areaAsc:'Area: smallest first',list:'List',split:'List + map',map:'Map',mapTitle:'Property locations',searchArea:'Search this area',resetArea:'Clear map area',mapNote:'Locations from the property listings',noCoords:'No listings with verified coordinates yet',detail:'View property',price:'Price on request',clear:'Clear filters',nothing:'No listings match your search',favorites:'Saved',favorite:'Save property',source:'Источник',mapMissing:'Map temporarily unavailable',mapFailed:'Unable to load the map',notMapped:'No coordinates',photos:'Property photos',disclaimer:'Confirm pricing and availability with seller. Property details are for information only.'}
}[lang];
const types = ['retail','office','warehouse','land'] as const;
const names = Object.fromEntries(types.map(k=>[k,copy[k]]));
const mapData = listings.filter(x => Number.isFinite(x.lat) && Number.isFinite(x.lng) && Math.abs(x.lat!)<=90 && Math.abs(x.lng!)<=180).map(x=>({slug:x.slug,title:x.title,address:x.address,lat:x.lat,lng:x.lng,price:x.priceUsd,area:x.area,image:x.images?.[0]||'',url:base+'listing/'+encodeURIComponent(x.slug)+'/'}));
const labels = {
 ru:{title:'Коммерческая недвижимость',intro:'Офисы, торговые помещения и здания на продажу',catalog:'Каталог',location:'Город, адрес или объект',filters:'Фильтры',range:'Площадь и цена',allFilters:'Все фильтры',featured:'В каталоге',area:'Площадь, м²',budget:'Бюджет, $',from:'От',to:'До',mapHelp:'У объявлений пока нет подтверждённых координат. Все объекты доступны в каталоге',list:'Каталог',split:'С картой',map:'Карта',anyStatus:'Любой статус',areaVerify:'Площадь требует уточнения'},
 uz:{title:'Tijorat ko‘chmas mulki',intro:'Sotuvdagi ofislar, savdo maydonlari va binolar',catalog:'Katalog',location:'Shahar, manzil yoki obyekt',filters:'Filtrlar',range:'Maydon va narx',allFilters:'Barcha filtrlar',featured:'Katalogda',area:'Maydon, m²',budget:'Byudjet, $',from:'Dan',to:'Gacha',mapHelp:'E’lonlarning koordinatalari hali tasdiqlanmagan. Barcha obyektlar katalogda mavjud',list:'Katalog',split:'Xarita bilan',map:'Xarita',anyStatus:'Istalgan holat',areaVerify:'Maydonni aniqlashtirish kerak'},
 en:{title:'Commercial real estate',intro:'Offices, retail spaces and buildings for sale',catalog:'Catalog',location:'City, address or property',filters:'Filters',range:'Area and price',allFilters:'All filters',featured:'In the catalog',area:'Area, m²',budget:'Budget, $',from:'From',to:'To',mapHelp:'Listing coordinates have not been verified yet. All properties remain available in the catalog',list:'Catalog',split:'With map',map:'Map',anyStatus:'Any status',areaVerify:'Area requires confirmation'}
}[lang];
const cardFeature = (features: string[]) => features.find(feature => !/^(?:19|20)\d{2}/.test(feature)) || features[0];
const areaNeedsCheck = (index: number) => sourceListings[index].features.some(feature => /площад.*(уточн|провер)/i.test(feature));
const numberLocale = lang === 'ru' ? 'ru-RU' : lang === 'uz' ? 'uz-UZ' : 'en-US';
const categoryCount=(type:string)=>sourceListings.filter(item=>item.type===type).length;
// JOY2_ARCA_INVEST_V3
const joyCardInvestment=(listing)=>{
 const valid=(m)=>{if(!m||m.published!==true)return null;try{const r=calculateInvestment(m);return r&&r.ok?r:null;}catch{return null;}};
 const units=(listing.units||[]).filter(u=>u.published!==false).map(u=>valid(u.investment)).filter(Boolean);
 const results=units.length?units:[valid(listing.investment)].filter(Boolean);
 return {count:results.length,model:results.length===1?results[0]:null};
};
const joyCardInvestments=sourceListings.map(joyCardInvestment);
const joyCardProfit=(n)=>{if(!Number.isFinite(n))return '—';const magnitude=Math.round(Math.abs(n)).toLocaleString('en-US');return (n<0?'−':'')+'$'+magnitude;};
const joyCardIrr=(n)=>Number.isFinite(n)?n.toLocaleString(numberLocale,{minimumFractionDigits:1,maximumFractionDigits:1})+'%':'—';
const noCategoryObjects=lang==='ru'?'Пока нет объектов':lang==='en'?'No properties yet':'Hozircha obyektlar yo‘q';
// JOY2_CARD_CANONICAL_V1: canonical catalog card and published financial metrics.
const cardMoney=(n)=>Number.isFinite(n)?Math.round(n).toLocaleString('en-US')+' $':'—';
const cardIrr=(n)=>Number.isFinite(n)?n.toLocaleString(numberLocale,{minimumFractionDigits:1,maximumFractionDigits:1})+'%':'—';
const cardArea=(p)=>{const arr=(p.units||[]).filter(u=>u.published!==false&&Number(u.area)>0).map(u=>Number(u.area));if(!arr.length)return Number(p.area).toLocaleString(numberLocale)+' м²';const min=Math.min(...arr),max=Math.max(...arr);return (min===max?min.toLocaleString(numberLocale):min.toLocaleString(numberLocale)+' – '+max.toLocaleString(numberLocale))+' м²';};
/* JOY2_CARD_PRICE_V123 */
const cardPrice=(p)=>{
 const units=Array.isArray(p.units)?p.units.filter(u=>u.published!==false):[];
 const usd=n=>"$"+Math.round(n).toLocaleString("en-US");
 const direct=Number(p.priceUsd);
 const directValid=p.priceUsd!=null&&Number.isFinite(direct)&&direct>0;
 if(units.length===1){
  const u=units[0], calculated=Number(u.area)*Number(u.pricePerSqm);
  const value=directValid?direct:calculated;
  return Number.isFinite(value)&&value>0?usd(value):copy.price;
 }
 if(units.length>1){
  const rates=units.map(u=>Number(u.pricePerSqm)).filter(n=>Number.isFinite(n)&&n>0);
  if(rates.length)return (lang==="ru"?"от ":lang==="uz"?"dan ":"from ")+Math.min(...rates).toLocaleString("en-US",{maximumFractionDigits:0})+" $/м²";
 }
 return directValid?usd(direct):copy.price;
};
// JOY2_V126_SINGLE_PRICE_STABLE_HERO: full asking price for one unit, per-square-metre from price for multiple units.
const joy2V126CardPrice=(p)=>{
 const published=(Array.isArray(p.units)?p.units:[]).filter(u=>u.published!==false);
 const whole=Number(p.priceUsd);
 if(published.length>1){
  const rates=published.map(u=>Number(u.pricePerSqm)).filter(n=>Number.isFinite(n)&&n>0);
  if(rates.length)return (lang==='ru'?'от ':lang==='uz'?'dan ':'from ')+Math.min(...rates).toLocaleString('en-US',{maximumFractionDigits:0})+' $/м²';
 }
 const unit=published.length===1?published[0]:null;
 const computed=unit?Number(unit.area)*Number(unit.pricePerSqm):NaN;
 const total=Number.isFinite(whole)&&whole>0?whole:computed;
 return Number.isFinite(total)&&total>0?'$'+Math.round(total).toLocaleString('en-US'):copy.price;
};
const cardFinance=(p)=>{if(p.insestproject!==true)return null;const candidates=[];for(const u of p.units||[]){if(!hasPublishedUnitInvestment(u))continue;const r=calculateInvestment(u.investment);if(r.ok)candidates.push(r);}if(!candidates.length&&hasPublishedInvestment(p)){const r=calculateInvestment(p.investment);if(r.ok)candidates.push(r);}if(!candidates.length)return null;candidates.sort((a,b)=>(Number.isFinite(b.irrPercent)?b.irrPercent:-Infinity)-(Number.isFinite(a.irrPercent)?a.irrPercent:-Infinity)||(Number(b.netProfit)||0)-(Number(a.netProfit)||0));return candidates[0];};
// OpenFreeMap requires no API key. Unverified coordinates are never invented.

// JOY2_UNIFIED_CARDS_V1: card data follows published model values and admin investment toggle.
const joy2UnifiedCardDataV1 = sourceListings.map(p => {
 const isInvestment = p.insestproject === true;
 const candidates = [];
 if(isInvestment){
   if(Array.isArray(p.units) && p.units.length){
     for(const u of p.units){
       if(u.published===false || u.investment?.published!==true)continue;
       const r=calculateInvestment(u.investment);
       if(r.ok && Number.isFinite(r.irrPercent) && Number.isFinite(r.netProfit))candidates.push(r);
     }
   }else if(p.investment?.published===true){
     const r=calculateInvestment(p.investment);
     if(r.ok && Number.isFinite(r.irrPercent) && Number.isFinite(r.netProfit))candidates.push(r);
   }
 }
 candidates.sort((a,b)=>(b.irrPercent-a.irrPercent)||(b.netProfit-a.netProfit));
 return {slug:p.slug,investment:isInvestment&&candidates.length>0,irr:candidates[0]?.irrPercent??null,profit:candidates[0]?.netProfit??null,status:p.status??null};
});

